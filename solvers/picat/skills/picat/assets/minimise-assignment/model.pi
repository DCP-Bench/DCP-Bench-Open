% Minimise: give each of four jobs a different worker at the lowest total cost.
import cp.

main =>
    Cost = [[9, 2, 7, 8],
            [6, 4, 3, 7],
            [5, 8, 1, 8],
            [7, 6, 9, 4]],
    N = len(Cost),
    Worker = new_list(N),
    Worker :: 1..N,
    all_different(Worker),
    % The cost of job J depends on its worker, a decision variable:
    % matrix_element/4 looks it up, where Cost[J, Worker[J]] would fail.
    Price = new_list(N),
    foreach (J in 1..N)
        matrix_element(Cost, J, Worker[J], Price[J])
    end,
    Total #= sum(Price),
    if solve([$min(Total)], Worker) then
        println("Minimum total cost: " ++ to_string(Total)),
        println("Worker of each job: " ++ to_string(Worker))
    else
        println("No assignment")
    end.
