language ESSENCE' 1.0
$ ACC 1997/98 basketball timetable: a double round robin of the teams over the dates, with the mirroring, pattern, weekend, rival and other constraints of the statement. config gives the opponent of each team on each date (0-based team numbers), where gives 0 home, 1 bye, 2 away.
given n_teams : int(1..)
given n_days : int(1..)

$ team numbers (0-based in the output, 1-based here): Clemson, Duke, Florida State, Georgia Tech, Maryland, North Carolina, NC State, Virginia, Wake Forest
letting CLEM = 1
letting DUKE = 2
letting FSU = 3
letting GT = 4
letting UMD = 5
letting UNC = 6
letting NCST = 7
letting UVA = 8
letting WAKE = 9
$ rival of each team (0 for Florida State, which has none): Duke-UNC, Clem-GT, NCSt-Wake, UMD-UVA
letting RIVAL = [4, 6, 0, 1, 8, 2, 9, 5, 7]

find opp : matrix indexed by [int(1..n_days), int(1..n_teams)] of int(1..n_teams)
find where_ : matrix indexed by [int(1..n_days), int(1..n_teams)] of int(0..2)
find config : matrix indexed by [int(1..n_days), int(1..n_teams)] of int(0..n_teams-1)

branching on [opp, where_]

such that
$ config is the opponent numbered from 0 (a bye has the team itself as opponent)
forAll d : int(1..n_days) . forAll i : int(1..n_teams) . (config[d,i] = opp[d,i] - 1),
$ a bye is the team playing itself, and home/away is consistent between the two teams of a match
forAll d : int(1..n_days) . forAll i : int(1..n_teams) . ((where_[d,i] = 1) <-> (opp[d,i] = i)),
forAll d : int(1..n_days) . forAll i : int(1..n_teams) . ((where_[d,i] != 1) -> ((opp[d,opp[d,i]] = i) /\ (where_[d,opp[d,i]] + where_[d,i] = 2))),
$ double round robin: each team plays each other team once at home and once away
forAll i, j : int(1..n_teams) . ((i != j) -> (((sum d : int(1..n_days) . toInt((opp[d,i] = j) /\ (where_[d,i] = 0))) = 1) /\ ((sum d : int(1..n_days) . toInt((opp[d,i] = j) /\ (where_[d,i] = 2))) = 1))),
$ mirroring: the dates are grouped into pairs (1,8), (2,9), (3,12), (4,13), (5,14), (6,15), (7,16), (10,17), (11,18), and each team plays the same opponent in both dates of a pair
forAll i : int(1..n_teams) . (opp[1,i] = opp[8,i]),
forAll i : int(1..n_teams) . (opp[2,i] = opp[9,i]),
forAll i : int(1..n_teams) . (opp[3,i] = opp[12,i]),
forAll i : int(1..n_teams) . (opp[4,i] = opp[13,i]),
forAll i : int(1..n_teams) . (opp[5,i] = opp[14,i]),
forAll i : int(1..n_teams) . (opp[6,i] = opp[15,i]),
forAll i : int(1..n_teams) . (opp[7,i] = opp[16,i]),
forAll i : int(1..n_teams) . (opp[10,i] = opp[17,i]),
forAll i : int(1..n_teams) . (opp[11,i] = opp[18,i]),
$ no team can play away on both of the last two dates
forAll i : int(1..n_teams) . !((where_[17,i] = 2) /\ (where_[18,i] = 2)),
$ no team may have more than two away matches in a row
forAll d : int(1..n_days-2) . forAll i : int(1..n_teams) . !((where_[d,i] = 2) /\ (where_[d+1,i] = 2) /\ (where_[d+2,i] = 2)),
$ no team may have more than two home matches in a row
forAll d : int(1..n_days-2) . forAll i : int(1..n_teams) . !((where_[d,i] = 0) /\ (where_[d+1,i] = 0) /\ (where_[d+2,i] = 0)),
$ no team may have more than three away matches or byes in a row (so every four consecutive dates include a home match)
forAll d : int(1..n_days-3) . forAll i : int(1..n_teams) . ((where_[d,i] = 0) \/ (where_[d+1,i] = 0) \/ (where_[d+2,i] = 0) \/ (where_[d+3,i] = 0)),
$ no team may have more than four home matches or byes in a row (so every five consecutive dates include an away match)
forAll d : int(1..n_days-4) . forAll i : int(1..n_teams) . ((where_[d,i] = 2) \/ (where_[d+1,i] = 2) \/ (where_[d+2,i] = 2) \/ (where_[d+3,i] = 2) \/ (where_[d+4,i] = 2)),
$ weekend pattern: over the weekends (the even dates) each team plays four at home, four away and has one bye
forAll i : int(1..n_teams) . ((sum w : int(1..n_days / 2) . toInt(where_[2*w,i] = 0)) = 4),
forAll i : int(1..n_teams) . ((sum w : int(1..n_days / 2) . toInt(where_[2*w,i] = 2)) = 4),
forAll i : int(1..n_teams) . ((sum w : int(1..n_days / 2) . toInt(where_[2*w,i] = 1)) = 1),
$ first weekends: each team has a home match or a bye on at least two of the first five weekends
forAll i : int(1..n_teams) . ((sum w : int(1..5) . toInt(where_[2*w,i] != 2)) >= 2),
$ last date: every team except Florida State plays its rival, unless it plays Florida State or has a bye
forAll i : int(1..n_teams) . ((RIVAL[i] != 0) -> ((opp[n_days,i] = RIVAL[i]) \/ (opp[n_days,i] = FSU) \/ (opp[n_days,i] = i))),
$ the constrained matches Wake-UNC, Wake-Duke, GT-UNC and GT-Duke each occur at least once in dates 11 to 18
(exists d : int(11..n_days) . (opp[d,WAKE] = UNC)),
(exists d : int(11..n_days) . (opp[d,WAKE] = DUKE)),
(exists d : int(11..n_days) . (opp[d,GT] = UNC)),
(exists d : int(11..n_days) . (opp[d,GT] = DUKE)),
$ no team plays away on two consecutive dates against UNC and Duke (one on each date)
forAll d : int(1..n_days-1) . forAll i : int(1..n_teams) . !((where_[d,i] = 2) /\ (where_[d+1,i] = 2) /\ (((opp[d,i] = UNC) /\ (opp[d+1,i] = DUKE)) \/ ((opp[d,i] = DUKE) /\ (opp[d+1,i] = UNC)))),
$ no team plays in three consecutive dates against UNC, Duke and Wake (in any order, whether home or away)
forAll d : int(1..n_days-2) . forAll i : int(1..n_teams) . !((where_[d,i] != 1) /\ (where_[d+1,i] != 1) /\ (where_[d+2,i] != 1) /\ allDiff([opp[d,i], opp[d+1,i], opp[d+2,i]]) /\ ((opp[d,i] = UNC) \/ (opp[d,i] = DUKE) \/ (opp[d,i] = WAKE)) /\ ((opp[d+1,i] = UNC) \/ (opp[d+1,i] = DUKE) \/ (opp[d+1,i] = WAKE)) /\ ((opp[d+2,i] = UNC) \/ (opp[d+2,i] = DUKE) \/ (opp[d+2,i] = WAKE))),
$ UNC plays its rival Duke on the last date and on date 11
opp[n_days,UNC] = DUKE,
opp[11,UNC] = DUKE,
$ UNC plays Clemson on the second date
opp[2,UNC] = CLEM,
$ Duke has a bye on date 16
where_[16,DUKE] = 1,
$ Wake does not play at home on date 17
where_[17,WAKE] != 0,
$ Wake has a bye on the first date
where_[1,WAKE] = 1,
$ Clemson, Duke, Maryland and Wake do not play away on the last date
where_[n_days,CLEM] != 2,
where_[n_days,DUKE] != 2,
where_[n_days,UMD] != 2,
where_[n_days,WAKE] != 2,
$ Clemson, Florida State, Georgia Tech and Wake do not play away on the first date
where_[1,CLEM] != 2,
where_[1,FSU] != 2,
where_[1,GT] != 2,
where_[1,WAKE] != 2,
$ neither Florida State nor NC State has a bye on the last date
where_[n_days,FSU] != 1,
where_[n_days,NCST] != 1,
$ UNC does not have a bye on the first date
where_[1,UNC] != 1
