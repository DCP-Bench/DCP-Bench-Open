language ESSENCE' 1.0
$ Complete the 6x5 crossword by choosing 8 distinct words from the list of 15, so that each numbered slot is filled by one chosen word that crosses correctly.
letting WORDS be [[8, 15, 19, 5, 19],
  [12, 1, 19, 5, 18],
  [19, 1, 9, 12, 19],
  [19, 8, 5, 5, 20],
  [19, 20, 5, 5, 18],
  [8, 5, 5, 12, 0],
  [8, 9, 11, 5, 0],
  [11, 5, 5, 12, 0],
  [11, 14, 15, 20, 0],
  [12, 9, 14, 5, 0],
  [1, 6, 20, 0, 0],
  [1, 12, 5, 0, 0],
  [5, 5, 12, 0, 0],
  [12, 5, 5, 0, 0],
  [20, 9, 5, 0, 0]]
find E : matrix indexed by [int(1..8)] of int(0..14)
find grid : matrix indexed by [int(1..6), int(1..5)] of int(0..26)

branching on [E]

such that
$ the eight chosen words are distinct
allDiff(E),
$ black squares of the grid carry no letter
grid[2,1] = 0,
grid[2,2] = 0,
grid[2,4] = 0,
grid[3,1] = 0,
grid[4,2] = 0,
grid[6,2] = 0,
grid[6,3] = 0,
grid[6,5] = 0,
$ 1 across: the top row of five letters is a five-letter word
(E[1] >= 0) /\ (E[1] <= 4),
grid[1,1] = WORDS[E[1] + 1, 1],
grid[1,2] = WORDS[E[1] + 1, 2],
grid[1,3] = WORDS[E[1] + 1, 3],
grid[1,4] = WORDS[E[1] + 1, 4],
grid[1,5] = WORDS[E[1] + 1, 5],
$ 2 down: the column three letters from the top is a five-letter word
(E[2] >= 0) /\ (E[2] <= 4),
grid[1,3] = WORDS[E[2] + 1, 1],
grid[2,3] = WORDS[E[2] + 1, 2],
grid[3,3] = WORDS[E[2] + 1, 3],
grid[4,3] = WORDS[E[2] + 1, 4],
grid[5,3] = WORDS[E[2] + 1, 5],
$ 3 down: the column five letters from the top is a five-letter word
(E[3] >= 0) /\ (E[3] <= 4),
grid[1,5] = WORDS[E[3] + 1, 1],
grid[2,5] = WORDS[E[3] + 1, 2],
grid[3,5] = WORDS[E[3] + 1, 3],
grid[4,5] = WORDS[E[3] + 1, 4],
grid[5,5] = WORDS[E[3] + 1, 5],
$ 4 across: the row 3 run of four letters is a four-letter word
(E[4] >= 5) /\ (E[4] <= 9),
grid[3,2] = WORDS[E[4] + 1, 1],
grid[3,3] = WORDS[E[4] + 1, 2],
grid[3,4] = WORDS[E[4] + 1, 3],
grid[3,5] = WORDS[E[4] + 1, 4],
$ 5 down: the column four run from row 3 is a four-letter word
(E[5] >= 5) /\ (E[5] <= 9),
grid[3,4] = WORDS[E[5] + 1, 1],
grid[4,4] = WORDS[E[5] + 1, 2],
grid[5,4] = WORDS[E[5] + 1, 3],
grid[6,4] = WORDS[E[5] + 1, 4],
$ 6 down: the column three run from row 4 is a three-letter word
(E[6] >= 10) /\ (E[6] <= 14),
grid[4,1] = WORDS[E[6] + 1, 1],
grid[5,1] = WORDS[E[6] + 1, 2],
grid[6,1] = WORDS[E[6] + 1, 3],
$ 7 across: the row 4 run of three letters is a three-letter word
(E[7] >= 10) /\ (E[7] <= 14),
grid[4,3] = WORDS[E[7] + 1, 1],
grid[4,4] = WORDS[E[7] + 1, 2],
grid[4,5] = WORDS[E[7] + 1, 3],
$ 8 across: the bottom row of five letters is a five-letter word
(E[8] >= 0) /\ (E[8] <= 4),
grid[5,1] = WORDS[E[8] + 1, 1],
grid[5,2] = WORDS[E[8] + 1, 2],
grid[5,3] = WORDS[E[8] + 1, 3],
grid[5,4] = WORDS[E[8] + 1, 4],
grid[5,5] = WORDS[E[8] + 1, 5]
