language ESSENCE' 1.0
$ Load supply containers onto a rectangular deck without overlap, keeping the required separation between container classes.
given deck_width : int(1..)
given deck_length : int(1..)
given n_containers : int(1..)
given width : matrix indexed by [int(1..n_containers)] of int(1..)
given length : matrix indexed by [int(1..n_containers)] of int(1..)
given classes : matrix indexed by [int(1..n_containers)] of int(1..)
given separation_dim1, separation_dim2 : int(1..)
given separation : matrix indexed by [int(1..separation_dim1), int(1..separation_dim2)] of int(0..)
find left, right : matrix indexed by [int(1..n_containers)] of int(0..deck_width)
find bottom, top : matrix indexed by [int(1..n_containers)] of int(0..deck_length)
$ a container is turned by 90 degrees when rotated, so its horizontal and vertical extents are width and length in some order
find rotated : matrix indexed by [int(1..n_containers)] of bool
$ horizontal and vertical extent of each container on the deck
find dx : matrix indexed by [int(1..n_containers)] of int(1..deck_width)
find dy : matrix indexed by [int(1..n_containers)] of int(1..deck_length)

branching on [left, bottom, rotated]
heuristic sdf

such that
$ each container occupies exactly its width and length on the deck, in its chosen orientation
forAll i : int(1..n_containers) . ((!rotated[i]) -> (dx[i] = width[i] /\ dy[i] = length[i])) /\ (rotated[i] -> (dx[i] = length[i] /\ dy[i] = width[i])),
forAll i : int(1..n_containers) . (right[i] = left[i] + dx[i]) /\ (top[i] = bottom[i] + dy[i]),
$ the containers lying across any position along the deck fit within the deck width (redundant)
cumulative(left, dx, dy, deck_length),
$ the containers lying across any position across the deck fit within the deck length (redundant)
cumulative(bottom, dy, dx, deck_width),
$ two containers do not overlap, and containers of classes with a separation are at least that far apart along the deck or across the deck
forAll i : int(1..n_containers) . forAll j : int(i+1..n_containers) . ((right[i] + separation[classes[i], classes[j]] <= left[j]) \/ (right[j] + separation[classes[i], classes[j]] <= left[i]) \/ (top[i] + separation[classes[i], classes[j]] <= bottom[j]) \/ (top[j] + separation[classes[i], classes[j]] <= bottom[i]))
