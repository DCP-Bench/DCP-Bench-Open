language ESSENCE' 1.0
$ Progressive party: choose which boats are hosts and a visit schedule for the guest boats over the periods, minimising the number of host boats.
given n_boats : int
given n_periods : int
$ capacity of each boat (people it can hold at once), one entry per boat
given capacity : matrix indexed by [int(1..n_boats)] of int
$ number of crew members on each boat, one entry per boat
given crew_size : matrix indexed by [int(1..n_boats)] of int
$ is_host[b] is true when boat b is a host boat (boats are numbered from 1 in the model, from 0 in the output)
find is_host : matrix indexed by [int(1..n_boats)] of bool
$ visits[p,b] is the 0-based index of the host boat visited by boat b in period p; a host boat visits itself
find visits : matrix indexed by [int(1..n_periods), int(1..n_boats)] of int(0..n_boats-1)
$ num_hosts is the number of host boats
find num_hosts : int(0..n_boats)
heuristic sdf
branching on [is_host, num_hosts, visits]
minimising num_hosts
such that
$ the number of host boats is the number of boats designated as hosts
num_hosts = (sum b : int(1..n_boats) . toInt(is_host[b])),
$ a host boat stays at its own position in every period
forAll p : int(1..n_periods) . forAll b : int(1..n_boats) . is_host[b] -> visits[p,b] = b - 1,
$ a guest boat visits a host boat in every period
forAll p : int(1..n_periods) . forAll b : int(1..n_boats) . (!is_host[b]) -> is_host[visits[p,b] + 1],
$ a guest boat cannot revisit a host: its visits are all different over the periods
forAll b : int(1..n_boats) . (!is_host[b]) -> allDiff(visits[..,b]),
$ the total people aboard a host boat, its own crew and the guest crews visiting it, do not exceed its capacity
forAll p : int(1..n_periods) . forAll h : int(1..n_boats) . ((sum b : int(1..n_boats) . crew_size[b] * toInt(visits[p,b] = h - 1)) <= capacity[h]),
$ redundant: in each period the crews of the guest boats fit into the spare room of the host boats
forAll p : int(1..n_periods) . ((sum b : int(1..n_boats) . toInt(!is_host[b]) * crew_size[b]) <= (sum b : int(1..n_boats) . toInt(is_host[b]) * (capacity[b] - crew_size[b]))),
$ symmetry: boats with the same capacity and crew size are interchangeable, so among them the host boats come first
forAll i, j : int(1..n_boats) . (i < j /\ capacity[i] = capacity[j] /\ crew_size[i] = crew_size[j]) -> (is_host[j] -> is_host[i]),
$ two crews meet at most once: for two boats, the number of periods in which they are at the same boat is at most one
forAll i, j : int(1..n_boats) . (i < j) -> ((sum p : int(1..n_periods) . toInt(visits[p,i] = visits[p,j])) <= 1)
