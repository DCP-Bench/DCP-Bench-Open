language ESSENCE' 1.0
$ Choose which of the four candidate warehouses to open and how much each open warehouse ships to each region, so that all regional demands are met at minimum total cost (fixed costs plus shipping costs).
given demands_dim1 : int(1..)
given demands : matrix indexed by [int(1..demands_dim1)] of int(0..)
given fixed_costs : matrix indexed by [int(1..4)] of int(0..)
given max_shipping : int(0..)
given shipping_costs : matrix indexed by [int(1..4), int(1..demands_dim1)] of int(0..)
find open_warehouse : matrix indexed by [int(1..4)] of bool
find ships : matrix indexed by [int(1..4), int(1..demands_dim1)] of int(0..max_shipping)
find total_cost : int(0..1000000)

minimising total_cost

such that
$ if the New York warehouse (1) is opened then the Los Angeles warehouse (2) must also be opened
(open_warehouse[1] -> open_warehouse[2]),
$ no more than three warehouses can be operational
(sum i : int(1..4) . toInt(open_warehouse[i])) <= 3,
$ either the Atlanta (4) or the Los Angeles (2) warehouse must be opened
(open_warehouse[4] \/ open_warehouse[2]),
$ each warehouse ships at most max_shipping units, and nothing from a warehouse that is not open
forAll i : int(1..4) . ((sum j : int(1..demands_dim1) . ships[i,j]) <= (max_shipping * toInt(open_warehouse[i]))),
$ each region receives exactly its demand from the warehouses
forAll j : int(1..demands_dim1) . ((sum i : int(1..4) . ships[i,j]) = demands[j]),
$ the total cost is the fixed costs of the open warehouses plus the shipping costs of the units shipped
total_cost = ((sum i : int(1..4) . (fixed_costs[i] * toInt(open_warehouse[i]))) + (sum i : int(1..4) . sum j : int(1..demands_dim1) . (shipping_costs[i,j] * ships[i,j])))
