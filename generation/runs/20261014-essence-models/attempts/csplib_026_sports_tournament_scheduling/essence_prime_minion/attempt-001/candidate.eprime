language ESSENCE' 1.0
$ Schedule a round-robin tournament of n teams over n-1 weeks, each week split into n/2 periods of two slots (home and away), with every team playing every other team exactly once.
given n_teams : int
find home : matrix indexed by [int(1..n_teams-1), int(1..n_teams/2)] of int(1..n_teams)
find away : matrix indexed by [int(1..n_teams-1), int(1..n_teams/2)] of int(1..n_teams)

such that
$ every team plays exactly once each week: the teams in the slots of a week are all different
forAll w : int(1..n_teams-1) . (allDiff(cat(home[w,..], away[w,..]))),
$ every team plays every other team exactly once over the tournament
forAll i : int(1..n_teams) . forAll j : int(i+1..n_teams) . ((sum w : int(1..n_teams-1) . (sum p : int(1..n_teams/2) . toInt((home[w,p] = i /\ away[w,p] = j) \/ (home[w,p] = j /\ away[w,p] = i)))) = 1),
$ every team plays at most twice in the same period over the tournament
forAll i : int(1..n_teams) . forAll p : int(1..n_teams/2) . ((sum w : int(1..n_teams-1) . toInt((home[w,p] = i) \/ (away[w,p] = i))) <= 2),
$ a team does not play itself
forAll w : int(1..n_teams-1) . forAll p : int(1..n_teams/2) . (home[w,p] != away[w,p])
