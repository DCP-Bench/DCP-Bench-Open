language ESSENCE' 1.0
$ A farmer must take a wolf, a goat and a cabbage across a river in a boat that carries the farmer and at most one item. Nothing may be eaten: the wolf must not be left with the goat, and the goat must not be left with the cabbage, without the farmer. All start on the starting shore (0) and all end on the destination shore (1).
given stage : int(1..)
$ each position is true if that thing is on the destination shore at that stage, false on the starting shore
find wolf_pos : matrix indexed by [int(1..stage)] of bool
find goat_pos : matrix indexed by [int(1..stage)] of bool
find cabbage_pos : matrix indexed by [int(1..stage)] of bool
find boat_pos : matrix indexed by [int(1..stage)] of bool

such that
$ at the start every item and the farmer's boat are on the starting shore
wolf_pos[1] = false,
goat_pos[1] = false,
cabbage_pos[1] = false,
boat_pos[1] = false,
$ at the end every item and the boat are on the destination shore
wolf_pos[stage] = true,
goat_pos[stage] = true,
cabbage_pos[stage] = true,
boat_pos[stage] = true,
$ the boat crosses the river at every stage, so it changes shore between consecutive stages
forAll k : int(1..stage-1) . boat_pos[k+1] != boat_pos[k],
$ an item can only change shore when the boat is on the shore it is on, and the boat carries the farmer and at most one item per crossing
forAll k : int(1..stage-1) . (wolf_pos[k+1] != wolf_pos[k]) -> (wolf_pos[k] = boat_pos[k]),
forAll k : int(1..stage-1) . (goat_pos[k+1] != goat_pos[k]) -> (goat_pos[k] = boat_pos[k]),
forAll k : int(1..stage-1) . (cabbage_pos[k+1] != cabbage_pos[k]) -> (cabbage_pos[k] = boat_pos[k]),
forAll k : int(1..stage-1) . (toInt(wolf_pos[k+1] != wolf_pos[k]) + toInt(goat_pos[k+1] != goat_pos[k]) + toInt(cabbage_pos[k+1] != cabbage_pos[k])) <= 1,
$ the wolf is never left alone with the goat when the farmer is on the other shore
forAll k : int(1..stage) . (wolf_pos[k] = goat_pos[k]) -> (boat_pos[k] = wolf_pos[k]),
$ the goat is never left alone with the cabbage when the farmer is on the other shore
forAll k : int(1..stage) . (goat_pos[k] = cabbage_pos[k]) -> (boat_pos[k] = goat_pos[k])
