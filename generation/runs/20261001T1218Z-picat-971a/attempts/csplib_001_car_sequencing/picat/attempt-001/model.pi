% Car sequencing: order the cars on an assembly line so that every option's station
% is never overloaded, i.e. at most at_most[o] of any per_slots[o] consecutive cars
% need option o, while each car type is produced exactly as often as demanded.
import cp.

model(Data, Vars, Outputs, Options) =>
    AtMost = Data.get(at_most),        % capacity of the station of each option
    PerSlots = Data.get(per_slots),    % length of the window the capacity refers to
    Demand = Data.get(demand),         % number of cars wanted of each type
    Requires = Data.get(requires),     % Requires[t, o] = 1 if type t needs option o
    NCars = sum(Demand),               % one slot per car to produce
    NTypes = len(Demand),
    NOptions = len(AtMost),
    % Sequence[s] = the car type (numbered from 0) in slot s
    Sequence = new_list(NCars),
    Sequence :: 0..NTypes-1,
    % each type appears exactly as many times as demanded
    foreach (T in 1..NTypes)
        count(T - 1, Sequence, #=, Demand[T])
    end,
    % Setup[s, o] = 1 if the car in slot s needs option o (looked up from its type)
    Setup = new_array(NCars, NOptions),
    Setup :: 0..1,
    foreach (O in 1..NOptions)
        Column = [Requires[T, O] : T in 1..NTypes],
        foreach (S in 1..NCars)
            element0(Sequence[S], Column, Setup[S, O])
        end
    end,
    % in every window of per_slots[o] consecutive slots, at most at_most[o] cars need option o
    foreach (O in 1..NOptions, S in 1..NCars - PerSlots[O] + 1)
        sum([Setup[S + K, O] : K in 0..PerSlots[O] - 1]) #=< AtMost[O]
    end,
    Vars = Sequence,
    Outputs = [sequence = Sequence],
    Options = [ff].
