% Vessel loading diagnostic: report the instance data.
import cp.

model(Data, Vars, Outputs, Options) =>
    DeckWidth = Data.get(deck_width),
    DeckLength = Data.get(deck_length),
    N = Data.get(n_containers),
    Widths = Data.get(width),
    Lengths = Data.get(length),
    Classes = Data.get(classes),
    Separation = Data.get(separation),
    Vars = [],
    Outputs = [left = $diag(N, DeckWidth, DeckLength, Widths, Lengths, Classes, Separation)],
    Options = [].
