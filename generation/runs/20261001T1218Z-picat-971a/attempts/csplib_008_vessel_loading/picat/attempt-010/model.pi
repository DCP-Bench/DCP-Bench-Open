% Vessel loading: place rectangular containers on a rectangular deck, without overlap and
% parallel to the deck sides, so that containers of certain classes keep a minimum distance
% between them. Containers may be rotated by a quarter turn. The output is the left, right,
% top and bottom coordinate of every container, counted from 0.
% Encoded with sat: with cp the 16 x 16 instances (10 containers whose areas fill the deck
% exactly) did not finish within 180 s.
import sat.

model(Data, Vars, Outputs, Options) =>
    DeckWidth = Data.get(deck_width),
    DeckLength = Data.get(deck_length),
    N = Data.get(n_containers),
    Widths = Data.get(width),            % one side of each container
    % Data.get(length) with the atom written out returns 2 instead of the field, so the
    % key goes through a variable
    LengthKey = 'length',
    Lengths = Data.get(LengthKey),       % the other side of each container
    Classes = Data.get(classes),         % class of each container (1-based)
    Separation = Data.get(separation),   % minimum distance between two classes
    % each container lies on the deck: x coordinates in 0..deck_width, y in 0..deck_length
    Left = new_list(N),
    Right = new_list(N),
    Top = new_list(N),
    Bottom = new_list(N),
    Left :: 0..DeckWidth,
    Right :: 0..DeckWidth,
    Top :: 0..DeckLength,
    Bottom :: 0..DeckLength,
    % a container keeps its width and length, either as given (Turned = 0) or turned by a
    % quarter turn (Turned = 1); this replaces the either/or of the two shapes by one
    % 0/1 variable per container. A square has one shape only, so it is not turned.
    Turned = new_list(N),
    Turned :: 0..1,
    foreach (I in 1..N)
        Right[I] #= Left[I] + Widths[I] + Turned[I] * (Lengths[I] - Widths[I]),
        Top[I] #= Bottom[I] + Lengths[I] - Turned[I] * (Lengths[I] - Widths[I]),
        if Widths[I] == Lengths[I] then
            Turned[I] #= 0
        end
    end,
    % two containers do not overlap, and are at least the separation of their classes apart:
    % one is to the left of, to the right of, below or above the other
    foreach (A in 1..N - 1, B in A + 1..N)
        SepRow = Separation[Classes[A]],
        Sep = SepRow[Classes[B]],
        (Right[A] + Sep #=< Left[B]) #\/ (Left[A] #>= Right[B] + Sep) #\/
        (Top[A] + Sep #=< Bottom[B]) #\/ (Bottom[A] #>= Top[B] + Sep)
    end,
    % implied: along any vertical line over the deck, the containers it crosses have lengths
    % adding up to at most the deck length (their heights, whether turned or not); along any
    % horizontal line, widths adding up to at most the deck width
    foreach (Col in 0..DeckWidth - 1)
        sum([Lengths[I] * (Left[I] #=< Col #/\ Col #< Right[I])
             - (Lengths[I] - Widths[I]) * (Left[I] #=< Col #/\ Col #< Right[I] #/\ Turned[I] #= 1)
             : I in 1..N]) #=< DeckLength
    end,
    foreach (Row in 0..DeckLength - 1)
        sum([Widths[I] * (Bottom[I] #=< Row #/\ Row #< Top[I])
             + (Lengths[I] - Widths[I]) * (Bottom[I] #=< Row #/\ Row #< Top[I] #/\ Turned[I] #= 1)
             : I in 1..N]) #=< DeckWidth
    end,
    Vars = Left ++ Bottom ++ Turned ++ Right ++ Top,
    Outputs = [left = Left, right = Right, top = Top, bottom = Bottom],
    Options = [].
