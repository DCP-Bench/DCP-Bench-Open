% Maximum density still life: find the most densely populated stable pattern of Conway's Game
% of Life on an n x m grid, on an infinite board whose cells outside the grid are dead. A
% pattern is stable if every live cell has exactly 2 or 3 live neighbours (so it stays alive)
% and no dead cell, inside the grid or just outside it, has exactly 3 live neighbours (so none is
% born). Maximise the number of live cells.
% Encoded with sat: with cp the 8 x 8 instance did not finish within 180 s, with sat it took 6 s.
import sat.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),                      % number of rows of the grid
    M = Data.get(m),                      % number of columns of the grid
    % Grid[i, j] = 1 if the cell in row i, column j is alive
    Grid = new_array(N, M),
    Grid :: 0..1,
    % a live cell has 2 or 3 live neighbours, a dead cell does not have exactly 3
    foreach (I in 1..N, J in 1..M)
        Neighbours = [Grid[I + DI, J + DJ] : DI in -1..1, DJ in -1..1,
                      (DI != 0 ; DJ != 0),
                      I + DI >= 1, I + DI =< N, J + DJ >= 1, J + DJ =< M],
        Count #= sum(Neighbours),
        Grid[I, J] #= 1 #=> (Count #>= 2 #/\ Count #=< 3),
        Grid[I, J] #= 0 #=> Count #!= 3
    end,
    % a dead cell just outside the grid does not have exactly 3 live neighbours: the three cells
    % of the grid edge next to it (corners of the board outside the grid have at most one)
    foreach (J in 1..M)
        sum([Grid[1, JJ] : JJ in max(1, J - 1)..min(M, J + 1)]) #!= 3,
        sum([Grid[N, JJ] : JJ in max(1, J - 1)..min(M, J + 1)]) #!= 3
    end,
    foreach (I in 1..N)
        sum([Grid[II, 1] : II in max(1, I - 1)..min(N, I + 1)]) #!= 3,
        sum([Grid[II, M] : II in max(1, I - 1)..min(N, I + 1)]) #!= 3
    end,
    % the number of live cells
    Live #= sum([Grid[I, J] : I in 1..N, J in 1..M]),
    Vars = Grid,
    Outputs = [grid = Grid],
    Options = [$max(Live)].
