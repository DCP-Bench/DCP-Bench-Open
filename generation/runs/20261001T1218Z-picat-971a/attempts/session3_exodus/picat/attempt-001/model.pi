% Exodus: five children (Bernice, Carl, Debby, Sammy, Ted) each tell one part of the Exodus
% story, are a different age (3, 5, 7, 8, 10) and come from a different country (Ethiopia,
% Kazakhstan, Lithuania, Morocco, Yemen). Every variable below holds the number 1..5 of the
% child it names, so equal numbers across the four lists mean the same child.
import cp.

model(Data, Vars, Outputs, Options) =>
    AgeValues = [3, 5, 7, 8, 10],    % the five ages, in the order of the statement
    % Ages[k] = the child who is AgeValues[k] years old
    Ages = new_list(5),
    Ages :: 1..5,
    % the five children, in the order of the statement
    Children = [Bernice, Carl, Debby, Sammy, Ted],
    Children :: 1..5,
    Countries = [Ethiopia, Kazakhstan, Lithuania, Morocco, Yemen],
    Countries :: 1..5,
    Stories = [BurningBush, Captivity, MosesYouth, Passover, TenCommandments],
    Stories :: 1..5,
    % each age, child, country and story belongs to exactly one child
    all_different(Ages),
    all_different(Children),
    all_different(Countries),
    all_different(Stories),
    % AgeOf[c] = the age in years of child c; it reads the age out of Ages (the child holding
    % the k-th age is Ages[k], so that child's age is AgeValues[k])
    AgeOf = new_list(5),
    AgeOf :: AgeValues,
    foreach (K in 1..5)
        element(Ages[K], AgeOf, AgeValues[K])
    end,
    % 1. Debby's family is from Lithuania.
    Debby #= Lithuania,
    % 2. The child who told the story of the Passover is two years older than Bernice.
    element(Passover, AgeOf, AgePassover),
    element(Bernice, AgeOf, AgeBernice),
    AgePassover #= AgeBernice + 2,
    % 3. The child whose family is from Yemen is younger than the child from the Ethiopian family.
    element(Yemen, AgeOf, AgeYemen),
    element(Ethiopia, AgeOf, AgeEthiopia),
    AgeYemen #< AgeEthiopia,
    % 4. The child from the Moroccan family is three years older than Ted.
    element(Morocco, AgeOf, AgeMorocco),
    element(Ted, AgeOf, AgeTed),
    AgeMorocco #= AgeTed + 3,
    % 5. Sammy is three years older than the child who told the story of Moses's youth.
    element(Sammy, AgeOf, AgeSammy),
    element(MosesYouth, AgeOf, AgeMosesYouth),
    AgeSammy #= AgeMosesYouth + 3,
    Vars = Ages ++ Children ++ Countries ++ Stories ++ AgeOf,
    Outputs = [ages = Ages, children = Children, countries = Countries, stories = Stories],
    Options = [].
