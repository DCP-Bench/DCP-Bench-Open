// A company is considering a number of investments; how to maximize the NPV obtained from the investments?
vocabulary {
    type I <: Int                       // the investments, sized from the NPV list
    budget: () -> Int                   // a total budget available for investment
    npv: I -> Int                       // each investment will yield a net present value (NPV)
    cash_flow: I -> Int                 // each investment requires a certain cash outflow at the present time
    x: I -> Bool                        // declared output: whether each investment is chosen
    z: () -> Int                        // declared output: the total NPV
    maximize: () -> Int                 // objective: maximize the NPV obtained
}
theory {
    // whether each investment is chosen is a yes/no decision (x)

    // the total cash outflow of the chosen investments must fit within the total budget available for investment
    sum{{ cash_flow(i) | i in I: x(i) }} =< budget().

    // the total NPV (z) is the sum of the NPVs of the chosen investments
    z() = sum{{ npv(i) | i in I: x(i) }}.

    // maximize the NPV obtained from the investments
    maximize() = z().
}
