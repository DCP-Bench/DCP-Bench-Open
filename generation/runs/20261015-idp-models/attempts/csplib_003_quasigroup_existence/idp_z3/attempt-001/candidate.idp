// Order m quasigroup (Latin square) in which (a*b)*(b*a) = a for all a, b.
vocabulary {
    // Rows, columns and table entries are the m elements, numbered 1..m internally.
    type Elt := {1..${m}}
    m: () -> Int

    // internal multiplication table over 1..m
    cell: Elt * Elt -> Elt
    // declared output: the table over 0..m-1
    quasigroup: Elt * Elt -> Int
}
theory {
    // the output values are the elements 0..m-1
    ! a, b in Elt: quasigroup(a, b) = cell(a, b) - 1.

    // each row contains each element once
    ! a, b1, b2 in Elt: b1 ~= b2 => cell(a, b1) ~= cell(a, b2).

    // each column contains each element once
    ! a1, a2, b in Elt: a1 ~= a2 => cell(a1, b) ~= cell(a2, b).

    // QG3: (a*b)*(b*a) = a
    ! a, b in Elt: cell(cell(a, b), cell(b, a)) = a.
}
