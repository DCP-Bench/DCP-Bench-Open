// Archery puzzle: how close can the archer come to a target total score, using as many arrows as she pleases on the given targets?
vocabulary {
    // one ring per target, sized from the instance's targets array
    type Ring <: Int
    // number of hits per target is at most the target score (see note in theory)
    type Hits := {0..${target_score}}

    // the scores of the rings, from the instance
    targets: Ring -> Int
    // the target score, from the instance
    target_score: () -> Int

    // declared output: number of hits on each target
    hits: Ring -> Hits
    // total score of all arrows shot
    total: () -> Int
    // deviation of the total from the target score
    minimize: () -> Int
}
theory {
    // the total score is the sum over the targets of hits times the target's score
    total() = sum{{ (hits(r) * targets(r)) | r in Ring }}.

    // the objective is how far the total is from the target score, in either direction
    minimize() = abs(total() - target_score()).

    // note: no optimal solution needs more than target_score hits on one target, since removing
    // an arrow from a target with at least target_score + 1 hits keeps the total at or above the target
    // and lowers the deviation, so the range of Hits does not cut off an optimum.
}
