// Find a non-empty series S = (s0, s1, ..., sn, sn+1) such that s_i is the
// number of occurrences of i in S for each i from 0 to n, and s_{n+1} = m.
vocabulary {
    // Instance data: n and m.
    n: () -> Int
    m: () -> Int
    // The series positions are numbered -1..n, so position k holds s_{k+1}.
    type Idx := {-1..${n}}
    // The entries of the series are values 0..n.
    type Val := {0..${n}}
    // Declared output: the series S, with s(k) = s_{k+1}.
    s: Idx -> Val
}
theory {
    // the last entry s_{n+1} equals m
    s(n()) = m().

    // for each i from 0 to n, s_i is the number of occurrences of i in S
    ! i in Idx: i >= 0 => #{k in Idx: s(k) = i} = s(i - 1).

    // the entries of S add up to n+2 (the number of entries in the first n+1 positions) plus m
    sum{{ s(k) | k in Idx }} = n() + 2 + m().
}
