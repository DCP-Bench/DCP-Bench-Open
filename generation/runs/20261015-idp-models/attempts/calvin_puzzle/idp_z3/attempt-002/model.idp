// Calvin puzzle: fill an n by n grid with the numbers 1..n*n, in order,
// so that each number after the previous one is placed either three squares
// away horizontally or vertically, or two squares away diagonally.
vocabulary {
    type Row := {0..${n-1}}
    type Col := {0..${n-1}}
    type Val := {1..${n*n}}
    x: Row * Col -> Val    // the number written in each square
    pr: Val -> Row         // row of the square holding a number
    pc: Val -> Col         // column of the square holding a number
}
theory {
    // every number is written in exactly one square
    ! r in Row, c in Col: pr(x(r, c)) = r & pc(x(r, c)) = c.
    ! v in Val: x(pr(v), pc(v)) = v.

    // the next number is placed exactly three squares away, horizontally or vertically
    // (a two square gap between the numbers)
    // and exactly two squares away diagonally (a one square gap)
    ! v, w in Val: w = v + 1 =>
            ((pr(w) - pr(v) = 0 & (pc(w) - pc(v) = 3 | pc(w) - pc(v) = -3)) |
             (pc(w) - pc(v) = 0 & (pr(w) - pr(v) = 3 | pr(w) - pr(v) = -3)) |
             ((pr(w) - pr(v) = 2 | pr(w) - pr(v) = -2) & (pc(w) - pc(v) = 2 | pc(w) - pc(v) = -2))).
}
