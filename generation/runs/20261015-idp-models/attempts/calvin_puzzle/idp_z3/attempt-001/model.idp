// Calvin puzzle: fill an n by n grid with the numbers 1 to n*n, each once,
// so that every number is placed by one of two moves from the previous number.
// Type I: a horizontal or vertical move exactly three squares away.
// Type II: a diagonal move exactly two squares away.
vocabulary {
    type N := {1..${n}}            // rows and columns, sized from n
    n: () -> Int                   // the grid size
    x: N * N -> Int                // declared output: the number in each square
    hi: N * N -> N                 // block of the number: number = (hi - 1) * n + lo
    lo: N * N -> N                 // position of the number inside its block
}
theory {
    // each square's number is written as a block and a position inside the block
    ! i, j in N: x(i, j) = (hi(i, j) - 1) * n() + lo(i, j).

    // every (block, position) pair is used once, so every number from 1 to n*n is used once
    ! i1, j1, i2, j2 in N: (i1 = i2 & j1 = j2) | (hi(i1, j1) ~= hi(i2, j2) | lo(i1, j1) ~= lo(i2, j2)).

    // the next number after k is placed by a move of type I or type II
    ! i1, j1, i2, j2 in N: (hi(i2, j2) = hi(i1, j1) & lo(i2, j2) = lo(i1, j1) + 1) | (hi(i2, j2) = hi(i1, j1) + 1 & lo(i1, j1) = n() & lo(i2, j2) = 1) => ((i2 = i1 & (j2 = j1 + 3 | j1 = j2 + 3)) | (j2 = j1 & (i2 = i1 + 3 | i1 = i2 + 3)) | ((i2 = i1 + 2 | i1 = i2 + 2) & (j2 = j1 + 2 | j1 = j2 + 2))).
}
