// A boy passes num_gates gates to give an apple to a girl; list the apples before each gate and after the last one.
vocabulary {
    // one position per gate, plus the position after the last gate
    type Pos := {0..${num_gates}}
    // bound on the number of apples at any point (the example needs at most 94)
    type Count := {0..200}
    // apples[p] = number of apples before gate p (p = num_gates: after the last gate)
    apples: Pos -> Count
}
theory {
    // at each gate the boy bribes the guard with half of his apples plus one,
    // so the apples after a gate are half of the apples before it minus one (an even number of apples before each gate)
    ! g, h in Pos: h = g + 1 => apples(g) = 2 * apples(h) + 2.

    // after the last gate he has one apple left, which he gives to the girl, leaving none
    apples(${num_gates}) = 1.
}
