// Arch friends: Harriet bought four shoes, each at a different store, in some order; find the purchase order and the store for each pair.
vocabulary {
    // the four stops of Harriet's shopping trip, numbered 1 to 4 in order
    type Stop := {1..4}

    // the stop at which each shoe was bought
    ecruespadrilles: () -> Stop
    fuchsiaflats: () -> Stop
    purplepumps: () -> Stop
    suedesandals: () -> Stop

    // the stop at which each store was visited
    footfarm: () -> Stop
    heelsinahandcart: () -> Stop
    theshoepalace: () -> Stop
    tootsies: () -> Stop
}
theory {
    // every shoe was bought on a different stop
    ecruespadrilles() ~= fuchsiaflats().
    ecruespadrilles() ~= purplepumps().
    ecruespadrilles() ~= suedesandals().
    fuchsiaflats() ~= purplepumps().
    fuchsiaflats() ~= suedesandals().
    purplepumps() ~= suedesandals().

    // every store was visited on a different stop
    footfarm() ~= heelsinahandcart().
    footfarm() ~= theshoepalace().
    footfarm() ~= tootsies().
    heelsinahandcart() ~= theshoepalace().
    heelsinahandcart() ~= tootsies().
    theshoepalace() ~= tootsies().

    // Harriet bought fuchsia flats at Heels in a Handcart
    fuchsiaflats() = heelsinahandcart().

    // The Foot Farm was Harriet's second stop
    footfarm() = 2.

    // the store she visited just after buying her purple pumps was not Tootsies
    tootsies() ~= purplepumps() + 1.

    // two stops after leaving The Shoe Palace, Harriet bought her suede sandals
    suedesandals() = theshoepalace() + 2.
}
