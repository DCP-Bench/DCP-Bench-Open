// Place n queens on an n x n chessboard (csplib 054) so that no two queens attack each other.
vocabulary {
    type Row := {1..${n}}           // rows and columns are 1..n
    queens: Row -> Row              // queens(r) is the column of the queen in row r
}
theory {
    // no two queens are in the same column
    ! r1, r2 in Row: r1 ~= r2 => queens(r1) ~= queens(r2).

    // no two queens are on the same diagonal (one way)
    ! r1, r2 in Row: r1 ~= r2 => queens(r1) - r1 ~= queens(r2) - r2.

    // no two queens are on the same diagonal (other way)
    ! r1, r2 in Row: r1 ~= r2 => queens(r1) + r1 ~= queens(r2) + r2.
}
