// Abbot's puzzle: 100 bushels of corn are distributed among 100 people, find the number of men, women and children.
vocabulary {
    men: () -> Int
    women: () -> Int
    children: () -> Int
}
theory {
    // there are 100 people in all
    men() + women() + children() = 100.
    // 100 bushels are distributed: each man gets three bushels, each woman two, each child half a bushel.
    // Multiplied by 2 to keep the arithmetic in whole numbers: 6 half-bushels per man, 4 per woman, 1 per child.
    6 * men() + 4 * women() + children() = 200.
    // there are five times as many women as men
    women() = 5 * men().
    // counts are not negative
    men() >= 0.
    women() >= 0.
    children() >= 0.
}
