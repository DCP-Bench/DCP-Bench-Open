// Sudoku: fill a 9x9 grid so each row, column and 3x3 section holds the digits 1 to 9.
vocabulary {
    // a row or column index, 0-based (sized from the input grid)
    type Row <: Int
    type Col <: Int
    // the digits of the puzzle
    type Digit := {1..9}

    // the input grid: 0 marks an empty cell, otherwise the given digit
    input_grid: Row * Col -> Int
    // the solved grid
    grid: Row * Col -> Digit
}

theory {
    // the filled cells keep the digits given in the puzzle
    ! r in Row, c in Col: input_grid(r, c) ~= 0 => grid(r, c) = input_grid(r, c).

    // each row contains every digit once
    ! r in Row, c1, c2 in Col: c1 ~= c2 => grid(r, c1) ~= grid(r, c2).

    // each column contains every digit once
    ! c in Col, r1, r2 in Row: r1 ~= r2 => grid(r1, c) ~= grid(r2, c).

    // each 3x3 section contains every digit once
    ! r1, r2 in Row, c1, c2 in Col:
        (r1 / 3 = r2 / 3 & c1 / 3 = c2 / 3 & (r1 ~= r2 | c1 ~= c2)) => grid(r1, c1) ~= grid(r2, c2).
}
