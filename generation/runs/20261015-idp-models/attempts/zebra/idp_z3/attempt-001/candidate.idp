// Zebra puzzle: five houses in a row, numbered 0 (left) to 4 (right). Each house
// has one colour, one nationality, one pet, one drink and one job. Output: for
// each attribute value, the number of the house that has it.
vocabulary {
    // The five houses, numbered 0 (left) to 4 (right). The five houses are a
    // fact of the problem statement, not of the instance.
    type House := {0..4}
    // Position of a value in its list, in the order the statement gives it.
    type Idx := {0..4}

    // Declared outputs: house of each colour, nationality, pet, drink and job.
    colors: Idx -> House     // yellow, green, red, white, blue
    nations: Idx -> House    // italy, spain, japan, england, norway
    pets: Idx -> House       // cat, zebra, bear, snails, horse
    drinks: Idx -> House     // milk, water, tea, coffee, juice
    jobs: Idx -> House       // painter, sculptor, diplomat, pianist, doctor
}
theory {
    // Each colour, nationality, pet, drink and job lies in one house, and
    // the five values of each attribute are in different houses, so each
    // house holds exactly one value per attribute.
    // The five colours are in different houses.
    ! i, j in Idx: i ~= j => colors(i) ~= colors(j).
    // The five nationalities are in different houses.
    ! i, j in Idx: i ~= j => nations(i) ~= nations(j).
    // The five pets are in different houses.
    ! i, j in Idx: i ~= j => pets(i) ~= pets(j).
    // The five drinks are in different houses.
    ! i, j in Idx: i ~= j => drinks(i) ~= drinks(j).
    // The five jobs are in different houses.
    ! i, j in Idx: i ~= j => jobs(i) ~= jobs(j).

    // Indices used below: yellow 0, green 1, red 2, white 3, blue 4;
    // italy 0, spain 1, japan 2, england 3, norway 4; cat 0, zebra 1, bear 2,
    // snails 3, horse 4; milk 0, water 1, tea 2, coffee 3, juice 4;
    // painter 0, sculptor 1, diplomat 2, pianist 3, doctor 4.

    // The painter owns the horse.
    jobs(0) = pets(4).
    // The diplomat drinks coffee.
    jobs(2) = drinks(3).
    // The one who drinks milk lives in the white house.
    drinks(0) = colors(3).
    // The Spaniard is a painter.
    nations(1) = jobs(0).
    // The Englishman lives in the red house.
    nations(3) = colors(2).
    // The snails are owned by the sculptor.
    pets(3) = jobs(1).
    // The green house is immediately on the left of the red one.
    colors(1) + 1 = colors(2).
    // The Norwegian lives immediately on the right of the blue house.
    nations(4) = colors(4) + 1.
    // The doctor drinks milk.
    jobs(4) = drinks(0).
    // The diplomat is Japanese.
    jobs(2) = nations(2).
    // The Norwegian owns the zebra.
    nations(4) = pets(1).
    // The green house is next to the white one.
    abs(colors(1) - colors(3)) = 1.
    // The horse is owned by the neighbour of the diplomat.
    abs(pets(4) - jobs(2)) = 1.
    // The Italian either lives in the red, white or green house.
    (nations(0) = colors(2)) | (nations(0) = colors(3)) | (nations(0) = colors(1)).
}
