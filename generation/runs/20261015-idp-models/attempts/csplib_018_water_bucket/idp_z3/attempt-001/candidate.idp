// Water bucket: pour water between buckets to reach the goal state with the fewest transfers,
// printing the state sequence padded with PADDING_VALUE after the goal is reached.
vocabulary {
    // one index per bucket, sized from the capacities array (3 buckets)
    type Bkt <: Int
    // rows of the output sequence: MAX_STEPS states, row 1 is the first (initial) state
    type Step := {1..${MAX_STEPS}}
    capacities: Bkt -> Int
    initial_state: Bkt -> Int
    goal_state: Bkt -> Int
    PADDING_VALUE: () -> Int
    // declared outputs
    sequence: Step * Bkt -> Int
    cost: () -> Int
    // objective: the number of transfers
    minimize: () -> Int
    // auxiliary symbols: the bucket poured from and the bucket poured into at each step
    source: Step -> Bkt
    target: Step -> Bkt
    amt: Step -> Int
    isGoal: Step -> Bool
    pad: Step -> Bool
    succ: Step * Step -> Bool
}
theory {
    // the first state is the initial state
    ! b in Bkt: sequence(1, b) = initial_state(b).

    // a row is padding when every bucket holds the padding value
    { ! s in Step: pad(s) <- ! b in Bkt: sequence(s, b) = PADDING_VALUE(). }

    // a row is the goal when every bucket holds its goal amount
    { ! s in Step: isGoal(s) <- ! b in Bkt: sequence(s, b) = goal_state(b). }

    // the successor relation links each row to the next one
    { ! s, t in Step: succ(s, t) <- t = s + 1. }

    // a state row holds amounts between 0 and the bucket capacity
    ! s in Step: ~pad(s) => ! b in Bkt: (0 =< sequence(s, b) & sequence(s, b) =< capacities(b)).

    // the goal is reached within the sequence
    ? s in Step: isGoal(s).

    // after the goal is reached, the remainder of the sequence is padding
    ! s, t in Step: succ(s, t) => ((isGoal(s) | pad(s)) => pad(t)).

    // a transfer takes water from one bucket and pours it into another, different bucket
    ! s in Step: source(s) ~= target(s).

    // the amount poured is the smaller of the water in the source and the free room in the target
    ! s in Step: amt(s) = if sequence(s, source(s)) =< capacities(target(s)) - sequence(s, target(s))
        then sequence(s, source(s))
        else capacities(target(s)) - sequence(s, target(s)).

    // the next state moves the poured amount from the source bucket to the target bucket
    ! s, t in Step: succ(s, t) => ! b in Bkt: ((~pad(s) & ~isGoal(s)) =>
        sequence(t, b) = sequence(s, b) - (if source(s) = b then amt(s) else 0) + (if target(s) = b then amt(s) else 0)).

    // the cost is the number of transfers, which is one less than the number of non-padding states
    cost() = #{ s in Step: ~pad(s) } - 1.
    minimize() = cost().
}
