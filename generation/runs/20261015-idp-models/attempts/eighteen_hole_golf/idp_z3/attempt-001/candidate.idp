// Eighteen-hole golf: a random course of 18 holes, each of length 3, 4 or 5, with a total length of 72.
vocabulary {
    type Hole := {0..17}             // the eighteen holes, first hole first
    type Len := {3..5}               // a hole has length 3, 4 or 5

    holes: Hole -> Len               // the length of each hole
}
theory {
    // the total length of the course is 72
    sum{{ holes(h) | h in Hole }} = 72.
}
