// Schur's lemma: put the balls 1..n into c boxes so that no triple x + y = z has all three balls in the same box.
vocabulary {
    // the balls 1..n, and the boxes 1..c, both from the instance
    type Ball := {1..${n}}
    type Box := {1..${c}}

    // balls[x] is the box holding ball x
    balls: Ball -> Box
}
theory {
    // for any triple of balls (x, y, z) with x + y = z, not all three are in the same box
    ! x in Ball, y in Ball, z in Ball: x + y = z => ~(balls(x) = balls(y) & balls(y) = balls(z)).
}
