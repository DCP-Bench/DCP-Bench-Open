// Perfect square placement: pack squares of given integer sides into a bigger square base x base, without overlap and with borders parallel to the big square.
vocabulary {
    // the squares are numbered 0..k-1, where k is the number of squares
    type Sq <: Int
    // the side length of each square
    sides: Sq -> Int
    // the side of the packing square
    base: () -> Int
    // the coordinates are 0-based positions inside the packing square
    type Coord := {0..${base}}
    // the x coordinate of the lower-left corner of each square
    x_coords: Sq -> Coord
    // the y coordinate of the lower-left corner of each square
    y_coords: Sq -> Coord
}
theory {
    // every square lies inside the big square: its right and top borders do not pass the border of the packing square
    ! s in Sq: x_coords(s) + sides(s) =< ${base}.
    ! s in Sq: y_coords(s) + sides(s) =< ${base}.

    // no two squares overlap: for every pair, one lies to the left of, right of, below or above the other
    ! s, t in Sq: s ~= t => (x_coords(s) + sides(s) =< x_coords(t) | x_coords(t) + sides(t) =< x_coords(s) | y_coords(s) + sides(s) =< y_coords(t) | y_coords(t) + sides(t) =< y_coords(s)).
}
