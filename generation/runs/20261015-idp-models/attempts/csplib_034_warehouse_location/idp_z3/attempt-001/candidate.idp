// Warehouse location: choose which warehouses to open and assign every store to one open warehouse, within warehouse capacities, minimising building costs plus supply costs.
vocabulary {
    // Warehouses (suppliers), sized from the capacity list.
    type Warehouse <: Int
    // Stores, sized from the rows of the cost matrix.
    type Store <: Int

    // Fixed cost of opening one warehouse.
    building_cost: () -> Int
    // Number of stores a warehouse can serve.
    capacity: Warehouse -> Int
    // cost_matrix(s, w): cost of supplying store s from warehouse w.
    cost_matrix: Store * Warehouse -> Int

    // open_warehouses(w): warehouse w is opened.
    open_warehouses: Warehouse -> Bool
    // supplier_assignment(s): the warehouse that supplies store s.
    supplier_assignment: Store -> Warehouse
    // total_cost: building costs plus supply costs.
    total_cost: () -> Int

    minimize: () -> Int
}
theory {
    // Every store is supplied from a warehouse that is open.
    ! s in Store: open_warehouses(supplier_assignment(s)).

    // A warehouse serves no more stores than its capacity.
    ! w in Warehouse: #{ s in Store: supplier_assignment(s) = w } =< capacity(w).

    // The total cost is the supply cost of each store plus the building cost of each open warehouse.
    total_cost() = sum{{ cost_matrix(s, supplier_assignment(s)) | s in Store }}
                   + building_cost() * #{ w in Warehouse: open_warehouses(w) }.

    // The objective is the total cost.
    minimize() = total_cost().
}
