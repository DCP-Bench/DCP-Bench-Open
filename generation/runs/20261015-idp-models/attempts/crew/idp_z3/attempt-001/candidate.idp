// Crew: assign 20 flight attendants to 10 flights so that each flight has its required crew size,
// its required stewards, hostesses and speakers of each language, and every crew member has two flights off after an attended flight.
vocabulary {
    type Person <: Int
    type Flight <: Int
    type Attr <: Int
    type Need <: Int
    attributes: Person * Attr -> Int
    required_crew: Flight * Need -> Int
    crew: Flight * Person -> Bool
}
theory {
    // Each flight needs a certain number of cabin crew.
    ! f in Flight: #{ p in Person: crew(f, p) } = required_crew(f, 0).

    // Each flight needs a certain number of stewards (attribute 0 of an attendant).
    ! f in Flight: sum{{ attributes(p, 0) | p in Person: crew(f, p) }} >= required_crew(f, 1).

    // Each flight needs a certain number of hostesses (attribute 1 of an attendant).
    ! f in Flight: sum{{ attributes(p, 1) | p in Person: crew(f, p) }} >= required_crew(f, 2).

    // Each flight needs a certain number of speakers of the first language (attribute 2 of an attendant).
    ! f in Flight: sum{{ attributes(p, 2) | p in Person: crew(f, p) }} >= required_crew(f, 3).

    // Each flight needs a certain number of speakers of the second language (attribute 3 of an attendant).
    ! f in Flight: sum{{ attributes(p, 3) | p in Person: crew(f, p) }} >= required_crew(f, 4).

    // Each flight needs a certain number of speakers of the third language (attribute 4 of an attendant).
    ! f in Flight: sum{{ attributes(p, 4) | p in Person: crew(f, p) }} >= required_crew(f, 5).

    // Every cabin crew member has two flights off after an attended flight.
    ! p in Person, f1, f2 in Flight: (f1 < f2 & f2 =< f1 + 2) => ~(crew(f1, p) & crew(f2, p)).
}
