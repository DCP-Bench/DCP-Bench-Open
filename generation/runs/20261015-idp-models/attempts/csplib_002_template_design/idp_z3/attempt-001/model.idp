// Template design: decide how many templates to print, which variations and how many copies of each go on each template, and how many sheets each template is printed.
vocabulary {
    // Templates are numbered 1..n_templates.
    type Tpl := {1..${n_templates}}
    // Variations are indexed by the demand list, sized from its length.
    type Var <: Int
    // Copies of one variation on one template, at most the slots of a mother sheet.
    type Slot := {0..${n_slots}}

    n_slots: () -> Int
    demand: Var -> Int

    layout: Tpl * Var -> Slot
    production: Tpl -> Int
    // sheets printed from template t, times the copies of variation v on it
    printed: Tpl * Var -> Int
    minimize: () -> Int
}
theory {
    // a mother sheet holds at most n_slots items
    ! t in Tpl: sum{{ layout(t, v) | v in Var }} =< n_slots().

    // a template is printed a non-negative number of times
    ! t in Tpl: production(t) >= 0.

    // the product of sheets and copies, written linearly over the finite slot range
    ! t in Tpl, v in Var: printed(t, v) = sum{{ (if layout(t, v) = k then k * production(t) else 0) | k in Slot }}.

    // every variation is printed at least its ordered quantity
    ! v in Var: sum{{ printed(t, v) | t in Tpl }} >= demand(v).

    // templates are interchangeable: order them by sheets printed
    ! t1, t2 in Tpl: t1 < t2 => production(t1) >= production(t2).

    // no template is printed more often than the total ordered quantity
    ! t in Tpl: production(t) =< sum{{ demand(v) | v in Var }}.

    // minimise the total number of printed sheets
    minimize() = sum{{ production(t) | t in Tpl }}.
}
