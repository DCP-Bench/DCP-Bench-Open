// Concert rehearsal: order the pieces so that the total time players spend waiting to play is minimal.
vocabulary {
    // pieces are numbered 0..num_pieces-1; sized from the duration array
    type Piece <: Int
    // players are numbered 0..num_players-1; sized from the rehearsal table
    type Player <: Int

    // duration of each piece
    duration: Piece -> Int
    // rehearsal[p][q] = 1 when player p takes part in piece q
    rehearsal: Player * Piece -> Int

    // declared output: rehearsal_order[s] is the piece rehearsed in slot s
    rehearsal_order: Piece -> Piece

    // plays(p, s): player p is involved in the piece rehearsed in slot s
    plays: Player * Piece -> Bool
    // early(p, s): player p plays in some slot up to and including s
    early: Player * Piece -> Bool
    // late(p, s): player p plays in some slot from s onward
    late: Player * Piece -> Bool

    // waiting time of player p during slot s
    idle: Player * Piece -> Int

    minimize: () -> Int
}
theory {
    // the rehearsal order is a permutation: every piece is rehearsed in exactly one slot
    ! s1, s2 in Piece: s1 ~= s2 => rehearsal_order(s1) ~= rehearsal_order(s2).

    // a player is involved in the piece rehearsed in slot s exactly when the instance says so
    ! p in Player, s in Piece: plays(p, s) <=> rehearsal(p, rehearsal_order(s)) = 1.

    // players arrive immediately before the first piece in which they are involved
    // and depart immediately after the last piece in which they are involved
    ! p in Player, s in Piece: early(p, s) <=> ? t in Piece: t =< s & plays(p, t).
    ! p in Player, s in Piece: late(p, s) <=> ? t in Piece: s =< t & plays(p, t).

    // the total time that players are waiting to play is the time they are present but not currently playing
    // a player is present in slot s when they have arrived (early) and not yet departed (late)
    ! p in Player, s in Piece: idle(p, s) = if early(p, s) & late(p, s) & ~plays(p, s) then duration(rehearsal_order(s)) else 0.
    minimize() = sum{{ idle(p, s) | p in Player, s in Piece }}.
}
