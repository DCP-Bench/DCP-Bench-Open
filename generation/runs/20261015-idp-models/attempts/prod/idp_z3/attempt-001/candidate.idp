// Production planning: choose how much of each product X[j] to make so that total profit is maximal within the time budget.
vocabulary {
    // one entry per product; the number of products comes from the instance
    type Product <: Int

    // time needed per unit of product j is 1 / a[j]
    a: Product -> Int
    // total time available
    b: () -> Int
    // profit per unit of product j
    c: Product -> Int
    // upper bound on the quantity of product j
    u: Product -> Int

    // a quantity is a whole number no larger than the largest upper bound
    type Qty := {0..${max(u)}}

    // quantity of product j to make
    x: Product -> Qty
    // total profit
    total_profit: () -> Int

    // time spent on product j, equal to x[j] / a[j]
    time: Product -> Real

    maximize: () -> Int
}

theory {
    // the quantity of each product is between 0 and its upper bound u[j]
    ! j in Product: x(j) =< u(j).

    // the time spent on product j is its quantity divided by a[j]
    ! j in Product: a(j) * time(j) = x(j).

    // the sum of X[j] / a[j] over all products should be less than or equal to b
    sum{{ time(j) | j in Product: true }} =< b().

    // the total profit is the sum of c[j] * X[j] over all products
    total_profit() = sum{{ (c(j) * x(j)) | j in Product: true }}.

    maximize() = total_profit().
}
