// Solitaire battleships: fill the grid with water, submarines and ship parts so that the fleet, the row and column counts and the hints all hold.
vocabulary {
    // grid rows and columns, sized from the row and column sums
    type Row <: Int
    type Col <: Int
    // fleet entries, and the (length, count) columns of a fleet entry
    type Fleet <: Int
    type FCol <: Int
    // hints, and the (row, column, code) columns of a hint
    type Hint <: Int
    type HCol <: Int

    rowsum: Row -> Int
    colsum: Col -> Int
    fleet_counts: Fleet * FCol -> Int
    hints: Hint * HCol -> Int

    // cell codes from the instance
    WATER: () -> Int
    CIRCLE: () -> Int
    LEFT: () -> Int
    RIGHT: () -> Int
    TOP: () -> Int
    BOTTOM: () -> Int
    MIDDLE: () -> Int

    // grid[r,c] is the code of cell (r,c)
    grid: Row * Col -> Int

    // auxiliary: connections between neighbouring ship parts
    hr: Row * Col -> Bool
    hl: Row * Col -> Bool
    vd: Row * Col -> Bool
    vu: Row * Col -> Bool
    // a middle part lies horizontally
    hmid: Row * Col -> Bool
    // the cell holds a ship part
    ship: Row * Col -> Bool
}
theory {
    // every cell is water, a submarine, or a ship part (left, right, top, bottom, middle)
    ! r in Row, c in Col: grid(r, c) = WATER() | grid(r, c) = CIRCLE() | grid(r, c) = LEFT() | grid(r, c) = RIGHT() | grid(r, c) = TOP() | grid(r, c) = BOTTOM() | grid(r, c) = MIDDLE().

    // a horizontal middle part has a middle orientation; only middle parts can have one
    ! r in Row, c in Col: hmid(r, c) => grid(r, c) = MIDDLE().

    // the ship part to the right of a cell, which a left or middle part connects to
    ! r in Row, c in Col: hr(r, c) <=> (grid(r, c) = LEFT() | (grid(r, c) = MIDDLE() & hmid(r, c))).
    // the ship part to the left of a cell, which a right or middle part connects to
    ! r in Row, c in Col: hl(r, c) <=> (grid(r, c) = RIGHT() | (grid(r, c) = MIDDLE() & hmid(r, c))).
    // the ship part above a cell, which a top or vertical middle part connects to
    ! r in Row, c in Col: vd(r, c) <=> (grid(r, c) = TOP() | (grid(r, c) = MIDDLE() & ~hmid(r, c))).
    // the ship part below a cell, which a bottom or vertical middle part connects to
    ! r in Row, c in Col: vu(r, c) <=> (grid(r, c) = BOTTOM() | (grid(r, c) = MIDDLE() & ~hmid(r, c))).

    // a ship part exists in the cell exactly when the cell is not water
    ! r in Row, c in Col: ship(r, c) <=> ~(grid(r, c) = WATER()).

    // a connection to the right needs a matching connection from the cell on its right, and the same for the other directions
    ! r in Row, c in Col: hr(r, c) => ? c2 in Col: c2 = c + 1 & hl(r, c2).
    ! r in Row, c in Col: hl(r, c) => ? c2 in Col: c2 = c - 1 & hr(r, c2).
    ! r in Row, c in Col: vd(r, c) => ? r2 in Row: r2 = r + 1 & vu(r2, c).
    ! r in Row, c in Col: vu(r, c) => ? r2 in Row: r2 = r - 1 & vd(r2, c).

    // ships do not touch unless they are the same ship: neighbouring ship parts are connected
    ! r in Row, c in Col, c2 in Col: (c2 = c + 1 & ship(r, c) & ship(r, c2)) => hr(r, c).
    ! r in Row, c in Col, r2 in Row: (r2 = r + 1 & ship(r, c) & ship(r2, c)) => vd(r, c).

    // no two ships are adjacent, not even diagonally
    ! r in Row, c in Col, r2 in Row, c2 in Col: ((r2 = r + 1 | r2 = r - 1) & (c2 = c + 1 | c2 = c - 1)) => ~(ship(r, c) & ship(r2, c2)).

    // the number of grid squares occupied by vessels in each row is the row sum
    ! r in Row: rowsum(r) = #{ c in Col: ship(r, c) }.

    // the number of grid squares occupied by vessels in each column is the column sum
    ! c in Col: colsum(c) = #{ r in Row: ship(r, c) }.

    // the fleet: for each ship length, the number of ships of that length is the fleet count.
    // A submarine is a single square.
    ! i in Fleet: fleet_counts(i, 0) = 1 => fleet_counts(i, 1) = #{ r in Row, c in Col: grid(r, c) = CIRCLE() }.
    // a longer ship runs from its left or top end to its right or bottom end, with middle parts between
    ! i in Fleet: fleet_counts(i, 0) ~= 1 => fleet_counts(i, 1) = #{ r in Row, c in Col, e in Col: e = c + fleet_counts(i, 0) - 1 & grid(r, c) = LEFT() & grid(r, e) = RIGHT() & (! k in Col: (c < k & k < e) => grid(r, k) = MIDDLE()) } + #{ r in Row, c in Col, e in Row: e = r + fleet_counts(i, 0) - 1 & grid(r, c) = TOP() & grid(e, c) = BOTTOM() & (! k in Row: (r < k & k < e) => grid(k, c) = MIDDLE()) }.

    // the hints fix the code of the given cells
    ! h in Hint, r in Row, c in Col: (hints(h, 0) = r & hints(h, 1) = c) => grid(r, c) = hints(h, 2).
}
