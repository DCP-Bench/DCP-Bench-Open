// 0-1 knapsack: choose a subset of items to maximise total value within a weight capacity.
vocabulary {
    type I <: Int                 // items, sized from the length of values
    capacity: () -> Int           // knapsack weight capacity
    values: I -> Int              // value of each item
    weights: I -> Int             // weight of each item
    x: I -> Bool                  // x(i) is true when item i is packed
    maximize: () -> Int           // total value of packed items
}
theory {
    // The total weight of the packed items must not exceed the capacity.
    sum{{ weights(i) | i in I: x(i) }} =< capacity().

    // The objective is the total value of the packed items.
    maximize() = sum{{ values(i) | i in I: x(i) }}.
}
