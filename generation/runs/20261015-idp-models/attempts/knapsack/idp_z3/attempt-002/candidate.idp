// 0-1 knapsack: choose items to maximize total value without exceeding the weight capacity
vocabulary {
    type I <: Int                  // the items, one index per item
    capacity: () -> Int
    values: I -> Int
    weights: I -> Int
    x: I -> Bool                   // x(i) = true if item i is in the backpack
    maximize: () -> Int
}
theory {
    // the total weight of the chosen items must not exceed the capacity
    sum{{ weights(i) | i in I: x(i) }} =< capacity().

    // the objective is the total value of the chosen items
    maximize() = sum{{ values(i) | i in I: x(i) }}.
}
