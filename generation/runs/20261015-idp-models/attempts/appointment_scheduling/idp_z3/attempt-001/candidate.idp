// Appointment scheduling: assign 4 people to 4 interview slots, using their free-busy schedules.
// m[p][s] = 1 when person p is free in slot s.

vocabulary {
    // People and slots, sized from the instance matrix m (rows are people, columns are slots).
    type P <: Int
    type S <: Int

    // Instance data: free-busy schedule.
    m: P * S -> Int

    // Declared output: x[p][s] is true when person p is assigned to slot s.
    x: P * S -> Bool
}

theory {
    // each person is assigned to exactly one slot
    ! p in P: ?=1 s in S: x(p, s).

    // each slot holds exactly one person
    ! s in S: ?=1 p in P: x(p, s).

    // a person is only assigned to a slot in which they are free
    ! p in P, s in S: x(p, s) => m(p, s) = 1.
}
