// Quasigroup completion: fill an N x N grid with symbols 1..N so that every row and every column holds each symbol exactly once, keeping the given cells.
vocabulary {
    type Row <: Int                 // grid rows, sized from the start grid
    type Col <: Int                 // grid columns, sized from the start grid
    type Val := {1..${N}}           // the N symbols, N from the instance
    start: Row * Col -> Int         // given cells, 0 marks an empty cell
    puzzle: Row * Col -> Val        // the completed grid
}
theory {
    // A given cell keeps its symbol.
    ! r in Row, c in Col: start(r, c) ~= 0 => puzzle(r, c) = start(r, c).

    // Each row contains every symbol exactly once.
    ! r in Row, v in Val: ?=1 c in Col: puzzle(r, c) = v.

    // Each column contains every symbol exactly once.
    ! c in Col, v in Val: ?=1 r in Row: puzzle(r, c) = v.
}
