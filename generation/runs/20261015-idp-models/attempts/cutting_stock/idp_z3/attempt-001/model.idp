// Cutting stock: choose how many times to use each cutting pattern so that every width
// is cut at least as often as ordered, minimising the total number of raw rolls cut.
vocabulary {
    // index types, sized from the instance data (number of patterns and widths)
    type Pattern <: Int
    type Width <: Int

    // number of pieces of each width that one roll cut by pattern p yields
    num_rolls_width: Pattern * Width -> Int
    // number of rolls ordered for each width
    orders: Width -> Int

    // a pattern is never used more often than the total number of ordered pieces
    type Count := {0..${sum(orders)}}

    // declared outputs
    patterns_used: Pattern -> Count
    min_rolls_cut: () -> Count

    // objective
    minimize: () -> Int
}

theory {
    // for each width, the total number of rolls cut meets the total orders
    ! w in Width: sum{{ (num_rolls_width(p, w) * patterns_used(p)) | p in Pattern }} >= orders(w).

    // the number of raw rolls cut is the number of times the patterns are used
    min_rolls_cut() = sum{{ patterns_used(p) | p in Pattern }}.

    // minimise the total number of raw rolls cut
    minimize() = min_rolls_cut().
}
