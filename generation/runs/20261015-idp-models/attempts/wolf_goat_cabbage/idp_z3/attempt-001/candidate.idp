// Wolf, goat and cabbage river crossing: a farmer ferries a wolf, a goat and a cabbage
// across a river, one item at a time, without the wolf eating the goat or the goat eating the cabbage.
// Each output gives, per stage, whether an item is on the destination shore (true) or the starting shore (false).
vocabulary {
    // Stages 0 .. stage-1 of the crossing, taken from the instance field stage.
    type Stage := {0..${stage-1}}
    // Transitions between consecutive stages.
    type Step := {0..${stage-2}}
    wolf_pos: Stage -> Bool
    goat_pos: Stage -> Bool
    cabbage_pos: Stage -> Bool
    boat_pos: Stage -> Bool
}
theory {
    // Everything starts on the starting shore.
    ~wolf_pos(0).
    ~goat_pos(0).
    ~cabbage_pos(0).
    ~boat_pos(0).

    // Everything ends on the destination shore.
    wolf_pos(${stage-1}).
    goat_pos(${stage-1}).
    cabbage_pos(${stage-1}).
    boat_pos(${stage-1}).

    // The boat crosses the river at every stage.
    ! t in Step: boat_pos(t+1) ~= boat_pos(t).

    // The boat carries the farmer and at most a single item.
    // An item crosses only when it is on the boat's shore.
    ! t in Step: wolf_pos(t+1) ~= wolf_pos(t) => wolf_pos(t) = boat_pos(t).
    ! t in Step: goat_pos(t+1) ~= goat_pos(t) => goat_pos(t) = boat_pos(t).
    ! t in Step: cabbage_pos(t+1) ~= cabbage_pos(t) => cabbage_pos(t) = boat_pos(t).

    // At most one item crosses at each stage.
    ! t in Step: wolf_pos(t+1) ~= wolf_pos(t) => (goat_pos(t+1) = goat_pos(t) & cabbage_pos(t+1) = cabbage_pos(t)).
    ! t in Step: goat_pos(t+1) ~= goat_pos(t) => (wolf_pos(t+1) = wolf_pos(t) & cabbage_pos(t+1) = cabbage_pos(t)).
    ! t in Step: cabbage_pos(t+1) ~= cabbage_pos(t) => (wolf_pos(t+1) = wolf_pos(t) & goat_pos(t+1) = goat_pos(t)).

    // The wolf would eat the goat if they are left alone together on a shore without the farmer.
    ! t in Stage: wolf_pos(t) = goat_pos(t) => boat_pos(t) = goat_pos(t).

    // The goat would eat the cabbage if they are left alone together on a shore without the farmer.
    ! t in Stage: goat_pos(t) = cabbage_pos(t) => boat_pos(t) = goat_pos(t).
}
