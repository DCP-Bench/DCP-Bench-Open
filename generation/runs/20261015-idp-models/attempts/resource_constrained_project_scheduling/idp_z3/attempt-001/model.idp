// Resource-constrained project scheduling: start times of the jobs that minimize the makespan
// while respecting the precedence constraints and the resource capacities.
vocabulary {
    // jobs, numbered from 0; the number of jobs is the length of durations_data
    type Job <: Int
    // resource types; the number of resources is the length of resource_capacities_data
    type Res <: Int
    // precedence links, one row of successors_link_data each
    type Edge <: Int
    // the two columns of a link: the predecessor (0) and the successor (1)
    type Col := {0..1}
    // start times: a schedule never ends later than the sum of all durations
    type Time := {0..${sum(durations_data)}}

    // instance data
    durations_data: Job -> Int
    resource_capacities_data: Res -> Int
    resource_needs_data: Job * Res -> Int
    successors_link_data: Edge * Col -> Job

    // declared output: start time of each job
    start_time: Job -> Time
    // the makespan, minimized
    minimize: () -> Int
}
theory {
    // the makespan is the latest finishing time of any job
    minimize() = max{ (start_time(j) + durations_data(j)) | j in Job: true }.

    // each job starts only after all its predecessors have finished
    ! e in Edge: start_time(successors_link_data(e, 1)) >= start_time(successors_link_data(e, 0)) + durations_data(successors_link_data(e, 0)).

    // at every time point, the jobs running on a resource use at most its capacity
    ! r in Res, t in Time: sum{{ resource_needs_data(j, r) | j in Job: start_time(j) =< t & t < start_time(j) + durations_data(j) }} =< resource_capacities_data(r).
}
