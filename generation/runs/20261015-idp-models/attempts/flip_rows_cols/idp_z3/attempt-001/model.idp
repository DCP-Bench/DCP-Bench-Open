// Flip the signs of rows and columns of an integer matrix so that every row and
// every column sums to a positive value (or zero), minimising the overall sum.
vocabulary {
    type Row <: Int                     // row indices, sized from the input matrix
    type Col <: Int                     // column indices, sized from the input matrix
    input_matrix: Row * Col -> Int      // the array of positive and negative numbers
    type Sign := {-1, 1}
    row_signs: Row -> Sign              // declared output: sign of each row
    col_signs: Col -> Sign              // declared output: sign of each column
    rneg: Row -> Bool                   // row r is flipped
    cneg: Col -> Bool                   // column c is flipped
    fv: Row * Col -> Int                // entry after the flips
    minimize: () -> Int
}
theory {
    // the printed signs follow from the flip choices
    ! r in Row: row_signs(r) = if rneg(r) then -1 else 1.
    ! c in Col: col_signs(c) = if cneg(c) then -1 else 1.

    // an entry flips sign when exactly one of its row and column is flipped
    ! r in Row, c in Col: fv(r,c) = if rneg(r) = cneg(c) then input_matrix(r,c) else 0 - input_matrix(r,c).

    // all the rows sum to positive numbers (or zero)
    ! r in Row: sum{{ fv(r,c) | c in Col }} >= 0.

    // all the columns sum to positive numbers (or zero)
    ! c in Col: sum{{ fv(r,c) | r in Row }} >= 0.

    // the overall sum of the matrix is the objective to minimise
    minimize() = sum{{ fv(r,c) | r in Row, c in Col }}.
}
