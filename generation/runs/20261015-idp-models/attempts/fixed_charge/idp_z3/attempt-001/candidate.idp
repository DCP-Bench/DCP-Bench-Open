// Fixed charge: a company makes shirts, shorts and pants. Each product needs labor and cloth,
// the company has a limited capacity of both, and each product can only be made by renting its machine.
// Maximize the profit (excluding renting cost) minus the renting cost of the machines used.
vocabulary {
    // index types, sized from the instance data
    type P <: Int
    type M <: Int
    type R <: Int
    type C <: Int
    // production quantity of a product, from 0 up to the maximum production
    type Q := {0..${max_production}}

    // use[p, r]: amount of resource r (labor, cloth) needed per unit of product p
    use: P * R -> Int
    // product[p, 0]: profit per unit of product p; product[p, 1]: machine that product p needs
    product: P * C -> Int
    // capacity of each resource
    capacity: R -> Int
    // renting cost of each machine
    renting_cost: M -> Int

    // number of units made of each product
    x: P -> Q
    // machine m is rented
    rent: M -> Bool
    // total profit minus renting cost
    z: () -> Int

    maximize: () -> Int
}
theory {
    // the labor and cloth hours used by the products made may not exceed the capacity of each
    ! r in R: sum{{ (use(p, r) * x(p)) | p in P }} =< capacity(r).

    // a product can only be made if the machine it needs is rented
    ! p in P, m in M: product(p, 1) = m & x(p) ~= 0 => rent(m).

    // z is the profit on the products made, minus the renting cost of the machines rented
    z() = sum{{ (product(p, 0) * x(p)) | p in P }} - sum{{ renting_cost(m) | m in M: rent(m) }}.

    // maximize the total profit
    maximize() = z().
}
