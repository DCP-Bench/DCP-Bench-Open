// Split a sorted list of N elements into K groups of consecutive elements, as close to round(N/K) elements each as possible.
vocabulary {
    type Pos := {0..${len(a)-1}}      // positions of the sorted list
    type Adj := {0..${len(a)-2}}      // positions that have a next neighbour
    type Grp := {0..${k-1}}           // the K groups
    type Brk := {0..${k-2}}           // the K-1 break points
    type Cut := {1..${len(a)-1}}      // a break point is a count of elements in 1..N-1

    a: Pos -> Int                     // the sorted elements
    k: () -> Int                      // number of groups

    group: Pos -> Grp                 // group of each element
    size: Grp -> Int                  // number of elements in each group

    x: Brk -> Cut                     // declared output: break points (the count up to and including the break)
    minimize: () -> Int
}
theory {
    // The list is sorted, so the groups are consecutive runs: an earlier element never goes to a later group.
    ! p in Adj: group(p) =< group(p + 1).

    // Elements with the same value must be in the same group.
    ! p in Adj: a(p) = a(p + 1) => group(p) = group(p + 1).

    // Divide them into K groups: every group holds at least one element.
    ! j in Grp: ? p in Pos: group(p) = j.

    // The size of each group.
    ! j in Grp: size(j) = #{ p in Pos: group(p) = j }.

    // The break points: the number of elements in groups 0 up to j.
    ! j in Brk: x(j) = #{ p in Pos: group(p) =< j }.

    // Minimize the total deviation of the group sizes from round(N/K), with round(N/K) = ${(2*len(a)+k)//(2*k)} (rounding halves up, computed from the instance).
    minimize() = sum{{ (abs(size(j) - ${(2*len(a)+k)//(2*k)})) | j in Grp }}.
}
