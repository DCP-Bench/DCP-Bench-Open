// Dinner: how many grandparents, parents and children go to dinner so that 20 people cost $20.
vocabulary {
    type GP := {1..6}              // 1-6 grandparents (problem statement)
    type PA := {1..10}             // 1-10 parents (problem statement)
    type CH := {1..40}             // 1-40 children (problem statement)
    grandparents: () -> GP         // declared output
    parents: () -> PA              // declared output
    children: () -> CH             // declared output
}
theory {
    // there must be 20 total people at dinner
    grandparents() + parents() + children() = 20.

    // grandparents cost $3, parents $2 and children $0.50, and the dinner must cost $20
    // (costs are written in cents to keep the arithmetic integer)
    300 * grandparents() + 200 * parents() + 50 * children() = 2000.
}
