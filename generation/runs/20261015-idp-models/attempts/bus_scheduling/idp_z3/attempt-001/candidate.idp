// Bus scheduling: minimise the number of buses so that every 4-hour slot
// has enough buses on the road. Each bus runs 8 successive hours (two slots),
// and the day wraps around, so the last slot hands over to the first.
vocabulary {
    type I <: Int                  // time slots, sized from demands
    demands: I -> Int              // demand for buses in each slot
    x: I -> Int                    // declared output: buses starting in each slot
    minimize: () -> Int
    z: () -> Int
}
theory {
    // no negative number of buses starts in a slot
    ! i in I: x(i) >= 0.

    // the buses on the road in slot i are those starting in slot i and those
    // starting in the previous slot (wrapping from the first slot to the last),
    // and that count must meet the demand of slot i
    ! i, j in I: ((i = j + 1 | (i = 0 & ~(? k in I: k = j + 1))) => x(i) + x(j) >= demands(i)).

    // total number of buses
    z() = sum{{ x(i) | i in I }}.
    minimize() = z().
}
