// Tommy's 15 coins (half-crowns, shillings and sixpences) add up to 306 pence,
// that is one pound, five shillings and sixpence. How many half-crowns?
// Money is counted in pence: a half-crown is 30 pence, a shilling 12 pence,
// a sixpence 6 pence, and the 15 coins and 306 pence are from the problem statement.
vocabulary {
    type Count := {0..15}           // number of coins of one kind, at most the 15 coins
    half_crowns: () -> Count        // declared output: number of half-crowns
    shillings: () -> Count          // number of shillings
    sixpences: () -> Count          // number of sixpences
}
theory {
    // he was given 15 coins in total
    half_crowns() + shillings() + sixpences() = 15.
    // the coins add up to 306 pence
    30 * half_crowns() + 12 * shillings() + 6 * sixpences() = 306.
    // he was given coins of all three kinds
    half_crowns() >= 1.
    shillings() >= 1.
    sixpences() >= 1.
}
