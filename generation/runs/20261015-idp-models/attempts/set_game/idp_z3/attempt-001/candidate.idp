// Set card game: find three cards from the table that form a set.
vocabulary {
    // a card is one of the cards on the table, indexed from 0 (sized from the data)
    type Card <: Int
    // a feature of a card: number, fill, color, shape (sized from the data)
    type Feat <: Int
    // the three positions of the winning set
    type Slot := {1..3}

    // the value of each feature of each card
    cards_data: Card * Feat -> Int
    // indices of the three cards that form a set
    winning_cards: Slot -> Card
}

theory {
    // the three cards of the set are three different cards
    ! s, t in Slot: s ~= t => winning_cards(s) ~= winning_cards(t).

    // for each feature the three cards are all the same or all different
    ! f in Feat:
        (cards_data(winning_cards(1), f) = cards_data(winning_cards(2), f)
            & cards_data(winning_cards(2), f) = cards_data(winning_cards(3), f))
        | (cards_data(winning_cards(1), f) ~= cards_data(winning_cards(2), f)
            & cards_data(winning_cards(2), f) ~= cards_data(winning_cards(3), f)
            & cards_data(winning_cards(1), f) ~= cards_data(winning_cards(3), f)).
}
