// Hanging weights: weights A-M hang from a system of bars and must balance as in the diagram.
vocabulary {
    a: () -> Int
    b: () -> Int
    c: () -> Int
    d: () -> Int
    e: () -> Int
    f: () -> Int
    g: () -> Int
    h: () -> Int
    i: () -> Int
    j: () -> Int
    k: () -> Int
    l: () -> Int
    m: () -> Int
    // total weight of the bars hanging below each bar
    tAB: () -> Int
    tCD: () -> Int
    tG: () -> Int
    tQ: () -> Int
    tP: () -> Int
    tX: () -> Int
    tY: () -> Int
}
theory {
    // Each weight has an integer value between 1 and 13.
    1 =< a() & a() =< 13.
    1 =< b() & b() =< 13.
    1 =< c() & c() =< 13.
    1 =< d() & d() =< 13.
    1 =< e() & e() =< 13.
    1 =< f() & f() =< 13.
    1 =< g() & g() =< 13.
    1 =< h() & h() =< 13.
    1 =< i() & i() =< 13.
    1 =< j() & j() =< 13.
    1 =< k() & k() =< 13.
    1 =< l() & l() =< 13.
    1 =< m() & m() =< 13.

    // a bar hanging beneath another contributes its total weight as though it were a single weight
    tAB() = a() + b().
    tCD() = c() + d().
    tG() = g() + tCD().
    tQ() = e() + f().
    tP() = h() + i() + tQ().
    tX() = tP() + l() + m().
    tY() = tAB() + j() + k() + tG().

    // the weights on either side of the top pivot must be equal, weighted by distance: 4 * X = 3 * Y
    4 * tX() = 3 * tY().

    // the left bar under the top bar: P at distance 1 balances L at distance 1 and M at distance 4
    tP() = l() + 4 * m().

    // the bar holding H and I, with the bar Q (E and F) at distance 2: 3*H = 3*I + 2*Q
    3 * h() = 3 * i() + 2 * tQ().

    // the bar holding E and F: 3*E = 2*F
    3 * e() = 2 * f().

    // the bar holding A and B: 4*A = B
    4 * a() = b().

    // the bar holding J, K, the A-B bar and the G bar: 3*(A+B) + 2*J = K + 2*G
    3 * tAB() + 2 * j() = k() + 2 * tG().

    // the bar holding G and the bar C+D: 3*G = 2*(C+D)
    3 * g() = 2 * tCD().

    // the bottom right bar must have 5*C = D
    5 * c() = d().
}
