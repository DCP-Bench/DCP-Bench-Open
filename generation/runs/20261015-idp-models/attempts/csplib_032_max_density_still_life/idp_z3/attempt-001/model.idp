// Max-density still life: place live cells on an n x m grid (cells outside are dead) so the pattern is stable and has as many live cells as possible
vocabulary {
    type Row := {1..${n}}
    type Col := {1..${m}}
    n: () -> Int
    m: () -> Int
    grid: Row * Col -> Bool
    nb: Row * Col -> Int
    maximize: () -> Int
}
theory {
    // the number of live neighbours of a cell in the active grid (cells outside the grid are dead)
    ! i in Row, j in Col: nb(i,j) = #{ p in Row, q in Col: abs(p - i) =< 1 & abs(q - j) =< 1 & ~(p = i & q = j) & grid(p,q) }.

    // a live cell must have exactly 2 or 3 live neighbours to remain alive
    ! i in Row, j in Col: grid(i,j) => (2 =< nb(i,j) & nb(i,j) =< 3).

    // a dead cell in the active grid must not have exactly 3 live neighbours
    ! i in Row, j in Col: ~grid(i,j) => nb(i,j) ~= 3.

    // a dead cell just above the grid (row 0) must not have exactly 3 live neighbours
    ! j in Col: #{ p in Row, q in Col: p =< 1 & abs(q - j) =< 1 & grid(p,q) } ~= 3.

    // a dead cell just below the grid (row n+1) must not have exactly 3 live neighbours
    ! j in Col: #{ p in Row, q in Col: n() =< p & abs(q - j) =< 1 & grid(p,q) } ~= 3.

    // a dead cell just left of the grid (column 0) must not have exactly 3 live neighbours
    ! i in Row: #{ p in Row, q in Col: abs(p - i) =< 1 & q =< 1 & grid(p,q) } ~= 3.

    // a dead cell just right of the grid (column m+1) must not have exactly 3 live neighbours
    ! i in Row: #{ p in Row, q in Col: abs(p - i) =< 1 & m() =< q & grid(p,q) } ~= 3.

    // maximize the number of live cells in the active grid
    maximize() = #{ i in Row, j in Col: grid(i,j) }.
}
