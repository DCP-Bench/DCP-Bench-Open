// Rectangular packing: place all rectangles in a larger rectangle without overlap, minimising the area of the larger rectangle.
vocabulary {
    // one item per rectangle; the number of items comes from the instance
    type Item <: Int
    widths: Item -> Int
    heights: Item -> Int

    // coordinates and side lengths of the enclosing rectangle lie between 0 and the sum of all widths
    type Coord := {0..${sum(widths)}}

    // lower-left corner of each item
    pos_x: Item -> Coord
    pos_y: Item -> Coord

    // dimensions of the larger rectangle
    total_x: () -> Coord
    total_y: () -> Coord

    minimize: () -> Int
}

theory {
    // every item lies within the boundaries of the larger rectangle
    ! i in Item: pos_x(i) + widths(i) =< total_x().
    ! i in Item: pos_y(i) + heights(i) =< total_y().

    // no two items overlap: for each pair, one lies left of, right of, below or above the other
    ! i, j in Item: i < j => ((pos_x(i) + widths(i) =< pos_x(j)) | (pos_x(j) + widths(j) =< pos_x(i)) | (pos_y(i) + heights(i) =< pos_y(j)) | (pos_y(j) + heights(j) =< pos_y(i))).

    // the objective is the area of the larger rectangle
    minimize() = total_x() * total_y().
}
