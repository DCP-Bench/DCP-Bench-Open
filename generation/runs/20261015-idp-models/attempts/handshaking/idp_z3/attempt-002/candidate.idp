// Handshaking: Hilary and Jocelyn are married; the other couples are friends invited to dinner.
// Each person is one of the 2n people; couple k is the pair of persons 2k-1 and 2k.
vocabulary {
    type Couple := {1..${num_couples}}
    type Person := {1..${2*num_couples}}
    type Hand := {0..${2*num_couples-2}}
    // spouse(p, q): p and q are married
    spouse: Person * Person -> Bool
    // shake(p, q): p and q shake hands
    shake: Person * Person -> Bool
    // hand(p): how many hands person p has shaken
    hand: Person -> Hand
    // Hilary is person 1 and Jocelyn is person 2
    hil: () -> Hand
}
theory {
    // the spouses are the two persons of one couple
    { ! p, q in Person: spouse(p, q) <- ? k in Couple: (p = 2*k-1 & q = 2*k) | (p = 2*k & q = 2*k-1). }

    // nobody shakes hands with him or herself or with his or her spouse
    ! p, q in Person: shake(p, q) => ~spouse(p, q) & p ~= q.
    // handshakes are mutual
    ! p, q in Person: shake(p, q) <=> shake(q, p).

    // hand counts the people each person has shaken hands with
    ! p in Person: hand(p) = #{ q in Person: shake(p, q) }.

    // all the answers are different: every person except Jocelyn has a different hand count
    ! p, q in Person: (p ~= 2 & q ~= 2 & p ~= q) => hand(p) ~= hand(q).

    // two people other than Jocelyn whose answers add up to the largest answer are spouses
    ! p, q in Person: (p ~= 2 & q ~= 2 & p ~= q) & hand(p) + hand(q) = ${2*num_couples-2} => spouse(p, q).
    // Hilary's answer
    hil() = hand(1).
}
