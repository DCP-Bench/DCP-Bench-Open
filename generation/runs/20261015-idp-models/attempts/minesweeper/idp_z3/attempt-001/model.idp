// Minesweeper: decide, from the numbers shown on the board, which cells hold a mine.
vocabulary {
    type Row <: Int
    type Col <: Int
    X: () -> Int                          // marks a cell that is not open yet
    game_data: Row * Col -> Int           // the board: a number for an open cell, X otherwise
    mines: Row * Col -> Bool              // declared output: True where a cell is a mine
}
theory {
    // A cell whose number is shown is open, so it is not a mine.
    ! r in Row, c in Col: game_data(r, c) ~= X() => ~mines(r, c).
    // The number on a cell shows the number of mines adjacent to it.
    ! r in Row, c in Col: game_data(r, c) ~= X() => #{ r2 in Row, c2 in Col: ~(r2 = r & c2 = c) & abs(r2 - r) =< 1 & abs(c2 - c) =< 1 & mines(r2, c2) } = game_data(r, c).
}
