// Contracting costs: a house has six tradesmen (paper hanger, painter, plumber, electrician, carpenter, mason),
// each charging a price for his service, and six pairwise costs are known.
vocabulary {
    paper_hanger: () -> Int
    painter: () -> Int
    plumber: () -> Int
    electrician: () -> Int
    carpenter: () -> Int
    mason: () -> Int
}
theory {
    // The contractor pays $1,100 to the paper hanger and the painter.
    paper_hanger() + painter() = 1100.

    // The contractor pays $1,700 to the painter and the plumber.
    painter() + plumber() = 1700.

    // The contractor pays $1,100 to the plumber and the electrician.
    plumber() + electrician() = 1100.

    // The contractor pays $3,300 to the electrician and the carpenter.
    electrician() + carpenter() = 3300.

    // The contractor pays $5,300 to the carpenter and the mason.
    carpenter() + mason() = 5300.

    // The contractor pays $3,200 to the mason and the painter.
    mason() + painter() = 3200.
}
