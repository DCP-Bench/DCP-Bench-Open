// Curious set of integers: find a fifth number x >= 0 that can be added to {1, 3, 8, 120}
// so that the product of any two members of the set is one less than a perfect square.
vocabulary {
    // square roots that can witness a perfect square up to 120 * max_val + 1; the largest
    // needed root is about 11 * sqrt(max_val), which max_val // 9 + 1 covers for max_val = 10000
    type Root := {0..${max_val // 9 + 1}}
    number: () -> Int
}
theory {
    // the fifth number is at least 0 and at most max_val
    0 =< number() & number() =< ${max_val}.
    // the product of 1 and the new number, plus one, is a perfect square
    ? r in Root: r * r = number() + 1.
    // the product of 3 and the new number, plus one, is a perfect square
    ? r in Root: r * r = 3 * number() + 1.
    // the product of 8 and the new number, plus one, is a perfect square
    ? r in Root: r * r = 8 * number() + 1.
    // the product of 120 and the new number, plus one, is a perfect square
    ? r in Root: r * r = 120 * number() + 1.
}
