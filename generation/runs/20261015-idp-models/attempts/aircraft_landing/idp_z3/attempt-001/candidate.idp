// Aircraft landing: fix the landing time of each aircraft on one runway, minimizing the total penalty
// for landing before or after the target time, with the separation times between landings respected.
vocabulary {
    // the aircraft, in the fixed landing sequence, sized from the data
    type Plane <: Int
    // the time window of each aircraft
    earliest_landing: Plane -> Int
    latest_landing: Plane -> Int
    // the target landing time of each aircraft
    target_landing: Plane -> Int
    // the penalty per unit of time for landing before or after the target
    penalty_before: Plane -> Int
    penalty_after: Plane -> Int
    // the minimum separation between the landing of plane i and the later plane j
    separation_time: Plane * Plane -> Int
    // the landing time of each aircraft
    landing_times: Plane -> Int
    // the total penalty of all aircraft
    total_penalty: () -> Int
    minimize: () -> Int
}
theory {
    // Each aircraft lands within its time window.
    ! p in Plane: landing_times(p) >= earliest_landing(p) & landing_times(p) =< latest_landing(p).

    // Consecutive landings in the fixed sequence respect the minimum separation time.
    ! i, j in Plane: i < j => landing_times(j) >= landing_times(i) + separation_time(i, j).

    // The penalty of each aircraft is the cost of landing before or after its target time.
    total_penalty() = sum{{ (if landing_times(p) < target_landing(p) then penalty_before(p) * (target_landing(p) - landing_times(p)) else penalty_after(p) * (landing_times(p) - target_landing(p))) | p in Plane }}.

    // The objective is the total penalty.
    minimize() = total_penalty().
}
