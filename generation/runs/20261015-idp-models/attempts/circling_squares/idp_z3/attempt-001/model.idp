// Circling the squares: fill ten squares arranged in a circle (A B C D E F G H I K, in order) with different whole numbers.
vocabulary {
    // a number in a square: a whole number of at most two figures (0 to 99)
    type Num := {0..99}
    // the square of a number
    sq: Num -> Int
    A: () -> Num
    B: () -> Num
    C: () -> Num
    D: () -> Num
    E: () -> Num
    F: () -> Num
    G: () -> Num
    H: () -> Num
    I: () -> Num
    K: () -> Num
}
theory {
    // the square of each number
    ! n in Num: sq(n) = n * n.

    // the four numbers given in the puzzle stand as they are: A=16, B=2, F=8, G=14
    A() = 16.
    B() = 2.
    F() = 8.
    G() = 14.

    // place a different number in each of the ten squares
    A() ~= B().
    A() ~= C().
    A() ~= D().
    A() ~= E().
    A() ~= F().
    A() ~= G().
    A() ~= H().
    A() ~= I().
    A() ~= K().
    B() ~= C().
    B() ~= D().
    B() ~= E().
    B() ~= F().
    B() ~= G().
    B() ~= H().
    B() ~= I().
    B() ~= K().
    C() ~= D().
    C() ~= E().
    C() ~= F().
    C() ~= G().
    C() ~= H().
    C() ~= I().
    C() ~= K().
    D() ~= E().
    D() ~= F().
    D() ~= G().
    D() ~= H().
    D() ~= I().
    D() ~= K().
    E() ~= F().
    E() ~= G().
    E() ~= H().
    E() ~= I().
    E() ~= K().
    F() ~= G().
    F() ~= H().
    F() ~= I().
    F() ~= K().
    G() ~= H().
    G() ~= I().
    G() ~= K().
    H() ~= I().
    H() ~= K().
    I() ~= K().
    A() ~= B().
    A() ~= C().
    A() ~= D().
    A() ~= E().
    A() ~= F().
    A() ~= G().
    A() ~= H().
    A() ~= I().
    B() ~= C().
    B() ~= D().
    B() ~= E().
    B() ~= F().
    B() ~= G().
    B() ~= H().
    B() ~= I().
    C() ~= D().
    C() ~= E().
    C() ~= F().
    C() ~= G().
    C() ~= H().
    C() ~= I().
    D() ~= E().
    D() ~= F().
    D() ~= G().
    D() ~= H().
    D() ~= I().
    E() ~= F().
    E() ~= G().
    E() ~= H().
    E() ~= I().
    F() ~= G().
    F() ~= H().
    F() ~= I().
    G() ~= H().
    G() ~= I().
    H() ~= I().

    // the sum of the squares of any two adjacent numbers is equal to the sum of the squares of the two numbers diametrically opposite them
    // opposite pairs: A-F, B-G, C-H, D-I, E-K
    // adjacent A and B are opposite F and G
    sq(A()) + sq(B()) = sq(F()) + sq(G()).
    // adjacent B and C are opposite G and H
    sq(B()) + sq(C()) = sq(G()) + sq(H()).
    // adjacent C and D are opposite H and I
    sq(C()) + sq(D()) = sq(H()) + sq(I()).
    // adjacent D and E are opposite I and K
    sq(D()) + sq(E()) = sq(I()) + sq(K()).
    // adjacent E and F are opposite K and A
    sq(E()) + sq(F()) = sq(K()) + sq(A()).
    // adjacent F and G are opposite A and B
    sq(F()) + sq(G()) = sq(A()) + sq(B()).
    // adjacent G and H are opposite B and C
    sq(G()) + sq(H()) = sq(B()) + sq(C()).
    // adjacent H and I are opposite C and D
    sq(H()) + sq(I()) = sq(C()) + sq(D()).
    // adjacent I and K are opposite D and E
    sq(I()) + sq(K()) = sq(D()) + sq(E()).
    // adjacent K and A are opposite E and F
    sq(K()) + sq(A()) = sq(E()) + sq(F()).
}
