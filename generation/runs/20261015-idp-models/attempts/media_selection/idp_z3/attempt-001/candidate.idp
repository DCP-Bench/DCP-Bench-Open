// Media selection: choose advertising media so that all audiences are reached with minimum campaign cost.
vocabulary {
    type Audience <: Int                    // audiences, sized from the instance data
    type Media <: Int                       // advertising media, sized from the instance data
    incidence_matrix: Audience * Media -> Int   // 1 if the medium reaches the audience
    media_costs: Media -> Int               // cost of each medium

    is_selected: Media -> Bool              // the decision: whether each medium is selected
    min_total_cost: () -> Int               // total cost of the selected media
    minimize: () -> Int                     // objective, equal to the total cost
}
theory {
    // every audience is reached by at least one selected medium
    ! a in Audience: ? m in Media: is_selected(m) & (incidence_matrix(a, m) = 1).

    // the total cost is the sum of the costs of the selected media
    min_total_cost() = sum{{ media_costs(m) | m in Media: is_selected(m) }}.

    // the campaign cost is minimized
    minimize() = min_total_cost().
}
