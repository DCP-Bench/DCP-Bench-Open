// Hidato: fill the empty cells (0) of the square grid with the numbers
// so that consecutive numbers touch horizontally, vertically or diagonally.
vocabulary {
    type I <: Int
    puzzle: I * I -> Int
    x: I * I -> Int
    total: () -> Int
}
theory {
    // the numbers are 1 to N, where N is the number of cells of the grid
    total() = #{ a, b in I: a = a }.
    ! r, c in I: 1 =< x(r, c) & x(r, c) =< total().

    // every cell holds a different number, so every number is used once
    ! r1, c1, r2, c2 in I: (r1 ~= r2 | c1 ~= c2) => x(r1, c1) ~= x(r2, c2).

    // the numbers already given in the puzzle stay where they are
    ! r, c in I: puzzle(r, c) ~= 0 => x(r, c) = puzzle(r, c).

    // each number except N touches the next number
    ! r, c in I: x(r, c) ~= total() => ? r2, c2 in I: x(r2, c2) = x(r, c) + 1 & abs(r - r2) =< 1 & abs(c - c2) =< 1.
}
