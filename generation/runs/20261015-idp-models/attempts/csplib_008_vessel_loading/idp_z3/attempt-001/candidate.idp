// Vessel loading: place rectangular containers on a rectangular deck without overlap and respecting the minimum separations between container classes.
vocabulary {
    // the containers are numbered 0..n-1, where n is the number of containers
    type Box <: Int
    // the container classes are numbered 0..k-1 in the separation table (class c is row c-1 of the table)
    type Cls <: Int
    // the deck width (along the x axis) and length (along the y axis)
    deck_width: () -> Int
    deck_length: () -> Int
    // the width and length of each container, before any rotation
    width: Box -> Int
    length: Box -> Int
    // the class of each container, numbered from 1
    classes: Box -> Int
    // the minimum distance between containers of two classes, indexed from 0
    separation: Cls * Cls -> Int
    // the positions of the containers on the deck
    type X := {0..${deck_width}}
    type Y := {0..${deck_length}}
    left: Box -> X
    right: Box -> X
    top: Box -> Y
    bottom: Box -> Y
    // whether a container is turned by 90 degrees
    rotated: Box -> Bool
    // the extent of a container along the deck width and along the deck length
    extent_x: Box -> Int
    extent_y: Box -> Int
    // the minimum distance required between two containers, read from the separation table
    min_sep: Box * Box -> Int
}
theory {
    // a container turned by 90 degrees has its width and length exchanged
    ! b in Box: extent_x(b) = if rotated(b) then length(b) else width(b).
    ! b in Box: extent_y(b) = if rotated(b) then width(b) else length(b).

    // every container occupies the rectangle from its left to its right edge and from its top to its bottom edge
    ! b in Box: right(b) = left(b) + extent_x(b).
    ! b in Box: top(b) = bottom(b) + extent_y(b).

    // the separation between two containers is the entry for their two classes
    ! b1, b2 in Box: min_sep(b1, b2) = sum{{ separation(c1, c2) | c1 in Cls, c2 in Cls: classes(b1) = c1 + 1 & classes(b2) = c2 + 1 }}.

    // containers do not overlap, and containers of classes with a minimum separation keep that distance along the deck or across the deck
    ! b1, b2 in Box: b1 ~= b2 => (right(b1) + min_sep(b1, b2) =< left(b2) | right(b2) + min_sep(b1, b2) =< left(b1) | top(b1) + min_sep(b1, b2) =< bottom(b2) | top(b2) + min_sep(b1, b2) =< bottom(b1)).
}
