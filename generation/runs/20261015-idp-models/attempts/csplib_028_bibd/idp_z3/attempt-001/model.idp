// Balanced Incomplete Block Design (BIBD): a v by b binary incidence matrix with parameters (v, b, r, k, lambda)
vocabulary {
    type Obj := {1..${v}}
    type Blk := {1..${b}}
    v: () -> Int
    b: () -> Int
    r: () -> Int
    k: () -> Int
    l: () -> Int
    matrix: Obj * Blk -> Bool
}
theory {
    // each object occurs in exactly r different blocks
    ! o in Obj: #{ blk in Blk: matrix(o, blk) } = r().

    // each block contains exactly k distinct objects
    ! blk in Blk: #{ o in Obj: matrix(o, blk) } = k().

    // every two distinct objects occur together in exactly lambda blocks
    ! o1, o2 in Obj: o1 ~= o2 => #{ blk in Blk: matrix(o1, blk) & matrix(o2, blk) } = l().
}
