// Bowls and oranges: place m oranges in n bowls in a line, at most one per bowl,
// so that no three oranges A, B, C have dist(A,B) = dist(B,C).
// The bowls are 1 meter apart, so a bowl number is its position.
vocabulary {
    type Orange := {1..${m}}     // one entry per orange, sized from the instance field m
    type Bowl := {1..${n}}       // bowls numbered 1..n, sized from the instance field n
    x: Orange -> Bowl            // declared output: the bowl of each orange, in ascending order
}
theory {
    // the oranges are listed in ascending order of bowl, and no two share a bowl
    ! i, j in Orange: i < j => x(i) < x(j).

    // no three oranges A, B, C (in order of bowl) with dist(A,B) = dist(B,C)
    ! a, b, c in Orange: (a < b & b < c) => x(a) + x(c) ~= 2 * x(b).
}
