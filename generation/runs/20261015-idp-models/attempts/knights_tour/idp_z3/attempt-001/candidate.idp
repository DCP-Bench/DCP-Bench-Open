// Knight's Tour: an open tour of an n x n chessboard where the knight visits every square once
vocabulary {
    type Idx := {1..${n}}                       // board row and column numbers
    type Move := {0..${n*n-1}}                  // move numbers 0 to n*n-1
    at: Move * Idx * Idx -> Bool                // at(k, r, c): the knight is on square (r, c) at move k
    x: Idx * Idx -> Move                        // x(r, c): the move number of the knight on square (r, c)
    knight: Idx * Idx * Idx * Idx -> Bool       // a knight's move from (r1, c1) to (r2, c2)
}
theory {
    { ! r1, c1, r2, c2 in Idx: knight(r1, c1, r2, c2) <-
        (abs(r1 - r2) = 1 & abs(c1 - c2) = 2) | (abs(r1 - r2) = 2 & abs(c1 - c2) = 1). }

    // each move is made on exactly one square
    ! k in Move: #{ r, c in Idx: at(k, r, c) } = 1.

    // each square is visited at exactly one move
    ! r, c in Idx: #{ k in Move: at(k, r, c) } = 1.

    // the move number of each square
    ! r, c in Idx, k in Move: at(k, r, c) => x(r, c) = k.

    // each move number is followed by the next one on a square a knight's move away
    ! k1, k2 in Move: k2 = k1 + 1 => ! r1, c1 in Idx: at(k1, r1, c1) => ? r2, c2 in Idx: knight(r1, c1, r2, c2) & at(k2, r2, c2).
}
