// Four islands (Pwana, Quero, Rayou, Skern) on a 2x2 map with bridges, each with a different
// primary export and tourist attraction: find the map position of each island, export and attraction.

vocabulary {
    // Map positions: A=0 (north-west), B=1 (north-east), C=2 (south-west), D=3 (south-east).
    type Pos := {0..3}
    // The four islands: Pwana=0, Quero=1, Rayou=2, Skern=3.
    type Isl := {0..3}
    // The four exports: alabaster=0, bananas=1, coconuts=2, durian fruit=3.
    type Exp := {0..3}
    // The four attractions: resort hotel=0, ice skating rink=1, jai alai stadium=2, koala preserve=3.
    type Att := {0..3}

    // The map position of each island, export and attraction.
    island: Isl -> Pos
    export: Exp -> Pos
    attraction: Att -> Pos

    // Relations between map positions.
    dueSouth: Pos * Pos -> Bool
    dueWest: Pos * Pos -> Bool
    northSouthBridge: Pos * Pos -> Bool
    eastWestBridge: Pos * Pos -> Bool
    bridge: Pos * Pos -> Bool
}

theory {
    // The map: x is due south of y, and x is due west of y, for the positions A=0, B=1, C=2, D=3.
    { dueSouth(2, 0). dueSouth(3, 1). }
    { dueWest(0, 1). dueWest(2, 3). }

    // The bridges: A-B and C-D run east-west, A-C and B-D run north-south.
    { northSouthBridge(0, 2). northSouthBridge(2, 0). northSouthBridge(1, 3). northSouthBridge(3, 1). }
    { eastWestBridge(0, 1). eastWestBridge(1, 0). eastWestBridge(2, 3). eastWestBridge(3, 2). }
    { ! x, y in Pos: bridge(x, y) <- northSouthBridge(x, y) | eastWestBridge(x, y). }

    // Each island is on a different position, and each export and attraction is on a different position.
    ! i, j in Isl: i ~= j => island(i) ~= island(j).
    ! i, j in Exp: i ~= j => export(i) ~= export(j).
    ! i, j in Att: i ~= j => attraction(i) ~= attraction(j).

    // 1. The island noted for its koala preserve is due south of Pwana.
    dueSouth(attraction(3), island(0)).

    // 2. The island with the largest alabaster quarry is due west of Quero.
    dueWest(export(0), island(1)).

    // 3. The island with the resort hotel is due east of the one that exports durian fruit.
    dueWest(export(3), attraction(0)).

    // 4. Skern and the island with the jai alai stadium are connected by a north-south bridge.
    northSouthBridge(island(3), attraction(2)).

    // 5. Rayou and the island that exports bananas are connected by an east-west bridge.
    eastWestBridge(island(2), export(1)).

    // 6. The islands noted for the ice skating rink and for the jai alai stadium are not connected by a bridge.
    ~bridge(attraction(1), attraction(2)).
}
