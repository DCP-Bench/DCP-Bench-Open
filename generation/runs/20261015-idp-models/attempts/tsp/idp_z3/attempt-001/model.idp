// Travelling salesman problem: find the shortest tour that visits each city exactly once and returns to the origin city.
vocabulary {
    type C <: Int                  // cities, sized from the number of rows of locations
    type D <: Int                  // coordinates per city, sized from the number of columns of locations
    locations: C * D -> Int        // instance data: x and y of each city
    travel_distance: () -> Int     // declared output: optimal travel distance
    minimize: () -> Int            // objective
    leg: C * C -> Bool             // the tour travels directly from the first city to the second
    pos: C -> C                    // position of a city in the tour, the origin city has position 0
    dist: C * C -> Int             // Euclidean distance rounded to an integer
    d2: C * C -> Int               // squared Euclidean distance
}
theory {
    // squared distance between two cities
    ! a, b in C: d2(a, b) = (locations(a, 0) - locations(b, 0)) * (locations(a, 0) - locations(b, 0))
                          + (locations(a, 1) - locations(b, 1)) * (locations(a, 1) - locations(b, 1)).

    // the distance is the Euclidean distance rounded to an integer: r is the integer nearest to sqrt(d2),
    // which holds exactly when r * (r - 1) =< d2 =< r * (r + 1)
    ! a, b in C: dist(a, b) * (dist(a, b) - 1) =< d2(a, b).
    ! a, b in C: 0 =< dist(a, b) & dist(a, b) =< d2(a, b).
    ! a, b in C: d2(a, b) =< dist(a, b) * (dist(a, b) + 1).

    // visit each city exactly once: no city is its own successor, every city has one successor and one predecessor
    ! a in C: ~leg(a, a).
    ! a in C: ?=1 b in C: leg(a, b).
    ! b in C: ?=1 a in C: leg(a, b).

    // the tour starts at the origin city 0; positions increase along the tour, which rules out subtours
    pos(0) = 0.
    ! a, b in C: leg(a, b) & ~(b = 0) => pos(b) >= pos(a) + 1.

    // the travel distance is the sum of the distances of the legs of the tour
    minimize() = sum{{ dist(a, b) | a in C, b in C: leg(a, b) }}.
    travel_distance() = minimize().
}
