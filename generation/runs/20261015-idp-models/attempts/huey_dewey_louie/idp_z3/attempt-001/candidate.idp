// Huey, Dewey and Louie are questioned about who is guilty. Print whether huey, dewey and louie are guilty.
vocabulary {
    huey: () -> Bool
    dewey: () -> Bool
    louie: () -> Bool
}
theory {
    // They cannot tell a lie, so every statement they make is true.
    // Huey: Dewey and Louie have equal share in it; if one is guilty, so is the other.
    dewey() <=> louie().
    // Dewey: if Huey is guilty, then so am I.
    huey() => dewey().
    // Louie: Dewey and I are not both guilty.
    ~(dewey() & louie()).
}
