// Flow Free: connect the two cells of each colour with a pipe so that the pipes
// cover the whole board without crossing or overlapping.
vocabulary {
    type Pos <: Int                         // row and column indices, sized from the board
    board: Pos * Pos -> Int                 // the clues: colour of a cell, 0 when empty
    type Color := {1..5}                    // colours of the pipes: the statement says colours are integers from 1 to 5
    B: Pos * Pos -> Color                   // declared output: colour of each cell
    type Depth := {0..24}                   // distance along a pipe from its first end: a pipe covers at most the 25 cells of the 5x5 board
    dep: Pos * Pos -> Depth                 // helper: distance of a cell from its pipe's end
    adj: Pos * Pos * Pos * Pos -> Bool      // (r2,c2) is a horizontal or vertical neighbour of (r1,c1)
}
theory {
    // the cell with a clue keeps that colour
    ! r, c in Pos: board(r,c) ~= 0 => B(r,c) = board(r,c).

    // two cells are neighbours when they share an edge
    { ! r1, c1, r2, c2 in Pos: adj(r1,c1,r2,c2) <-
        (r2 = r1 + 1 & c2 = c1) | (r2 = r1 - 1 & c2 = c1) | (r2 = r1 & c2 = c1 + 1) | (r2 = r1 & c2 = c1 - 1). }

    // each end of a pipe has exactly one neighbour of its colour
    ! r, c in Pos: board(r,c) ~= 0 => #{ r2, c2 in Pos: adj(r,c,r2,c2) & B(r2,c2) = B(r,c) } = 1.

    // each empty cell has exactly two neighbours of its colour (the pipe goes through it)
    ! r, c in Pos: board(r,c) = 0 => #{ r2, c2 in Pos: adj(r,c,r2,c2) & B(r2,c2) = B(r,c) } = 2.

    // the ends of a pipe start the distance count at zero
    ! r, c in Pos: board(r,c) ~= 0 => dep(r,c) = 0.

    // every other cell is one step further from its pipe's end than a neighbour of its colour
    ! r, c in Pos: board(r,c) = 0 => dep(r,c) >= 1.
    ! r, c in Pos: board(r,c) = 0 => ? r2, c2 in Pos: adj(r,c,r2,c2) & B(r2,c2) = B(r,c) & dep(r2,c2) = dep(r,c) - 1.
}
