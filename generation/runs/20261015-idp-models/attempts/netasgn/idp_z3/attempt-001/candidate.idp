// Project assignment problem: assign hours from people to projects at minimum total cost.
vocabulary {
    // Sizes come from the instance: People are the rows of cost, Projects its columns.
    type Person <: Int
    type Project <: Int
    // Hours per cell. The reference bounds every assignment by 0..10.
    type Hours := {0..10}

    supply: Person -> Int
    demand: Project -> Int
    cost: Person * Project -> Int
    limit: Person * Project -> Int

    // Declared outputs
    assign: Person * Project -> Hours
    total_cost: () -> Int

    minimize: () -> Int
}
theory {
    // The total number of hours assigned from each person equals its supply.
    ! i in Person: sum{{ assign(i, j) | j in Project }} = supply(i).

    // The total number of hours assigned to each project equals its demand.
    ! j in Project: sum{{ assign(i, j) | i in Person }} = demand(j).

    // Person i can contribute to project j up to a maximum limit.
    ! i in Person, j in Project: assign(i, j) =< limit(i, j).

    // The total cost is the sum of cost per hour times hours assigned.
    total_cost() = sum{{ (cost(i, j) * assign(i, j)) | i in Person, j in Project }}.

    // The objective is to minimize the total cost.
    minimize() = total_cost().
}
