// Allergy puzzle: four friends, each with a different surname and a different allergy.
// Debra = 0, Janet = 1, Hugh = 2, Rick = 3 (friend index); eggs = 0, mold = 1, nuts = 2, ragweed = 3;
// baxter = 0, lemon = 1, malone = 2, fleet = 3.

vocabulary {
    // The four friends, the four allergies and the four surnames.
    type Friend := {0..3}
    type Food := {0..3}
    type Surname := {0..3}

    // Decision: the allergy and the surname of each friend.
    allergy: Friend -> Food
    family: Friend -> Surname

    // Declared outputs: for each food or surname, the friend (index) who has it.
    eggs: () -> Int
    mold: () -> Int
    nuts: () -> Int
    ragweed: () -> Int
    baxter: () -> Int
    lemon: () -> Int
    malone: () -> Int
    fleet: () -> Int
}

theory {
    // each friend is allergic to something different
    ! f1, f2 in Friend: f1 ~= f2 => allergy(f1) ~= allergy(f2).

    // each friend has a different surname
    ! f1, f2 in Friend: f1 ~= f2 => family(f1) ~= family(f2).

    // Rick is not allergic to mold
    allergy(3) ~= 1.

    // Baxter is allergic to eggs
    ! f in Friend: family(f) = 0 => allergy(f) = 0.

    // Hugh is neither surnamed Lemon nor Fleet
    family(2) ~= 1 & family(2) ~= 3.

    // Debra is allergic to ragweed
    allergy(0) = 3.

    // Janet (who isn't Lemon) is neither allergic to eggs nor to mold
    family(1) ~= 1.
    allergy(1) ~= 0 & allergy(1) ~= 1.

    // report, for each food, the friend who is allergic to it
    eggs() = sum{{ f | f in Friend: allergy(f) = 0 }}.
    mold() = sum{{ f | f in Friend: allergy(f) = 1 }}.
    nuts() = sum{{ f | f in Friend: allergy(f) = 2 }}.
    ragweed() = sum{{ f | f in Friend: allergy(f) = 3 }}.

    // report, for each surname, the friend who has it
    baxter() = sum{{ f | f in Friend: family(f) = 0 }}.
    lemon() = sum{{ f | f in Friend: family(f) = 1 }}.
    malone() = sum{{ f | f in Friend: family(f) = 2 }}.
    fleet() = sum{{ f | f in Friend: family(f) = 3 }}.
}
