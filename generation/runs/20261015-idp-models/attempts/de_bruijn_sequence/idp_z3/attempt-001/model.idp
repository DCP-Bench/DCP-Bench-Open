// De Bruijn sequence of order n on an alphabet of base symbols: a cyclic sequence in which every
// possible length-n string occurs exactly once as a substring.
vocabulary {
    type D := {0..${base-1}}          // the alphabet: base symbols, numbered 0 to base-1
    type P := {0..${base**n-1}}       // positions of the cyclic sequence: base^n of them
    type J := {0..${n-1}}             // offsets inside a window of length n
    de_bruijn: P -> D                 // declared output: the symbol at each position
    wrap: P * J -> P                  // position of the offset-th symbol of the window starting at p, cyclically
}
theory {
    // the window starting at p reads positions p, p+1, ... and wraps around after the last position
    ! p in P, j in J: p + j =< ${base**n-1} => wrap(p, j) = p + j.
    ! p in P, j in J: p + j > ${base**n-1} => wrap(p, j) = p + j - ${base**n}.

    // every possible length-n string occurs exactly once: two different windows differ in some symbol
    ! p, q in P: p ~= q => ? j in J: de_bruijn(wrap(p, j)) ~= de_bruijn(wrap(q, j)).
}
