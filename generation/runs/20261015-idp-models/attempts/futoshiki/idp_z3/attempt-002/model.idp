// Futoshiki: fill an n x n grid with digits 1 to n so each row and column holds each digit once and every inequality holds
vocabulary {
    type Row <: Int                // grid rows, sized from the values grid
    type Col <: Int                // grid columns, sized from the values grid
    type Ineq <: Int               // the inequality clues, one index per clue
    type Field <: Int              // 0 = row of first cell, 1 = column of first cell, 2 = row of second cell, 3 = column of second cell
    values: Row * Col -> Int       // given digits; 0 marks an empty cell
    lt: Ineq * Field -> Int        // 1-based cell coordinates: the first cell is lower than the second
    grid: Row * Col -> Int         // the completed grid
    order: () -> Int               // the grid size n
}
theory {
    // the grid has n rows and n columns
    order() = #{ i in Row: i >= 0 }.

    // every cell holds a digit from 1 to n
    ! r in Row, c in Col: grid(r, c) >= 1 & grid(r, c) =< order().

    // each row contains each digit once
    ! r in Row, c1 in Col, c2 in Col: c1 ~= c2 => grid(r, c1) ~= grid(r, c2).

    // each column contains each digit once
    ! c in Col, r1 in Row, r2 in Row: r1 ~= r2 => grid(r1, c) ~= grid(r2, c).

    // the given digits are kept
    ! r in Row, c in Col: values(r, c) ~= 0 => grid(r, c) = values(r, c).

    // each inequality constraint must be honoured: the first cell is lower than the second
    ! k in Ineq, r in Row, c in Col, r2 in Row, c2 in Col:
        (r + 1 = lt(k, 0) & c + 1 = lt(k, 1) & r2 + 1 = lt(k, 2) & c2 + 1 = lt(k, 3)) => grid(r, c) < grid(r2, c2).
}
