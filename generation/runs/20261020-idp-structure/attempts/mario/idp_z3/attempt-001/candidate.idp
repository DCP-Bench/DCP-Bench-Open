// Mario must collect as much gold as possible by visiting houses, starting at Mario's house and ending at Luigi's house, without exceeding the fuel limit.
vocabulary {
    type House <: Int                       // houses 0..nHouses-1, sized from the instance data
    nHouses: () -> Int                      // number of houses
    marioHouse: () -> Int                   // Mario's starting house
    luigiHouse: () -> Int                   // Luigi's house, where the route ends
    fuelLimit: () -> Int                    // maximum fuel the route may consume
    arc_fuel: House * House -> Int          // fuel needed to travel from one house to another
    goldInHouse: House -> Int               // gold available in each house

    s: House -> House                       // s(i) is the house succeeding house i, s(i) = i if i is not on the route
    ord: House -> Int                       // position of a house along the route, used to rule out loops not through Mario's house
    maximize: () -> Int                     // total gold collected
}
theory {
    // s is a permutation: every house has at most one predecessor
    ! i, k in House: s(i) = s(k) => i = k.

    // Mario's house is on the route
    s(marioHouse()) ~= marioHouse().

    // the route ends at Luigi's house, whose succeeding house is Mario's house
    s(luigiHouse()) = marioHouse().

    // positions along the route are bounded
    ! i in House: 0 =< ord(i) & ord(i) =< nHouses() - 1.

    // the position increases by one along each travel, except for the arc back to Mario's house, so no loop avoids Mario's house
    ! i, j in House: (s(i) = j & i ~= j & j ~= marioHouse()) => ord(j) = ord(i) + 1.

    // every house on the route has its successor on the route
    ! i in House: s(i) ~= i => s(s(i)) ~= s(i).

    // the total fuel of the travelled arcs stays within the fuel limit
    sum{{ arc_fuel(i, s(i)) | i in House: s(i) ~= i }} =< fuelLimit().

    // the objective is the total gold of the houses on the route
    maximize() = sum{{ goldInHouse(i) | i in House: s(i) ~= i }}.
}
