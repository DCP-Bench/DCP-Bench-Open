vocabulary {
    type Car <: Int
    type Opt <: Int
    type Pos <: Int
    Pos_size: () -> Int
    demand: Car -> Int
    requires: Car * Opt -> Int
    at_most: Opt -> Int
    per_slots: Opt -> Int
    sequence: Pos -> Car
}

theory {
    // a number of cars are to be produced, the total is the sum of the demands
    Pos_size() = sum{{ demand(c) | c in Car }}.

    // each car type is produced as many times as its demand
    ! c in Car: #{p in Pos: sequence(p) = c} = demand(c).

    // the stations handle at most at_most(o) of every per_slots(o) consecutive cars
    // cars requiring an option must not be bunched together
    ! o in Opt: ! p in Pos: p + per_slots(o) - 1 =< Pos_size() => #{q in Pos: p =< q & q =< p + per_slots(o) - 1 & requires(sequence(q), o) = 1} =< at_most(o).
}
