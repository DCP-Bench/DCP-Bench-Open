vocabulary {
    // Work pieces are numbered 1..num_work.
    type Range_num_work <: Int
    // One index per shift; sized from the shifts array (0-based).
    type Shift <: Int
    // Column index inside a shift; sized from the longest shift (0-based).
    type Pos <: Int

    num_work: () -> Int
    // Ragged rows: shifts(s, j) is the j-th work piece of shift s, padded with 0.
    shifts: Shift * Pos -> Int
    shifts_len: Shift -> Int

    // Declared output: 1 if the shift is selected.
    x: Shift -> Bool

    // Auxiliary: shift s covers work piece w.
    covers: Shift * Range_num_work -> Bool

    // Objective: number of selected shifts.
    minimize: () -> Int
}

theory {
    // a shift covers a work piece when the piece appears in its list
    { ! s in Shift, w in Range_num_work: covers(s, w) <- ? j in Pos: shifts(s, j) = w. }

    // each piece of work is covered by exactly one selected shift
    ! w in Range_num_work: ?=1 s in Shift: x(s) & covers(s, w).

    // minimize the number of selected shifts
    minimize() = #{ s in Shift: x(s) }.
}
