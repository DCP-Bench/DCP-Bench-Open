vocabulary {
    // the sequence length n, sizes the range 1..n
    n: () -> Int
    type Range_n <: Int
    // one bit per position, +1 or -1
    sequence: Range_n -> Int
    // cyc(i, k, j): position j is (i + k) on the cycle of length n, 1-based
    cyc: Range_n * Range_n * Range_n -> Bool
    // k-th periodic autocorrelation
    C: Range_n -> Int
    minimize: () -> Int
}
theory {
    // each bit takes the value +1 or -1
    ! i in Range_n: sequence(i) = 1 | sequence(i) = -1.
    // cyclic index: j = i + k, or j = i + k - n when i + k exceeds n
    { ! i, k, j in Range_n: cyc(i, k, j) <- i + k = j | i + k = j + n(). }
    // C_k = sum_i S_i * S_((i+k) mod n)
    ! k in Range_n: C(k) = sum{{ (sequence(i) * sequence(j)) | i, j in Range_n: cyc(i, k, j) }}.
    // E = sum over k = 1..n-1 of C_k^2
    minimize() = sum{{ (C(k) * C(k)) | k in Range_n: k ~= n() }}.
}
