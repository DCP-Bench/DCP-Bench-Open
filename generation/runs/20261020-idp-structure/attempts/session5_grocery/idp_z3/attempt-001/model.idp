vocabulary {
    // one item per index, num_items items
    type Range_num_items <: Int
    total_price: () -> Int
    prices: Range_num_items -> Int
    pp: Range_num_items -> Int
    nxt: Range_num_items * Range_num_items -> Bool
}
theory {
    // every item has a positive price in cents, at most the total
    ! i in Range_num_items: 1 =< prices(i) & prices(i) =< total_price().

    // adding the prices gives the total price
    sum{{ prices(i) | i in Range_num_items }} = total_price().

    // nxt(i, j) holds when j follows i
    { ! i, j in Range_num_items: nxt(i, j) <- i + 1 = j. }

    // the running product of the prices, from the first item on
    pp(1) = prices(1).
    ! i in Range_num_items: ! j in Range_num_items: nxt(i, j) => pp(j) = pp(i) * prices(j).

    // multiplying the prices gives the same total price
    ! i in Range_num_items: #{ j in Range_num_items: nxt(i, j) } = 0 => pp(i) = total_price().
}
