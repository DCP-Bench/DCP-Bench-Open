vocabulary {
    type Range_size <: Int
    marks: Range_size -> Int
    length: () -> Int
    minimize: () -> Int
}
theory {
    // the first mark is at position 0
    marks(1) = 0.
    // the marks are strictly increasing
    ! i, j in Range_size: i < j => marks(i) < marks(j).
    // every mark is at most size * size
    ! i in Range_size: marks(i) =< size() * size().
    // all differences a_j - a_i for i < j are distinct
    ! i, j, k, l in Range_size: i < j & k < l & ~(i = k & j = l) => marks(j) - marks(i) ~= marks(l) - marks(k).
    // the length of the ruler is the last mark
    length() = marks(size()).
    // minimize the length of the ruler
    minimize() = length().
}
