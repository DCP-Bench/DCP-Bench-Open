vocabulary {
    // Warehouse cities, indexed 0-based: 0 New York, 1 Los Angeles, 2 Chicago, 3 Atlanta.
    type Warehouse <: Int
    // Regions served, sized from the demands array (0-based).
    type Region <: Int

    demands: Region -> Int
    fixed_costs: Warehouse -> Int
    shipping_costs: Warehouse * Region -> Int
    max_shipping: () -> Int

    open_warehouse: Warehouse -> Bool
    ships: Warehouse * Region -> Int
    total_cost: () -> Int

    minimize: () -> Int
}

theory {
    // If New York is opened, Los Angeles must also be opened.
    open_warehouse(0) => open_warehouse(1).

    // No more than three warehouses are operational.
    #{ w in Warehouse: open_warehouse(w) } =< 3.

    // Either Atlanta or Los Angeles must be opened.
    open_warehouse(3) | open_warehouse(1).

    // Shipments from a closed warehouse are zero.
    ! w in Warehouse, r in Region: ~open_warehouse(w) => ships(w, r) = 0.

    // Shipments are non-negative and bounded by the capacity.
    ! w in Warehouse, r in Region: 0 =< ships(w, r) & ships(w, r) =< max_shipping().

    // An open warehouse ships at most its capacity.
    ! w in Warehouse: open_warehouse(w) => sum{{ ships(w, r) | r in Region }} =< max_shipping().

    // Each region receives exactly its demand.
    ! r in Region: sum{{ ships(w, r) | w in Warehouse }} = demands(r).

    // Total cost: fixed costs of open warehouses plus shipping costs.
    total_cost() = sum{{ (if open_warehouse(w) then fixed_costs(w) else 0) | w in Warehouse }}
                 + sum{{ (shipping_costs(w, r) * ships(w, r)) | w in Warehouse, r in Region }}.

    minimize() = total_cost().
}
