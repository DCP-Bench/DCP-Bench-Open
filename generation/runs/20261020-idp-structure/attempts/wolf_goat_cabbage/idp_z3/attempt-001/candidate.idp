vocabulary {
    type Pos <: Int                 // stages 1..(stage + 1), one per state of the crossing
    Pos_size: () -> Int
    stage: () -> Int

    wolf_pos: Pos -> Bool           // true on the destination shore
    goat_pos: Pos -> Bool
    cabbage_pos: Pos -> Bool
    boat_pos: Pos -> Bool
    next: Pos * Pos -> Bool         // s directly follows t
}

theory {
    // the number of states is the number of stages plus one
    Pos_size() = stage() + 1.

    // the successor relation between consecutive states
    { ! t, s in Pos: next(t, s) <- s = t + 1. }

    // everything starts on the starting shore
    ~wolf_pos(1) & ~goat_pos(1) & ~cabbage_pos(1) & ~boat_pos(1).

    // everything ends on the destination shore
    ! x in Pos: x = stage() + 1 => (wolf_pos(x) & goat_pos(x) & cabbage_pos(x) & boat_pos(x)).

    // the farmer rows the boat on every crossing
    ! t, s in Pos: next(t, s) => (boat_pos(s) <=> ~boat_pos(t)).

    // an item only crosses when it is on the same shore as the boat
    ! t, s in Pos: next(t, s) => ((wolf_pos(s) <=> wolf_pos(t)) | (wolf_pos(t) <=> boat_pos(t))).
    ! t, s in Pos: next(t, s) => ((goat_pos(s) <=> goat_pos(t)) | (goat_pos(t) <=> boat_pos(t))).
    ! t, s in Pos: next(t, s) => ((cabbage_pos(s) <=> cabbage_pos(t)) | (cabbage_pos(t) <=> boat_pos(t))).

    // the boat carries the farmer and at most one item
    ! t, s in Pos: next(t, s) => ~((wolf_pos(s) <=> ~wolf_pos(t)) & (goat_pos(s) <=> ~goat_pos(t))).
    ! t, s in Pos: next(t, s) => ~((wolf_pos(s) <=> ~wolf_pos(t)) & (cabbage_pos(s) <=> ~cabbage_pos(t))).
    ! t, s in Pos: next(t, s) => ~((goat_pos(s) <=> ~goat_pos(t)) & (cabbage_pos(s) <=> ~cabbage_pos(t))).

    // the wolf and the goat are never left together without the farmer
    ! t in Pos: (wolf_pos(t) <=> goat_pos(t)) => (boat_pos(t) <=> goat_pos(t)).

    // the goat and the cabbage are never left together without the farmer
    ! t in Pos: (goat_pos(t) <=> cabbage_pos(t)) => (boat_pos(t) <=> goat_pos(t)).
}
