// Killer sudoku: fill an n x n grid with 1..n so that each row, column and nonet
// holds every digit once, each cage sums to its printed total, and no digit repeats in a cage.
vocabulary {
    type Range_n <: Int
    type Cage <: Int
    type Cell <: Int
    type Coord <: Int
    problem_1: Cage -> Int
    problem_2: Cage * Cell * Coord -> Int
    problem_2_len: Cage -> Int
    in_cage: Cage * Range_n * Range_n -> Bool
    x: Range_n * Range_n -> Range_n
}
theory {
    // a cell belongs to a cage when it is one of the cage's listed cells (coordinates are 1-based)
    { ! i in Cage, r in Range_n, c in Range_n: in_cage(i, r, c) <- ? j in Cell: j < problem_2_len(i) & problem_2(i, j, 0) = r & problem_2(i, j, 1) = c. }

    // the sum of all numbers in a cage must match the small number printed in its corner
    ! i in Cage: sum{{ x(r, c) | r in Range_n, c in Range_n: in_cage(i, r, c) }} = problem_1(i).

    // no number appears more than once in a cage
    ! i in Cage, d in Range_n: #{ r in Range_n, c in Range_n: in_cage(i, r, c) & x(r, c) = d } =< 1.

    // each row contains each number exactly once
    ! r in Range_n, c1, c2 in Range_n: c1 ~= c2 => x(r, c1) ~= x(r, c2).

    // each column contains each number exactly once
    ! c in Range_n, r1, r2 in Range_n: r1 ~= r2 => x(r1, c) ~= x(r2, c).

    // each nonet (3 x 3 block) contains each number exactly once
    ! r1, r2 in Range_n, c1, c2 in Range_n: ((r1 ~= r2 | c1 ~= c2) & (r1 - 1) / 3 = (r2 - 1) / 3 & (c1 - 1) / 3 = (c2 - 1) / 3) => x(r1, c1) ~= x(r2, c2).
}
