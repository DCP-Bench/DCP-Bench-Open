vocabulary {
    type Range_n <: Int            // positions 1..n, sized from n
    n: () -> Int
    x: Range_n -> Int              // declared output: x(p) is the sequence entry at position p-1
}
theory {
    // every entry lies between 0 and n-1
    ! p in Range_n: 0 =< x(p) & x(p) =< n() - 1.

    // the number p-1 occurs exactly x(p) times in the sequence
    ! p in Range_n: #{ q in Range_n: x(q) = p - 1 } = x(p).
}
