vocabulary {
    // Products (shirts, shorts, pants), sized from the products array (0-based).
    type Prod <: Int
    // Resources (labor, cloth), sized from the resources array (0-based).
    type Res <: Int
    // Machines, sized from the renting_cost array (0-based).
    type Mach <: Int

    products: Prod -> Int
    resources: Res -> Int
    use: Prod * Res -> Int
    renting_cost: Mach -> Int
    machines: Mach -> Int
    shirtM: () -> Int
    shortM: () -> Int
    pantM: () -> Int

    // Declared output: maximum profit.
    z: () -> Int

    // Units of each product produced.
    x: Prod -> Int
    // Machine m is rented.
    rent: Mach -> Bool

    maximize: () -> Int
}

theory {
    // production is non-negative
    ! p in Prod: x(p) >= 0.

    // a product can be made only up to its machine's capacity, and only when that machine is rented
    x(0) =< machines(shirtM()) * (if rent(shirtM()) then 1 else 0).
    x(1) =< machines(shortM()) * (if rent(shortM()) then 1 else 0).
    x(2) =< machines(pantM()) * (if rent(pantM()) then 1 else 0).

    // labor and cloth resources cannot be exceeded
    ! r in Res: sum{{ (use(p, r) * x(p)) | p in Prod }} =< resources(r).

    // profit from products minus renting cost of the machines
    z() = sum{{ (products(p) * x(p)) | p in Prod }} - sum{{ (renting_cost(m) * (if rent(m) then 1 else 0)) | m in Mach }}.

    maximize() = z().
}
