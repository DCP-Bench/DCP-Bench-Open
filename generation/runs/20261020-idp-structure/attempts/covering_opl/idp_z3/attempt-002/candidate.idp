vocabulary {
    type W <: Int                  // workers, sized from Cost (0-based)
    type I <: Int                  // tasks, sized from Qualified
    type J <: Int                  // padded columns of Qualified
    Cost: W -> Int
    Qualified: I * J -> Int
    Qualified_len: I -> Int
    qual: I * W -> Bool
    workers: W -> Bool             // declared output: worker hired
    total_cost: () -> Int          // declared output
    minimize: () -> Int
}
theory {
    // qual(i, w) holds when worker w is qualified for task i (worker ids are 1-based in the data)
    { ! i in I, w in W: qual(i, w) <- ? j in J: j < Qualified_len(i) & Qualified(i, j) - 1 = w. }

    // ensure all tasks are performed: each task has a hired qualified worker
    ! i in I: ? w in W: qual(i, w) & workers(w).

    // total cost is the sum of hiring costs of the selected workers
    total_cost() = sum{{ Cost(w) | w in W: workers(w) }}.

    // minimize the total cost
    minimize() = total_cost().
}
