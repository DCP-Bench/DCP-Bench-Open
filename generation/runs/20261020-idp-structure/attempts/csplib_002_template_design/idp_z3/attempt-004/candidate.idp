vocabulary {
    type V <: Int                      // variations, sized from demand
    type Range_n_templates <: Int      // templates 1..n_templates
    type Range_n_slots <: Int          // 1..n_slots, the counts a template can hold
    n_slots: () -> Int
    demand: V -> Int
    layout: Range_n_templates * V -> Int
    production: Range_n_templates -> Int
    printed: Range_n_templates * V -> Int   // copies of v printed from template t
    minimize: () -> Int
}
theory {
    // each template carries at most n_slots designs
    ! t in Range_n_templates: sum{{ layout(t, v) | v in V }} =< n_slots().
    // counts are non-negative and bounded by the slots
    ! t in Range_n_templates, v in V: 0 =< layout(t, v) & layout(t, v) =< n_slots().
    ! t in Range_n_templates: 0 =< production(t) & production(t) =< sum{{ demand(v) | v in V }}.
    // printed copies are the layout count times the number of sheets, written
    // as a sum over the possible counts so every term is linear
    ! t in Range_n_templates, v in V: printed(t, v) = sum{{ (if layout(t, v) = k then k * production(t) else 0) | k in Range_n_slots }}.
    // each variation is printed at least as often as demanded
    ! v in V: demand(v) =< sum{{ printed(t, v) | t in Range_n_templates }}.
    // minimise the total number of printed sheets
    minimize() = sum{{ production(t) | t in Range_n_templates }}.
}
