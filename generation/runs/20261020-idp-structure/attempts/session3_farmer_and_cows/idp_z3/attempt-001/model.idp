vocabulary {
    type Cow <: Int
    Cow_size: () -> Int
    num_cows: () -> Int
    type Son <: Int
    cows_per_son: Son -> Int
    num_sons: () -> Int
    own: Cow * Son -> Bool
    milk: Son -> Int
    cow_assignments: Cow -> Son
}
theory {
    // each cow numbered from 1 up to the total number of cows
    Cow_size() = num_cows().

    // each cow goes to exactly one son
    ! c in Cow: ?=1 s in Son: own(c, s).

    // the number of cows given to each son follows the given distribution
    ! s in Son: s < num_sons() => #{ c in Cow: own(c, s) } = cows_per_son(s).
    ! s in Son: s >= num_sons() => #{ c in Cow: own(c, s) } = 0.

    // each cow gives milk equal to its number; milk(s) is the total milk of son s
    ! s in Son: milk(s) = sum{{ (c) | c in Cow: own(c, s) }}.

    // the total milk is the same for each son
    ! s1 in Son: ! s2 in Son: (s1 < num_sons() & s2 < num_sons()) => milk(s1) = milk(s2).

    // the output lists the son that each cow goes to
    ! c in Cow: ! s in Son: own(c, s) => cow_assignments(c) = s.
}
