vocabulary {
    n_teams: () -> Int
    type Range_n_teams <: Int          // teams are numbered 1..n_teams
    type Week <: Int                   // n_teams - 1 weeks
    Week_size: () -> Int
    type Period <: Int                 // n_teams / 2 periods per week
    Period_size: () -> Int
    home: Week * Period -> Range_n_teams
    away: Week * Period -> Range_n_teams
}

theory {
    // the tournament has n-1 weeks, each with n/2 periods
    Week_size() = n_teams() - 1.
    Period_size() = n_teams() / 2.

    // the first team in each slot plays at home, the second plays away, so the two differ
    ! w in Week, p in Period: home(w, p) ~= away(w, p).

    // every team plays once a week
    ! w in Week, t in Range_n_teams: #{p in Period: (home(w, p) = t) | (away(w, p) = t)} = 1.

    // every team plays at most twice in the same period over the tournament
    ! p in Period, t in Range_n_teams: #{w in Week: (home(w, p) = t) | (away(w, p) = t)} =< 2.

    // every team plays every other team
    ! t1, t2 in Range_n_teams: t1 ~= t2 => #{w in Week, p in Period: (home(w, p) = t1 & away(w, p) = t2) | (home(w, p) = t2 & away(w, p) = t1)} = 1.
}
