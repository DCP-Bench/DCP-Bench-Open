vocabulary {
    type Range_n <: Int
    n: () -> Int
    x: Range_n * Range_n -> Int
    move: Range_n * Range_n * Range_n * Range_n -> Bool
}
theory {
    // every square of the n by n grid holds a number from 1 to n*n
    ! r, c in Range_n: 1 =< x(r, c) & x(r, c) =< n() * n().

    // every square is filled, and each number is used exactly once
    ! r1, c1, r2, c2 in Range_n: (r1 ~= r2 | c1 ~= c2) => x(r1, c1) ~= x(r2, c2).

    // the next number is placed exactly three squares horizontally or vertically away,
    // or exactly two squares diagonally away
    ! r1, c1 in Range_n: x(r1, c1) ~= n() * n() => ? r2, c2 in Range_n: x(r2, c2) = x(r1, c1) + 1 & move(r1, c1, r2, c2).

    {
        ! r1, c1, r2, c2 in Range_n: move(r1, c1, r2, c2) <-
            (r1 = r2 & (c1 = c2 + 3 | c2 = c1 + 3)) |
            (c1 = c2 & (r1 = r2 + 3 | r2 = r1 + 3)) |
            ((r1 = r2 + 2 | r2 = r1 + 2) & (c1 = c2 + 2 | c2 = c1 + 2)).
    }
}
