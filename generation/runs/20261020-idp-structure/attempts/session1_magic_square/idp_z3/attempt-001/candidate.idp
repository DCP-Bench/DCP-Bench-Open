vocabulary {
    // the grid has n rows and n columns
    type Range_n <: Int
    // cell values range over 1..n*n
    type Cell <: Int
    Cell_size: () -> Int
    n: () -> Int
    magic_sum: () -> Int
    // declared output: square[row][column]
    square: Range_n * Range_n -> Cell
}
theory {
    // the values run from 1 to n^2
    Cell_size() = n() * n().

    // the common sum is n(n^2 + 1) / 2
    magic_sum() = n() * (n() * n() + 1) / 2.

    // each integer from 1 to n^2 is placed in exactly one cell
    ! v in Cell: #{ r, c in Range_n: square(r, c) = v } = 1.

    // every row sums to the magic constant
    ! r in Range_n: sum{{ square(r, c) | c in Range_n }} = magic_sum().

    // every column sums to the magic constant
    ! c in Range_n: sum{{ square(r, c) | r in Range_n }} = magic_sum().

    // the main diagonal sums to the magic constant
    sum{{ square(r, r) | r in Range_n }} = magic_sum().

    // the anti-diagonal sums to the magic constant
    sum{{ square(r, c) | r, c in Range_n: r + c = n() + 1 }} = magic_sum().
}
