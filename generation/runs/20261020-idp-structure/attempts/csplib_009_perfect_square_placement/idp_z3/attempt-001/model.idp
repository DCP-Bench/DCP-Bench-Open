vocabulary {
    type I <: Int                      // one index per square, sized from sides
    base: () -> Int                    // side of the big square
    sides: I -> Int                    // side length of each square
    x_coords: I -> Int                 // declared output: left column of each square, 0-based
    y_coords: I -> Int                 // declared output: bottom row of each square, 0-based
}

theory {
    // every square lies inside the big square
    ! i in I: 0 =< x_coords(i) & x_coords(i) + sides(i) =< base().
    ! i in I: 0 =< y_coords(i) & y_coords(i) + sides(i) =< base().

    // no two squares overlap: for each pair, one lies left of, right of, below or above the other
    ! i in I: ! j in I: i ~= j =>
        (x_coords(i) + sides(i) =< x_coords(j) | x_coords(j) + sides(j) =< x_coords(i) |
         y_coords(i) + sides(i) =< y_coords(j) | y_coords(j) + sides(j) =< y_coords(i)).
}
