vocabulary {
    type I <: Int                      // positions of the sorted list, sized from a
    type Range_k <: Int                // groups 1..k
    a: I -> Int
    k: () -> Int
    gap: Range_k -> Bool
    x: Range_k -> I (domain: gap)      // declared output: break points
    ok: I -> Bool
    sz: Range_k -> Int
    err: Range_k -> Int
    minimize: () -> Int
}
theory {
    { ! i in Range_k: gap(i) <- i < k(). }

    // elements with the same value must be in the same group: a break after position p
    // separates a(p-1) from a(p), which must differ
    { ! p in I: ok(p) <- p >= 1 & ? q in I: q + 1 = p & a(q) ~= a(p). }
    ! i in Range_k: gap(i) => ok(x(i)).

    // break points are increasing
    ! i in Range_k: i > 1 & gap(i) & gap(i - 1) => x(i - 1) < x(i).

    // group sizes from the break points
    ! i in Range_k: i = 1 & gap(i) => sz(i) = x(i).
    ! i in Range_k: i > 1 & gap(i) & gap(i - 1) => sz(i) = x(i) - x(i - 1).
    ! i in Range_k: i = k() & i > 1 & gap(i - 1) => sz(i) = #{ p in I: p = p } - x(i - 1).
    ! i in Range_k: i = k() & i = 1 => sz(i) = #{ p in I: p = p }.

    // each group should be close to round(N/K) elements; minimize the total error
    ! i in Range_k: err(i) = abs((2 * #{ p in I: p = p } + k()) / (2 * k()) - sz(i)).
    minimize() = sum{{ err(i) | i in Range_k }}.
}
