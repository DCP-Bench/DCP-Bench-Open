vocabulary {
    max_val: () -> Int
    n: () -> Int
    number: () -> Int
    r1: () -> Int
    r3: () -> Int
    r8: () -> Int
    r120: () -> Int
}
theory {
    // The fifth number is larger than or equal to 0.
    0 =< number() & number() =< max_val().
    // The product of it with 1, 3, 8 and 120 is one less than a perfect square.
    0 =< r1() & r1() =< max_val() + 1.
    0 =< r3() & r3() =< 3 * max_val() + 1.
    0 =< r8() & r8() =< 8 * max_val() + 1.
    0 =< r120() & r120() =< 120 * max_val() + 1.
    number() * 1 + 1 = r1() * r1().
    number() * 3 + 1 = r3() * r3().
    number() * 8 + 1 = r8() * r8().
    number() * 120 + 1 = r120() * r120().
}
