vocabulary {
    max_val: () -> Int
    type Sq <: Int
    Sq_size: () -> Int
    number: () -> Int
}
theory {
    // the fifth number is an integer from 0 up to max_val
    0 =< number() & number() =< max_val().

    // every root needed for a square up to 120 * max_val + 1 lies in 1..11 * max_val + 1
    Sq_size() = 11 * max_val() + 1.

    // 1 times the number plus 1 is a perfect square
    ? k in Sq: k * k = 1 * number() + 1.

    // 3 times the number plus 1 is a perfect square
    ? k in Sq: k * k = 3 * number() + 1.

    // 8 times the number plus 1 is a perfect square
    ? k in Sq: k * k = 8 * number() + 1.

    // 120 times the number plus 1 is a perfect square
    ? k in Sq: k * k = 120 * number() + 1.
}
