vocabulary {
    // instance field n
    n: () -> Int
    // digit positions 1..Dig_size
    type Dig <: Int
    Dig_size: () -> Int
    // decimal digits
    type Digit := {0..9}
    d: Dig -> Digit
    // place values 10^(i-1)
    pw: Dig -> Int
    // cube root of the number
    c: () -> Int
    // declared output
    number: () -> Int
}
theory {
    // the number of digit positions covers the cube of the largest root
    Dig_size() = 3 * n().

    // the cube root lies in 2..n so that the number is larger than 1
    2 =< c() & c() =< n().

    // the number is a perfect cube
    number() = c() * c() * c().

    // place values are powers of ten
    ! i in Dig: i = 1 => pw(i) = 1.
    ! i in Dig: i < Dig_size() => pw(i + 1) = 10 * pw(i).

    // the digits of the number give its value
    c() * c() * c() = sum{{ (d(i) * pw(i)) | i in Dig }}.

    // the digit sum equals the cube root
    sum{{ d(i) | i in Dig }} = c().
}
