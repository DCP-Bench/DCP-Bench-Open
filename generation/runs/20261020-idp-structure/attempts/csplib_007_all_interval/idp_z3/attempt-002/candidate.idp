vocabulary {
    type Range_n <: Int
    n: () -> Int
    x: Range_n -> Int
    gap: Range_n -> Int
}
theory {
    // the series is a sequence of n pitch-classes, numbered 1..n
    // each pitch-class is a number between 0 and n-1
    ! i in Range_n: 0 =< x(i) & x(i) =< n() - 1.
    // each pitch-class occurs exactly once
    ! i, j in Range_n: i ~= j => x(i) ~= x(j).
    // the interval between neighbouring notes is the absolute difference
    ! i in Range_n: ! j in Range_n: j = i + 1 => gap(i) = abs(x(j) - x(i)).
    // the intervals of the series are from 1 to n-1
    ! i in Range_n: i < n() => (1 =< gap(i) & gap(i) =< n() - 1).
    // each interval occurs exactly once
    ! i, j in Range_n: (i < n() & j < n() & i ~= j) => gap(i) ~= gap(j).
}
