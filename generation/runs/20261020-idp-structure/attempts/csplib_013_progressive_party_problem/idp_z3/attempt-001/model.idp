// Progressive party problem: timetable a yacht club party, minimizing the number of host boats.
vocabulary {
    // boats are indexed 0..n_boats-1, sized from the capacity array
    type Boat <: Int
    // half-hour visiting periods, 1..n_periods
    type Range_n_periods <: Int

    capacity: Boat -> Int
    crew_size: Boat -> Int

    // a boat is a host
    is_host: Boat -> Bool
    // visits[p,b] = v: in period p, boat b visits boat v
    visits: Range_n_periods * Boat -> Boat

    minimize: () -> Int
}
theory {
    // the crew of a host boat remains on board and hosts
    ! p in Range_n_periods, b in Boat: is_host(b) => visits(p, b) = b.

    // the crew of a guest boat visits host boats
    ! p in Range_n_periods, b in Boat: ~is_host(b) => is_host(visits(p, b)).

    // the total number of people aboard a host boat, including the host crew and guest crews, must not exceed its capacity
    ! p in Range_n_periods, h in Boat: is_host(h) => sum{{ crew_size(g) | g in Boat: visits(p, g) = h }} =< capacity(h).

    // a guest boat cannot revisit a host
    ! g in Boat, h in Boat: (~is_host(g) & is_host(h)) => #{ p in Range_n_periods: visits(p, g) = h } =< 1.

    // guest crews cannot meet more than once
    ! g1 in Boat, g2 in Boat: g1 ~= g2 => #{ p in Range_n_periods: visits(p, g1) = visits(p, g2) } =< 1.

    // minimize the number of host boats
    minimize() = #{ b in Boat: is_host(b) }.
}
