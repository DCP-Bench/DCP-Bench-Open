// Costas array problem: place n marks on an n x n grid, one per row and one per column,
// such that the vectors between all pairs of marks are different.
vocabulary {
    n: () -> Int
    // the grid rows and columns, 1..n
    type Range_n <: Int
    // costas(r) is the column of the mark in row r
    costas: Range_n -> Range_n
}
theory {
    // one mark per row and one mark per column (the array is a permutation)
    ! r1, r2 in Range_n: r1 ~= r2 => costas(r1) ~= costas(r2).

    // the difference triangle: for each length l, the differences X_i - X_{i+l} are all different
    ! l, i, j in Range_n: (i + l =< n() & j + l =< n() & i ~= j) => costas(i) - costas(i + l) ~= costas(j) - costas(j + l).
}
