// A bank van had several kinds of coin bags, each kind holding a fixed number of coins.
// Some bags were stolen, losing a given total number of coins. Find how many bags
// of each kind were stolen.
vocabulary {
    type B <: Int                      // coin bag kinds, sized from the data
    coin_numbers: B -> Int             // number of coins in a bag of each kind
    total_coins_lost: () -> Int        // total number of coins lost
    bags: B -> Int                     // number of stolen bags of each kind
}
theory {
    // every bag count is a non-negative number, and no more coins than were lost
    ! b in B: 0 =< bags(b) & bags(b) =< total_coins_lost().

    // the stolen bags add up to exactly the coins lost
    sum{{ (bags(b) * coin_numbers(b)) | b in B }} = total_coins_lost().
}
