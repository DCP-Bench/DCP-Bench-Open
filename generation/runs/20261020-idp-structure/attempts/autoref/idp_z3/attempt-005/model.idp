vocabulary {
    type Pos <: Int
    Pos_size: () -> Int
    n: () -> Int
    m: () -> Int
    s: Pos -> Int          // declared output: s(p) is entry s_{p-1}
}
theory {
    Pos_size() = n() + 2.
    // entries are occurrence counts or the value m, so they lie between 0 and n+2+m
    ! p in Pos: 0 =< s(p) & s(p) =< n() + 2 + m().
    // there are s_i occurrences of i in S for each integer i from 0 to n
    ! p in Pos: p =< n() + 1 => s(p) = #{ q in Pos: s(q) = p - 1 }.
    // s_{n+1} = m
    s(n() + 2) = m().
}
