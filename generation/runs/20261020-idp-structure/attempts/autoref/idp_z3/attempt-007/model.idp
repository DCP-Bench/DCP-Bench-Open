vocabulary {
    type Pos <: Int
    Pos_size: () -> Int
    n: () -> Int
    m: () -> Int
    s: Pos -> Int          // declared output: s(p) is entry s_{p-1}
}
theory {
    Pos_size() = n() + 2.
    // s_0..s_n are counts of occurrences of 0..n, so each lies between 0 and n
    ! p in Pos: p =< n() + 1 => (0 =< s(p) & s(p) =< n()).
    // there are s_i occurrences of i in S for each integer i from 0 to n
    ! p in Pos: p =< n() + 1 => s(p) = #{ q in Pos: s(q) = p - 1 }.
    // s_{n+1} = m
    ! p in Pos: p = n() + 2 => s(p) = m().
}
