vocabulary {
    type C <: Int                       // one index per container (sized from length)
    type K <: Int                       // container classes (sized from separation)
    deck_length: () -> Int
    deck_width: () -> Int
    length: C -> Int
    width: C -> Int
    classes: C -> Int
    separation: K * K -> Int
    left: C -> Int                      // declared output
    right: C -> Int                     // declared output
    top: C -> Int                       // declared output
    bottom: C -> Int                    // declared output
}
theory {
    // every container lies within the deck (positions are inclusive, from 0)
    ! c in C: 0 =< left(c) & right(c) =< deck_length() - 1.
    ! c in C: 0 =< top(c) & bottom(c) =< deck_width() - 1.
    // a container of length L covers L cells along the deck, and width W covers W cells across
    ! c in C: right(c) = left(c) + length(c) - 1.
    ! c in C: bottom(c) = top(c) + width(c) - 1.
    // containers do not overlap, and containers of classes k and l keep the minimum separation
    ! c1 in C: ! c2 in C: ! k in K: ! l in K:
        (c1 ~= c2 & classes(c1) = k & classes(c2) = l) =>
            (right(c1) + 1 + separation(k, l) =< left(c2) | right(c2) + 1 + separation(l, k) =< left(c1) |
             bottom(c1) + 1 + separation(k, l) =< top(c2) | bottom(c2) + 1 + separation(l, k) =< top(c1)).
}
