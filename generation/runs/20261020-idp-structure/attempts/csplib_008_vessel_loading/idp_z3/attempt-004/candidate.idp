vocabulary {
    type C <: Int                       // one index per container (sized from length)
    deck_length: () -> Int
    deck_width: () -> Int
    length: C -> Int
    width: C -> Int
    classes: C -> Int
    left: C -> Int                      // declared output
    right: C -> Int                     // declared output
    top: C -> Int                       // declared output
    bottom: C -> Int                    // declared output
}
theory {
    // every container lies within the deck
    ! c in C: 0 =< left(c) & right(c) =< deck_length().
    ! c in C: 0 =< top(c) & bottom(c) =< deck_width().
    // the width spans the deck length and the length spans the deck width
    ! c in C: right(c) = left(c) + width(c).
    ! c in C: bottom(c) = top(c) + length(c).
    // containers do not overlap
    ! c1 in C: ! c2 in C:
        c1 ~= c2 =>
            (right(c1) =< left(c2) | right(c2) =< left(c1) | bottom(c1) =< top(c2) | bottom(c2) =< top(c1)).
}
