vocabulary {
    base: () -> Int
    n: () -> Int
    type Pos <: Int
    Pos_size: () -> Int
    type Range_n <: Int
    de_bruijn: Pos -> Int
    off: Pos * Range_n -> Pos
}

theory {
    // the sequence has length k^n, one position per possible length-n string
    Pos_size() = base() ^ n().

    // the sequence is over the alphabet of size k, symbols 0..k-1
    ! i in Pos: 0 =< de_bruijn(i) & de_bruijn(i) =< base() - 1.

    // the sequence is cyclic: the window of n symbols starting at position i wraps around the end
    ! i in Pos, j in Range_n: (i + j - 1 =< Pos_size() => off(i, j) = i + j - 1) & (i + j - 1 > Pos_size() => off(i, j) = i + j - 1 - Pos_size()).

    // every length-n string on A occurs exactly once as a substring: distinct cyclic windows differ somewhere
    ! i, i2 in Pos: i ~= i2 => ? j in Range_n: de_bruijn(off(i, j)) ~= de_bruijn(off(i2, j)).
}
