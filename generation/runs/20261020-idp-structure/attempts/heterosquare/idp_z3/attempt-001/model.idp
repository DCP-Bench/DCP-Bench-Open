vocabulary {
    type Range_n <: Int
    type Val <: Int
    Val_size: () -> Int
    x: Range_n * Range_n -> Val
    rowsum: Range_n -> Int
    colsum: Range_n -> Int
    diag1: () -> Int
    diag2: () -> Int
}

theory {
    // the elements are integers from 1 to n^2 (the type Val)
    Val_size() = n() * n().

    // every element is a distinct integer (a bijection onto 1..n^2)
    ! a in Range_n: ! b in Range_n: ! c in Range_n: ! d in Range_n:
        (a ~= c | b ~= d) => x(a, b) ~= x(c, d).

    // the sum of row a
    ! a in Range_n: rowsum(a) = sum{{ x(a, b) | b in Range_n }}.

    // the sum of column b
    ! b in Range_n: colsum(b) = sum{{ x(a, b) | a in Range_n }}.

    // the sum of the main diagonal
    diag1() = sum{{ x(i, j) | i, j in Range_n: i = j }}.

    // the sum of the anti-diagonal
    diag2() = sum{{ x(i, j) | i, j in Range_n: i + j = n() + 1 }}.

    // the sums of the rows, columns and diagonals are all different
    ! a in Range_n: ! b in Range_n: a ~= b => rowsum(a) ~= rowsum(b).
    ! a in Range_n: ! b in Range_n: a ~= b => colsum(a) ~= colsum(b).
    ! a in Range_n: ! b in Range_n: rowsum(a) ~= colsum(b).
    ! a in Range_n: rowsum(a) ~= diag1().
    ! a in Range_n: rowsum(a) ~= diag2().
    ! a in Range_n: colsum(a) ~= diag1().
    ! a in Range_n: colsum(a) ~= diag2().
    diag1() ~= diag2().
}
