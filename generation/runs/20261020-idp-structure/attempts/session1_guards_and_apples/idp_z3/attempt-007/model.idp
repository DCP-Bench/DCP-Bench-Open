vocabulary {
    type Pos <: Int
    Pos_size: () -> Int
    num_gates: () -> Int
    apples: Pos -> Int
}
theory {
    Pos_size() = num_gates() + 1.
    // apples[i] is the number before gate i (1-based position); the last is after the last gate
    ! i in Pos: 1 =< apples(i) & apples(i) =< 100000.
    // he bribes each guard with half of his apples plus one; the integer number of apples means the count is even
    ! i in Pos: i =< num_gates() => apples(i) % 2 = 0.
    ! i in Pos: i =< num_gates() => apples(i + 1) = apples(i) / 2 - 1.
    // after giving the apple to the girl he has none left, so he holds one apple after the last gate
    ! i in Pos: i = num_gates() + 1 => apples(i) = 1.
}
