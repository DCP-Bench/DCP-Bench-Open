vocabulary {
    num_gates: () -> Int
    type Pos <: Int                // num_gates + 1 positions: before each gate, then after the last
    Pos_size: () -> Int
    apples: Pos -> Int
}

theory {
    // the list has num_gates + 1 entries
    Pos_size() = num_gates() + 1.

    // after the last gate he holds the one apple he gives to the girl, and then none is left
    ! i in Pos: i = num_gates() + 1 => apples(i) = 1.

    // he bribes each guard with half of his apples plus one, as an integer number of apples:
    // with a apples he gives a div 2 + 1 and keeps a - (a div 2) - 1 apples, so before a gate
    // he holds 2 * b + 2 (a even) or 2 * b + 1 (a odd) apples, where b is what is left after it
    ! i in Pos: i < num_gates() => (apples(i) = 2 * apples(i + 1) + 2 | apples(i) = 2 * apples(i + 1) + 1).

    // he never holds a negative number of apples
    ! i in Pos: apples(i) >= 0.
}
