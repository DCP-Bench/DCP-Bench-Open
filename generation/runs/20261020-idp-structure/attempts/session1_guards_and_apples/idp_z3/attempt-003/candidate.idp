vocabulary {
    num_gates: () -> Int
    type Pos <: Int                // num_gates + 1 positions: before each gate, then after the last
    Pos_size: () -> Int
    apples: Pos -> Int
}

theory {
    // the list has num_gates + 1 entries
    Pos_size() = num_gates() + 1.

    // after the last gate he holds the one apple he gives to the girl, and then none is left
    ! i in Pos: i = num_gates() + 1 => apples(i) = 1.

    // he bribes each guard with half of his apples plus one, and has no knife, so the
    // number of apples must be even: before a gate he holds 2 * b + 2 apples,
    // where b is what is left after that gate
    ! i in Pos: i < num_gates() => apples(i) = 2 * apples(i + 1) + 2.

    // he never holds a negative number of apples
    ! i in Pos: apples(i) >= 0.
}
