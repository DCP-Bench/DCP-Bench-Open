vocabulary {
    num_gates: () -> Int
    type Pos <: Int                // num_gates + 1 positions: before each gate, then after the last
    Pos_size: () -> Int
    apples: Pos -> Int
}

theory {
    // the list has num_gates + 1 entries
    Pos_size() = num_gates() + 1.

    // after the last gate no apples are left
    ! i in Pos: i = num_gates() + 1 => apples(i) = 0.

    // he bribes each guard with half of his apples plus one, so before a gate he holds
    // 2 * (what is left after the gate) + 2 apples (the half must be an integer)
    ! i in Pos: i < num_gates() => apples(i) = 2 * apples(i + 1) + 2.

    // he never holds a negative number of apples
    ! i in Pos: apples(i) >= 0.
}
