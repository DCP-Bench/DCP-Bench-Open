vocabulary {
    type Range_max_val <: Int
    max_val: () -> Int
    min_a: () -> Int
    a: () -> Int
    b: () -> Int
    n: () -> Int
    p: () -> Int
    minimize: () -> Int
    // helper: y with b = y^2 and a = (y + 1)^2
    yv: () -> Range_max_val
    sq: Range_max_val -> Int
}
theory {
    // squares of the range, as a table
    { ! k in Range_max_val: sq(k) = k * k. }

    // a times b is a perfect square n^2, a - b is a prime p, b > 0:
    // a = x^2, b = y^2 with x = y + 1 (the only squares whose difference is prime)
    b() = sq(yv()).
    a() = sq(yv()) + 2 * yv() + 1.
    n() = sq(yv()) + yv().
    b() >= 1.
    a() = b() + p().
    p() = 2 * yv() + 1.

    // p is a prime number
    p() >= 2.
    ! d in Range_max_val: (d >= 2 & d < p() => p() % d ~= 0).

    // a is no less than the given minimum
    a() >= min_a().

    // minimize a
    minimize() = a().
}
