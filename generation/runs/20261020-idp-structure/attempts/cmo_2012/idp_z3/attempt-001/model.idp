vocabulary {
    type Range_max_val <: Int
    max_val: () -> Int
    min_a: () -> Int
    a: () -> Int
    b: () -> Int
    n: () -> Int
    p: () -> Int
    minimize: () -> Int
}
theory {
    // a - b is a prime number, with p the difference
    p() = a() - b().
    p() >= 2.
    ! d in Range_max_val: (d >= 2 & d < p() => p() % d ~= 0).

    // b should be larger than 0
    b() >= 1.

    // a times b is a perfect square n^2
    a() * b() = n() * n().
    n() >= 1.

    // a is no less than the given minimum, and all values stay within the bound
    a() >= min_a().
    a() =< max_val().
    b() =< max_val().
    n() =< max_val().

    // minimize a
    minimize() = a().
}
