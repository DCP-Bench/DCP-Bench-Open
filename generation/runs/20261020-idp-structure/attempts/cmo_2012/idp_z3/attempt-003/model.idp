vocabulary {
    type Range_max_val <: Int
    max_val: () -> Int
    min_a: () -> Int
    a: () -> Int
    b: () -> Int
    n: () -> Int
    p: () -> Int
    minimize: () -> Int
    // helper: the index y, with b = y^2, a = (y + 1)^2, p = 2y + 1
    yv: () -> Range_max_val
    // helper: squares and primality of 2k + 1, as tables over the range
    sq: Range_max_val -> Int
    oddprime: Range_max_val -> Bool
}
theory {
    // squares of the range, as a table
    { ! k in Range_max_val: sq(k) = k * k. }

    // p = 2k + 1 is a prime number, as a table over the range
    { ! k in Range_max_val: oddprime(k) <- 2 * k + 1 >= 2 & ~(? d in Range_max_val: d >= 2 & d < 2 * k + 1 & (2 * k + 1) % d = 0). }

    // a - b is a prime number p, with a times b a perfect square n^2 and b larger than 0:
    // a = x^2, b = y^2 with x = y + 1 (the only squares whose difference is prime)
    b() = sq(yv()).
    a() = sq(yv()) + 2 * yv() + 1.
    n() = sq(yv()) + yv().
    p() = 2 * yv() + 1.
    b() >= 1.
    a() = b() + p().
    oddprime(yv()).

    // a is no less than the given minimum
    a() >= min_a().

    // minimize a
    minimize() = a().
}
