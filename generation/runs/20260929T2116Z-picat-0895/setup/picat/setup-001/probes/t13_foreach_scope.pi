% instance: {"n": 3}
% limit: 5
import cp.
model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    X = new_list(N), X :: 0..9,
    foreach (I in 1..N)
        T = I * 2,
        X[I] #= T
    end,
    Total = 0,
    foreach (I in 1..N)
        Total := Total + X[I]
    end,
    S #= Total,
    Vars = X, Outputs = [x = X, s = S], Options = [].
