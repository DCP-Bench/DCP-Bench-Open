% instance: {"n": 3}
% limit: 200
import cp.
model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    X = new_list(N), X :: 0..3,
    X notin [1],
    table_notin({X[1], X[2]}, [{0, 0}, {2, 2}]),
    all_different_except_0(X),
    increasing_strict([X[2], X[3]]),
    decreasing([X[3], X[1]]),
    lex_lt([X[1], X[2]], [3, 3]),
    count(0, X, #=<, 1),
    (X[1] #= 3) #^ (X[3] #= 3),
    #~ (X[2] #= 2),
    P #= prod(X), Q #= X[3] div 2 + X[1] // 2,
    Vars = X, Outputs = [x = X, p = P, q = Q], Options = [].
