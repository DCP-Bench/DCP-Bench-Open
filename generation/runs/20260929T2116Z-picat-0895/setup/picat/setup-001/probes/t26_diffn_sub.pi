% instance: {"n": 3}
% limit: 200
import cp.
model(Data, Vars, Outputs, Options) =>
    [X1, X2, Y1, Y2] :: 0..1,
    diffn([[X1, Y1, 1, 1], [X2, Y2, 1, 1]]),
    X1 #= 0, Y1 #= 0,
    S = new_list(3), S :: 1..3,
    subcircuit(S),
    S[1] #!= 1,
    all_distinct([X2, Y2]),
    Vars = [X2, Y2] ++ S, Outputs = [x2 = X2, y2 = Y2, s = S], Options = [].
