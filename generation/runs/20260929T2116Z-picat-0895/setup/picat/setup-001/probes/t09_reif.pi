% instance: {"n": 3}
% limit: 100
import cp.
model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    X = new_list(N), X :: 0..2,
    sum([X[I] #= 2 : I in 1..N]) #= 1,
    (X[1] #= 0) #=> (X[2] #!= 0),
    B :: 0..1,
    B #<=> (X[3] #> X[2]),
    count(0, X) #>= 1,
    abs(X[1] - X[3]) #=< 1,
    X[1] mod 2 #= 0 #\/ X[2] #= 2,
    Vars = X ++ [B], Outputs = [x = X, b = B], Options = [].
