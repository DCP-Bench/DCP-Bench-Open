% instance: {"m": [[1,2,3],[4,5,6]]}
% limit: 5
import cp.
import util.
model(Data, Vars, Outputs, Options) =>
    M = Data.get(m),
    T = transpose(M),
    X :: [1, 3, 5],
    X #!= 3,
    Y = new_list(3), Y :: 1..3,
    nvalue(2, Y),
    Y[1] #= 1, Y[2] #= 1,
    Z #= sum([E : Row in M, E in Row, E > 2]),
    C #= cond(X #> 2, 10, 20),
    Vars = [X] ++ Y, Outputs = [t = T, x = X, y = Y, z = Z, c = C], Options = [].
