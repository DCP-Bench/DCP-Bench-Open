% Giant cat army riddle: start from 0 and extend the list by adding 5, adding 7
% or taking a square root, so that all 24 numbers are different integers of at
% most 60, the list holds 2 and later 10, and it ends with 14.
import cp.

model(_Data, Vars, Outputs, Options) =>
    % The riddle fixes these numbers; the instance carries no data.
    MaxValue = 60,
    N = 24,
    X = new_list(N),
    X :: 0..MaxValue,
    all_distinct(X),
    X[1] #= 0,
    X[N] #= 14,
    % each step adds 5, adds 7, or takes the square root: the allowed pairs of
    % consecutive numbers, as a table
    Moves = [{V, W} : V in 0..MaxValue, W in 0..MaxValue,
             (W == V + 5 ; W == V + 7 ; W * W == V)],
    foreach (I in 1..N-1)
        table_in({X[I], X[I + 1]}, Moves)
    end,
    % 2 comes before 10
    [Ix2, Ix10] :: 1..N,
    element(Ix2, X, 2),
    element(Ix10, X, 10),
    Ix2 #< Ix10,
    Vars = X,
    Outputs = [x = X],
    Options = [].
