% Contracting costs: six tradesmen are paid in pairs, and the payment to each
% pair is known. Find what each man charges.
import cp.

model(_Data, Vars, Outputs, Options) =>
    % The puzzle is fixed by the problem; the instance carries no data.
    Costs = [PaperHanger, Painter, Plumber, Electrician, Carpenter, Mason],
    Costs :: 1..5300,
    PaperHanger + Painter #= 1100,
    Painter + Plumber #= 1700,
    Plumber + Electrician #= 1100,
    Electrician + Carpenter #= 3300,
    Carpenter + Mason #= 5300,
    Mason + Painter #= 3200,
    Vars = Costs,
    Outputs = [paper_hanger = PaperHanger, painter = Painter, plumber = Plumber,
               electrician = Electrician, carpenter = Carpenter, mason = Mason],
    Options = [].
