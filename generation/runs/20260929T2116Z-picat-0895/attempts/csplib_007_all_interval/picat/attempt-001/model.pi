% All-interval series: order the pitch classes 0..n-1 so that the absolute
% differences between neighbours are also all different (they are 1..n-1).
import sat.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    X = new_list(N),
    X :: 0..N-1,
    Diffs = new_list(N - 1),
    Diffs :: 1..N-1,
    % every pitch class once, and every interval once
    all_different(X),
    all_different(Diffs),
    % the intervals are the distances between successive pitch classes
    foreach (I in 1..N-1)
        Diffs[I] #= abs(X[I + 1] - X[I])
    end,
    Vars = X ++ Diffs,
    Outputs = [x = X, diffs = Diffs],
    Options = [].
