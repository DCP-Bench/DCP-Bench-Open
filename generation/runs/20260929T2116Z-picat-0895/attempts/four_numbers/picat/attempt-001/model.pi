% Four numbers: given up to four distinct integers between 1 and 10, find three
% integers between 1 and 10 such that every given number is the sum of some
% subset of the three.
import cp.

model(Data, Vars, Outputs, Options) =>
    Numbers = Data.get(numbers),
    X = new_list(3),
    X :: 1..10,
    % use[i, j] = 1 when x[j] belongs to the subset that makes numbers[i]
    Use = new_array(len(Numbers), 3),
    Use :: 0..1,
    foreach (I in 1..len(Numbers))
        sum([Use[I, J] * X[J] : J in 1..3]) #= Numbers[I]
    end,
    Vars = X ++ vars(Use),
    Outputs = [x = X],
    Options = [].
