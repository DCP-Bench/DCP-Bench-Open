% Langford's problem L(2, k): arrange two copies of each of 1..k in a sequence of
% 2k numbers so that the two copies of i are i numbers apart (their positions
% differ by i + 1).
import sat.

model(Data, Vars, Outputs, Options) =>
    K = Data.get(k),
    % position[i] and position[k + i] are the positions, 1..2k, of the two copies of i
    Position = new_list(2 * K),
    Position :: 1..2 * K,
    all_different(Position),
    % sol[p] = the number at position p
    Sol = new_list(2 * K),
    Sol :: 1..K,
    foreach (I in 1..K)
        Position[K + I] #= Position[I] + I + 1,
        element(Position[I], Sol, I),
        element(Position[K + I], Sol, I)
    end,
    Vars = Position ++ Sol,
    Outputs = [sol = Sol],
    Options = [].
