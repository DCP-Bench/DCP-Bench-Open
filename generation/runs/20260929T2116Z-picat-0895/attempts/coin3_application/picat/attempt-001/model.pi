% Coins: choose how many coins of each denomination to carry, as few as
% possible, so that every amount from 1 up to (not including) the maximum can
% be paid exactly.
import sat.

model(Data, Vars, Outputs, Options) =>
    Denominations = Data.get(denominations),
    MaxAmount = Data.get(max_amount_to_pay),   % the largest amount is one less
    N = len(Denominations),
    % x[i] = the coins of denomination i carried
    X = new_list(N),
    X :: 0..MaxAmount,
    % used[a, i] = the coins of denomination i used to pay the amount a
    Used = new_array(MaxAmount - 1, N),
    Used :: 0..MaxAmount,
    foreach (A in 1..MaxAmount-1)
        % a payment uses no more coins of a kind than are carried ...
        foreach (I in 1..N)
            Used[A, I] #=< X[I]
        end,
        % ... and adds up to the amount
        sum([Denominations[I] * Used[A, I] : I in 1..N]) #= A
    end,
    Vars = X ++ vars(Used),
    Outputs = [x = X],
    Options = [$min(sum(X))].
