% A curious set of integers: 1, 3, 8 and 120 have the property that the product
% of any two is one less than a square. Find a fifth number (0 or more) that
% keeps the property.
import cp.

model(Data, Vars, Outputs, Options) =>
    N = Data.get(n),
    MaxVal = Data.get(max_val),
    X = new_list(N),
    X :: 0..MaxVal,
    all_different(X),
    X[1] #= 1,
    X[2] #= 3,
    X[3] #= 8,
    X[4] #= 120,
    % the product of any two different members plus one is a square
    foreach (I in 1..N, J in 1..N, I != J)
        Root :: 0..MaxVal,
        Root * Root #= X[I] * X[J] + 1
    end,
    Vars = X,
    Outputs = [number = X[N]],
    Options = [].
