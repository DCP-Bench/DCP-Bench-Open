% four_numbers: given a list of up to four distinct integers between 1 and 10,
% find a list of three integers x (each between 1 and 10) such that every
% given number can be generated by summing a subset of x.
% The output is x, a list of three integers.

:- lib(ic).

model(Instance, Xs, [x-Xs]) :-
    memberchk(numbers-Numbers, Instance),
    Xs = [X1, X2, X3],

    % the three integers x are between 1 and 10
    Xs :: 1..10,

    % every given number is the sum of a non-empty subset of x
    subsets(X1, X2, X3, Subsets),
    ( foreach(N, Numbers), param(Subsets) do
        covered(N, Subsets)
    ).

% the seven non-empty subsets of the three integers
subsets(X1, X2, X3,
        [[X1], [X2], [X3], [X1, X2], [X1, X3], [X2, X3], [X1, X2, X3]]).

% a given number N is covered when at least one subset sums to N
covered(N, Subsets) :-
    ( foreach(S, Subsets), foreach(B, Bs), param(N) do
        B :: 0..1,
        B <=> (sum(S) #= N)
    ),
    sum(Bs) #>= 1.
