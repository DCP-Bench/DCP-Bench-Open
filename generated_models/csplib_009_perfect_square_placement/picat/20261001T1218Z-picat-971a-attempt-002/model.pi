% Perfect square placement: pack squares of the given integer sides, without overlap and
% with sides parallel to the borders, into a big square of side `base` whose area they
% fill exactly. The output is the lower-left corner of every square, counted from 0.
% Encoded with sat: on the two largest instances (base 30 and base 112) it finds a placement
% in 2 s and 66 s, where cp needed 105 s or did not finish within 180 s.
import sat.

model(Data, Vars, Outputs, Options) =>
    Base = Data.get(base),            % side of the big square
    Sides = Data.get(sides),          % side of each small square
    N = len(Sides),
    % X[i], Y[i] = coordinates of square i; a square must lie inside the big square, so
    % its corner is at most base - side
    X = new_list(N),
    Y = new_list(N),
    foreach (I in 1..N)
        X[I] :: 0..Base - Sides[I],
        Y[I] :: 0..Base - Sides[I]
    end,
    % no two squares overlap
    diffn([[X[I], Y[I], Sides[I], Sides[I]] : I in 1..N]),
    % implied, from the squares filling the big square exactly: the squares crossing any
    % vertical line (resp. horizontal line) have sides adding up to exactly base
    foreach (Line in 0..Base - 1)
        sum([Sides[I] * (X[I] #=< Line #/\ Line #< X[I] + Sides[I]) : I in 1..N]) #= Base,
        sum([Sides[I] * (Y[I] #=< Line #/\ Line #< Y[I] + Sides[I]) : I in 1..N]) #= Base
    end,
    Vars = X ++ Y,
    Outputs = [x_coords = X, y_coords = Y],
    Options = [].
