// Hadamard matrix Legendre pairs: find two sequences A, B of l entries in {-1, +1}, l odd,
// whose periodic autocorrelations sum to -2 at every shift s = 1..m, with m = (l-1)/2.
vocabulary {
    l: () -> Int
    // the positions 1..l of each sequence
    type Range_l <: Int
    // the shifts 1..l (only shifts 1..m are constrained)
    // the entries take values -1 or +1
    type Sgn := {-1, 1}
    // a_1..a_l
    a: Range_l -> Sgn
    // b_1..b_l
    b: Range_l -> Sgn
    // wrap(i, s) is i + s taken mod l, in 1..l
    wrap: Range_l * Range_l -> Range_l
}
theory {
    // periodic index: i + s, wrapped around when it exceeds l
    ! i in Range_l, s in Range_l: wrap(i, s) = (if i + s =< l() then i + s else i + s - l()).

    // a product of two +-1 entries is +1 when they are equal and -1 when they differ,
    // so PAF(A, s) = (number of equal pairs) - (number of different pairs) = 2 * (number of equal pairs) - l.
    // PAF(A, s) + PAF(B, s) = -2 for every shift s = 1..m, with m = (l-1)/2, becomes
    // (equal pairs in A) + (equal pairs in B) = l - 1 for every s with 2s + 1 =< l.
    ! s in Range_l: 2 * s + 1 =< l() => #{i in Range_l: a(i) = a(wrap(i, s))} + #{i in Range_l: b(i) = b(wrap(i, s))} = l() - 1.

    // the linear constraint on A: a_1 + ... + a_l = 1
    sum{{ a(i) | i in Range_l }} = 1.

    // the linear constraint on B: b_1 + ... + b_l = 1
    sum{{ b(i) | i in Range_l }} = 1.
}
