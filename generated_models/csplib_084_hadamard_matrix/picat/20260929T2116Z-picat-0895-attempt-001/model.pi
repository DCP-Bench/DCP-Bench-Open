% Hadamard matrix via Legendre pairs: for an odd l, two sequences a and b of l
% entries, each +1 or -1 and adding up to 1, whose periodic autocorrelations
% satisfy PAF(a, s) + PAF(b, s) = -2 for s = 1..(l-1)/2, where
% PAF(a, s) = sum over i of a[i] * a[i + s], indices taken round the sequence.
import sat.

model(Data, Vars, Outputs, Options) =>
    L = Data.get(l),
    M = (L - 1) // 2,
    A = new_list(L),
    A :: [-1, 1],
    B = new_list(L),
    B :: [-1, 1],
    sum(A) #= 1,
    sum(B) #= 1,
    foreach (S in 1..M)
        % the position s places after i, going round
        Shift = [((I - 1 + S) mod L) + 1 : I in 1..L],
        sum([A[I] * A[Shift[I]] : I in 1..L]) + sum([B[I] * B[Shift[I]] : I in 1..L]) #= -2
    end,
    Vars = A ++ B,
    Outputs = [a = A, b = B],
    Options = [].
