language ESSENCE' 1.0
$ Fill the 9x9 crossfigure grid with digits so that every clued Across and Down answer equals its clue, printing the grid with 0 for black squares.
find M : matrix indexed by [int(1..9), int(1..9)] of int(0..9)
find across1, across4, across7, across8, across9, across10, across11, across13, across15, across17, across20, across23, across24, across25, across27, across28, across29, across30 : int(0..9999)
find down1, down2, down3, down4, down5, down6, down10, down12, down14, down16, down17, down18, down19, down20, down21, down22, down26, down28 : int(0..9999)

branching on [M]

such that
$ black squares hold 0, the empty or invalid cell value
M[1,5] = 0,
M[2,3] = 0,
M[2,7] = 0,
M[3,2] = 0,
M[3,5] = 0,
M[3,8] = 0,
M[4,5] = 0,
M[5,1] = 0,
M[5,3] = 0,
M[5,4] = 0,
M[5,5] = 0,
M[5,6] = 0,
M[5,7] = 0,
M[5,9] = 0,
M[6,5] = 0,
M[7,2] = 0,
M[7,5] = 0,
M[7,8] = 0,
M[8,3] = 0,
M[8,7] = 0,
M[9,5] = 0,
$ a number has no leading zero: the first square of every Across and Down answer holds a nonzero digit
M[1,1] != 0,
M[1,2] != 0,
M[1,4] != 0,
M[1,6] != 0,
M[1,8] != 0,
M[1,9] != 0,
M[2,1] != 0,
M[2,4] != 0,
M[2,8] != 0,
M[3,3] != 0,
M[3,6] != 0,
M[3,7] != 0,
M[4,1] != 0,
M[4,2] != 0,
M[4,6] != 0,
M[4,8] != 0,
M[6,1] != 0,
M[6,3] != 0,
M[6,4] != 0,
M[6,6] != 0,
M[6,7] != 0,
M[6,9] != 0,
M[7,3] != 0,
M[7,6] != 0,
M[8,1] != 0,
M[8,2] != 0,
M[8,4] != 0,
M[8,8] != 0,
M[9,1] != 0,
M[9,6] != 0,
$ each Across answer is the number read from its squares, left to right
across1 = 1000 * M[1,1] + 100 * M[1,2] + 10 * M[1,3] + M[1,4],
across4 = 1000 * M[1,6] + 100 * M[1,7] + 10 * M[1,8] + M[1,9],
across7 = 10 * M[2,1] + M[2,2],
across8 = 100 * M[2,4] + 10 * M[2,5] + M[2,6],
across9 = 10 * M[2,8] + M[2,9],
across10 = 10 * M[3,3] + M[3,4],
across11 = 10 * M[3,6] + M[3,7],
across13 = 1000 * M[4,1] + 100 * M[4,2] + 10 * M[4,3] + M[4,4],
across15 = 1000 * M[4,6] + 100 * M[4,7] + 10 * M[4,8] + M[4,9],
across17 = 1000 * M[6,1] + 100 * M[6,2] + 10 * M[6,3] + M[6,4],
across20 = 1000 * M[6,6] + 100 * M[6,7] + 10 * M[6,8] + M[6,9],
across23 = 10 * M[7,3] + M[7,4],
across24 = 10 * M[7,6] + M[7,7],
across25 = 10 * M[8,1] + M[8,2],
across27 = 100 * M[8,4] + 10 * M[8,5] + M[8,6],
across28 = 10 * M[8,8] + M[8,9],
across29 = 1000 * M[9,1] + 100 * M[9,2] + 10 * M[9,3] + M[9,4],
across30 = 1000 * M[9,6] + 100 * M[9,7] + 10 * M[9,8] + M[9,9],
$ each Down answer is the number read from its squares, top to bottom
down1 = 1000 * M[1,1] + 100 * M[2,1] + 10 * M[3,1] + M[4,1],
down2 = 10 * M[1,2] + M[2,2],
down3 = 1000 * M[1,4] + 100 * M[2,4] + 10 * M[3,4] + M[4,4],
down4 = 1000 * M[1,6] + 100 * M[2,6] + 10 * M[3,6] + M[4,6],
down5 = 10 * M[1,8] + M[2,8],
down6 = 1000 * M[1,9] + 100 * M[2,9] + 10 * M[3,9] + M[4,9],
down10 = 10 * M[3,3] + M[4,3],
down12 = 10 * M[3,7] + M[4,7],
down14 = 100 * M[4,2] + 10 * M[5,2] + M[6,2],
down16 = 100 * M[4,8] + 10 * M[5,8] + M[6,8],
down17 = 1000 * M[6,1] + 100 * M[7,1] + 10 * M[8,1] + M[9,1],
down18 = 10 * M[6,3] + M[7,3],
down19 = 1000 * M[6,4] + 100 * M[7,4] + 10 * M[8,4] + M[9,4],
down20 = 1000 * M[6,6] + 100 * M[7,6] + 10 * M[8,6] + M[9,6],
down21 = 10 * M[6,7] + M[7,7],
down22 = 1000 * M[6,9] + 100 * M[7,9] + 10 * M[8,9] + M[9,9],
down26 = 10 * M[8,2] + M[9,2],
down28 = 10 * M[8,8] + M[9,8],
$ 1 Across: 27 across times two
across1 = 2 * across27,
$ 4 Across: 4 down plus seventy-one
across4 = down4 + 71,
$ 7 Across: 18 down plus four
across7 = down18 + 4,
$ 8 Across: 6 down divided by sixteen (an exact quotient)
down6 = 16 * across8,
$ 9 Across: 2 down minus eighteen
across9 = down2 - 18,
$ 10 Across: dozen in six gross, i.e. 6 * 144 / 12 = 72 dozens
across10 = 72,
$ 11 Across: 5 down minus seventy
across11 = down5 - 70,
$ 13 Across: 26 down times 23 across
across13 = down26 * across23,
$ 15 Across: 6 down minus 350
across15 = down6 - 350,
$ 17 Across: 25 across times 23 across
across17 = across25 * across23,
$ 20 Across: a square number
exists k : int(1..99) . k * k = across20,
$ 23 Across: a prime number
forAll k : int(2..97) . (k < across23) -> across23 % k != 0,
$ 24 Across: a square number
exists k : int(1..9) . k * k = across24,
$ 25 Across: 20 across divided by seventeen (an exact quotient)
across20 = 17 * across25,
$ 27 Across: 6 down divided by four (an exact quotient)
down6 = 4 * across27,
$ 28 Across: four dozen
across28 = 48,
$ 29 Across: seven gross
across29 = 1008,
$ 30 Across: 22 down plus 450
across30 = down22 + 450,
$ 1 Down: 1 across plus twenty-seven
down1 = across1 + 27,
$ 2 Down: five dozen
down2 = 60,
$ 3 Down: 30 across plus 888
down3 = across30 + 888,
$ 4 Down: two times 17 across
down4 = 2 * across17,
$ 5 Down: 29 across divided by twelve (an exact quotient)
across29 = 12 * down5,
$ 6 Down: 28 across times 23 across
down6 = across28 * across23,
$ 10 Down: 10 across plus four
down10 = across10 + 4,
$ 12 Down: three times 24 across
down12 = 3 * across24,
$ 14 Down: 13 across divided by sixteen (an exact quotient)
across13 = 16 * down14,
$ 16 Down: 28 down times fifteen
down16 = 15 * down28,
$ 17 Down: 13 across minus 399
down17 = across13 - 399,
$ 18 Down: 29 across divided by eighteen (an exact quotient)
across29 = 18 * down18,
$ 19 Down: 22 down minus ninety-four
down19 = down22 - 94,
$ 20 Down: 20 across minus nine
down20 = across20 - 9,
$ 21 Down: 25 across minus fifty-two
down21 = across25 - 52,
$ 22 Down: 20 down times six
down22 = 6 * down20,
$ 26 Down: five times 24 across
down26 = 5 * across24,
$ 28 Down: 21 down plus twenty-seven
down28 = down21 + 27
