% Best host: seat six guests round a table so that everyone sits only next to
% guests they are willing to sit next to.
import cp.

model(_Data, Vars, Outputs, Options) =>
    % The puzzle is fixed by the problem; the instance carries no data.
    % prefs[g] = the guests guest g will sit next to; 0 Andrew, 1 Betty, 2 Cara,
    % 3 Dave, 4 Erica, 5 Frank
    Prefs = [[3, 5], [2, 4], [1, 5], [0, 4], [1, 3], [0, 2]],
    N = 6,
    % x[i] = the guest in seat i, going round the table
    X = new_list(N),
    X :: 0..N-1,
    all_different(X),
    % Each guest is willing to sit next to both neighbours. As a table: the pairs
    % (guest, neighbour) that are allowed.
    Allowed = [{G, H} : G in 0..N-1, H in Prefs[G + 1]],
    foreach (I in 1..N)
        table_in({X[I], X[(I mod N) + 1]}, Allowed),
        table_in({X[(I mod N) + 1], X[I]}, Allowed)
    end,
    Vars = X,
    Outputs = [x = X],
    Options = [].
