// Seating of six guests around a round dinner table: every pair of
// neighbouring guests must get along.
vocabulary {
    type Seat := {0..5}     // the six seats around the table, in seating order
    type Guest := {0..5}    // 0 Andrew, 1 Betty, 2 Cara, 3 Dave, 4 Erica, 5 Frank
    x: Seat -> Guest        // declared output: x(s) is the guest in seat s
    gets_along: Guest * Guest -> Bool
}
theory {
    // the guests who get along with each other, from the problem statement
    // (closed definition: any pair not listed does not get along)
    {
        // Andrew sits next to Dave and Frank
        gets_along(0,3). gets_along(3,0). gets_along(0,5). gets_along(5,0).
        // Betty sits next to Cara and Erica
        gets_along(1,2). gets_along(2,1). gets_along(1,4). gets_along(4,1).
        // Cara sits next to Betty and Frank
        gets_along(2,5). gets_along(5,2).
        // Dave sits next to Andrew and Erica
        gets_along(3,4). gets_along(4,3).
    }

    // each guest is seated exactly once
    ! s, t in Seat: s ~= t => x(s) ~= x(t).

    // neighbouring guests around the table must get along (seats 0 to 5 form a ring)
    gets_along(x(0), x(1)).
    gets_along(x(1), x(2)).
    gets_along(x(2), x(3)).
    gets_along(x(3), x(4)).
    gets_along(x(4), x(5)).
    gets_along(x(5), x(0)).
}
