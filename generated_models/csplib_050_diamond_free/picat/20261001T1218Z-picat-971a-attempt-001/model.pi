% Diamond-free graph on N vertices, given by its 0/1 adjacency matrix: no isolated
% vertex, every vertex degree divisible by 3, the sum of the degrees divisible by 12,
% and no four vertices carry five or more of the six possible edges between them.
import cp.

model(Data, Vars, Outputs, Options) =>
    N = Data.get('N'),               % number of vertices
    % Matrix[u, v] = 1 if u and v are adjacent
    Matrix = new_array(N, N),
    Matrix :: 0..1,
    % the graph is simple: no vertex is adjacent to itself
    foreach (U in 1..N)
        Matrix[U, U] #= 0
    end,
    % the graph is undirected: u adjacent to v means v adjacent to u
    foreach (U in 1..N - 1, V in U + 1..N)
        Matrix[U, V] #= Matrix[V, U]
    end,
    % every vertex has a degree that is positive and a multiple of 3: degree = 3 * k
    Deg = new_list(N),
    Deg :: 1..N - 1,
    Mult = new_list(N),
    Mult :: 1..(N - 1) // 3,
    foreach (U in 1..N)
        Deg[U] #= sum([Matrix[U, V] : V in 1..N]),
        Deg[U] #= 3 * Mult[U]
    end,
    % the sum of the degrees (twice the number of edges) is a multiple of 12
    Blocks :: 1..N * (N - 1) // 12,
    sum(Deg) #= 12 * Blocks,
    % diamond-free: any four vertices have at most four edges between them
    foreach (A in 1..N - 3, B in A + 1..N - 2, C in B + 1..N - 1, D in C + 1..N)
        Matrix[A, B] + Matrix[A, C] + Matrix[A, D] + Matrix[B, C] + Matrix[B, D] + Matrix[C, D] #=< 4
    end,
    Vars = Matrix,
    Outputs = [matrix = Matrix],
    Options = [].
