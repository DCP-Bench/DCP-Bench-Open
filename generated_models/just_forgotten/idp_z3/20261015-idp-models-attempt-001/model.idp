// Just Forgotten: find Joe's account number, a permutation of the digits 0 to n-1
vocabulary {
    type Guess <: Int                   // one entry per set of digits Joe tried, sized from the data
    type Pos <: Int                     // digit positions 0 to n-1, sized from the data
    sets: Guess * Pos -> Int            // sets[g][p]: the digit in position p of set g
    num_correct_digits: () -> Int       // how many digits of each set are in their correct position
    x: Pos -> Pos                       // Joe's account number: the digit at each position
}
theory {
    // he remembered that it had all the digits from 0 to n-1 in some order
    ! p1, p2 in Pos: p1 ~= p2 => x(p1) ~= x(p2).

    // in each set just a specific number of the digits were in their correct position
    ! g in Guess: #{ p in Pos: x(p) = sets(g, p) } = num_correct_digits().
}
