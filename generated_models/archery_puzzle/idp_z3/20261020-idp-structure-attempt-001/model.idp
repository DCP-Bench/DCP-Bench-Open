vocabulary {
    type T <: Int                       // one index per target (sized from targets)
    target_score: () -> Int
    targets: T -> Int
    hits: T -> Int                      // declared output: hits on each target
    total: () -> Int
    minimize: () -> Int
}
theory {
    // the archer shoots any non-negative number of arrows at each target
    ! i in T: 0 =< hits(i).
    // bound the hit counts by the target score
    ! i in T: hits(i) =< target_score().
    // total score is the sum of hits times target values
    total() = sum{{ (targets(i) * hits(i)) | i in T }}.
    // how close the total comes to the target score
    minimize() = if total() =< target_score() then target_score() - total() else total() - target_score().
}
