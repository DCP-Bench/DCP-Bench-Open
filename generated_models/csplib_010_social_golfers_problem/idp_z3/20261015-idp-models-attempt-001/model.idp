// Social golfers: golfers play once a week in groups of a fixed size, and no
// two golfers play in the same group more than once.
vocabulary {
    // golfers: the number of groups times the group size
    type Golfer := {0..${n_groups*group_size-1}}
    // one week of play per entry of the schedule
    type Week := {0..${n_weeks-1}}
    // groups held each week
    type Group := {0..${n_groups-1}}
    group_size: () -> Int
    // declared output: the group of each golfer in each week
    assign: Golfer * Week -> Group
}
theory {
    // each group holds exactly group_size golfers in every week
    ! w in Week, g in Group: #{ p in Golfer: assign(p, w) = g } = group_size().
    // no golfer plays in the same group as another golfer more than once
    ! p1, p2 in Golfer: p1 < p2 => #{ w in Week: assign(p1, w) = assign(p2, w) } =< 1.
}
