language ESSENCE' 1.0
$ Movie scheduling: choose the largest set of movie offers whose filming intervals do not overlap, each interval running from its first to its last filming day.
given movies_2_dim1 : int
letting n_movies = movies_2_dim1
$ first filming day of each movie (the second column of the movies list)
given movies_2 : matrix indexed by [int(1..n_movies)] of int
$ last filming day of each movie (the third column of the movies list)
given movies_3 : matrix indexed by [int(1..n_movies)] of int
find selected_movies : matrix indexed by [int(1..n_movies)] of bool
find n_selected : int(0..n_movies)

branching on [selected_movies]
maximising n_selected
such that
$ the number of movies accepted is the number of selected movies
n_selected = (sum i : int(1..n_movies) . selected_movies[i]),
$ two movies whose filming intervals overlap cannot both be accepted; intervals overlap when each starts on or before the day the other ends
forAll i, j : int(1..n_movies) . (i < j /\ movies_2[i] <= movies_3[j] /\ movies_2[j] <= movies_3[i]) -> (!selected_movies[i] \/ !selected_movies[j])
