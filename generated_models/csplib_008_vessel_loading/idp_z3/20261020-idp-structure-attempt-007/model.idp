vocabulary {
    type I <: Int
    type C <: Int
    deck_length: () -> Int
    deck_width: () -> Int
    length: I -> Int
    width: I -> Int
    classes: I -> Int
    separation: C * C -> Int
    left: I -> Int
    right: I -> Int
    top: I -> Int
    bottom: I -> Int
    rot: I -> Bool
    sep: I * I -> Int
}
theory {
    // containers are positioned parallel to the sides of the deck (may be turned by 90 degrees)
    ! i in I: 0 =< left(i) & left(i) =< deck_width().
    ! i in I: 0 =< right(i) & right(i) =< deck_width().
    ! i in I: 0 =< bottom(i) & bottom(i) =< deck_length().
    ! i in I: 0 =< top(i) & top(i) =< deck_length().
    ! i in I: ~rot(i) => right(i) - left(i) = width(i) & top(i) - bottom(i) = length(i).
    ! i in I: rot(i) => right(i) - left(i) = length(i) & top(i) - bottom(i) = width(i).

    // minimum separation between the classes of two containers
    ! i, j in I: sep(i, j) = sum{{ separation(a, b) | a, b in C: classes(i) = a + 1 & classes(j) = b + 1 }}.

    // without overlapping, and without violating any of the separation constraints
    ! i, j in I: i < j => (right(i) + sep(i, j) =< left(j) | right(j) + sep(i, j) =< left(i)
        | top(i) + sep(i, j) =< bottom(j) | top(j) + sep(i, j) =< bottom(i)).
}
