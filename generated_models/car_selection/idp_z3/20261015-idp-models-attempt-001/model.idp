// Assign participants to cars to maximize the total number of assignments.
vocabulary {
    type P <: Int                               // participants, sized from the assignment matrix rows
    type C <: Int                               // cars, sized from the assignment matrix columns
    possible_assignments: P * C -> Int          // 1 if the participant is interested in the car, 0 otherwise
    assignments: P * C -> Bool                  // declared output: participant p is assigned to car c
    maximize: () -> Int                         // objective: maximize the total number of assignments
}
theory {
    // each participant may be interested in a subset of available cars:
    // a participant is only assigned to a car they are interested in
    ! p in P, c in C: assignments(p, c) => possible_assignments(p, c) = 1.

    // each participant is assigned to at most one car
    ! p in P: #{ c in C: assignments(p, c) } =< 1.

    // each car is assigned to at most one participant
    ! c in C: #{ p in P: assignments(p, c) } =< 1.

    // maximize the total number of assignments
    maximize() = sum{{ 1 | p in P, c in C: assignments(p, c) }}.
}
