// N-Puzzle: trace the steps from the start picture to the end picture, with N_STEPS states including start and end.
vocabulary {
    // Grid rows and columns, sized from the instance matrices.
    type Row <: Int
    type Col <: Int
    // One state per step, 0-based, N_STEPS states in total.
    type Step := {0..${N_STEPS-1}}

    N_STEPS: () -> Int
    puzzle_start: Row * Col -> Int
    puzzle_end: Row * Col -> Int

    // Declared output: the state of the puzzle at each step. Tile 0 is the empty square.
    steps: Step * Row * Col -> Int

    // Number of cells in the grid.
    ncells: () -> Int
}
theory {
    // The number of cells is the number of rows times the number of columns.
    ncells() = #{ r in Row, c in Col: r = r }.

    // Every tile value lies between 0 and the number of cells minus one.
    ! s in Step, r in Row, c in Col: steps(s, r, c) >= 0 & steps(s, r, c) =< ncells() - 1.

    // Each tile appears exactly once in every state: distinct cells hold distinct values.
    ! s in Step, r1 in Row, c1 in Col, r2 in Row, c2 in Col:
        (r1 ~= r2 | c1 ~= c2) => steps(s, r1, c1) ~= steps(s, r2, c2).

    // The first state is the start state of the puzzle.
    ! s in Step, r in Row, c in Col: s = 0 => steps(s, r, c) = puzzle_start(r, c).

    // The last state is the end state of the puzzle.
    ! s in Step, r in Row, c in Col: s = N_STEPS() - 1 => steps(s, r, c) = puzzle_end(r, c).

    // Each move slides one tile into the empty square: the empty square moves to a neighbouring cell
    // and the tile on that neighbouring cell moves into the old empty square; all other cells stay the same.
    ! s in Step, r in Row, c in Col:
        (s < N_STEPS() - 1 & steps(s, r, c) = 0) =>
        (? r2 in Row: ? c2 in Col:
            abs(r2 - r) + abs(c2 - c) = 1
            & steps(s + 1, r, c) = steps(s, r2, c2)
            & steps(s + 1, r2, c2) = 0
            & (! r3 in Row, c3 in Col:
                ((r3 ~= r | c3 ~= c) & (r3 ~= r2 | c3 ~= c2)) => steps(s + 1, r3, c3) = steps(s, r3, c3))).
}
