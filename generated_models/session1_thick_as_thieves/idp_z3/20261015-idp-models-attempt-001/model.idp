// Six suspects of a robbery: which of them are guilty, given their statements.
// Innocent suspects tell the truth, guilty suspects lie.
vocabulary {
    artie: () -> Bool                  // declared output: Artie is guilty
    bill: () -> Bool                   // declared output: Bill is guilty
    crackitt: () -> Bool               // declared output: Crackitt is guilty
    dodgy: () -> Bool                  // declared output: Dodgy is guilty
    edgy: () -> Bool                   // declared output: Edgy is guilty
    fingers: () -> Bool                // declared output: Fingers is guilty
    guilty_count: () -> Int            // number of guilty suspects
}
theory {
    // the getaway car was barely big enough to hold two, so at most two are guilty
    // (at least four of the six are innocent)
    guilty_count() = (if artie() then 1 else 0) + (if bill() then 1 else 0) + (if crackitt() then 1 else 0)
                   + (if dodgy() then 1 else 0) + (if edgy() then 1 else 0) + (if fingers() then 1 else 0).
    guilty_count() =< 2.

    // Artie: "It wasn't me." A suspect is guilty exactly when the statement is false.
    artie() <=> ~(~artie()).

    // Bill: "Crackitt was in it up to his neck."
    bill() <=> ~crackitt().

    // Crackitt: "No I wasn't."
    crackitt() <=> ~(~crackitt()).

    // Dodgy: "If Crackitt did it, Bill did it with him."
    dodgy() <=> ~(crackitt() => bill()).

    // Edgy: "Nobody did it alone." Read as: the number of guilty suspects is not exactly one.
    edgy() <=> (guilty_count() = 1).

    // Fingers: "That's right: it was Artie and Dodgy together."
    fingers() <=> ~(artie() & dodgy()).
}
