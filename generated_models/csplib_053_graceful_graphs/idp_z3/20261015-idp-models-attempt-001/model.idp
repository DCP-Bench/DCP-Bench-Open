// Graceful labelling of a graph with q edges (csplib 053): every node gets a unique label from {0, ..., q},
// each edge xy gets the label |f(x) - f(y)|, and all edge labels are different.
vocabulary {
    type Node := {1..${n}}          // the n nodes; instance node ids are 0-based, so node k is element k+1
    type Label := {0..${m}}         // labels run over {0, ..., q}, q = number of edges
    type E <: Int                   // the edges, sized from the graph field
    type End <: Int                 // the two endpoints of an edge, sized from the graph field
    graph: E * End -> Int           // instance: endpoints (0-based node ids) of each edge
    nodes: Node -> Label            // declared output: the label of each node
    edges: E -> Label               // declared output: the label of each edge
}
theory {
    // each node gets a unique label
    ! a, b in Node: a ~= b => nodes(a) ~= nodes(b).

    // each edge xy is labelled with |f(x) - f(y)|
    ! e in E: edges(e) = abs(nodes(graph(e, 0) + 1) - nodes(graph(e, 1) + 1)).

    // the edge labels are all different
    ! e1, e2 in E: e1 ~= e2 => edges(e1) ~= edges(e2).
}
