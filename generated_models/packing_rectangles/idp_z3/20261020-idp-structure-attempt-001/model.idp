vocabulary {
    type I <: Int
    widths: I -> Int
    heights: I -> Int
    pos_x: I -> Int
    pos_y: I -> Int
    total_x: () -> Int
    total_y: () -> Int
    minimize: () -> Int
}

theory {
    // each item lies within the larger rectangle, starting from 0
    ! i in I: 0 =< pos_x(i) & pos_x(i) + widths(i) =< total_x().
    ! i in I: 0 =< pos_y(i) & pos_y(i) + heights(i) =< total_y().

    // no two items overlap
    ! i, j in I: i < j => (pos_x(i) + widths(i) =< pos_x(j) | pos_x(j) + widths(j) =< pos_x(i) | pos_y(i) + heights(i) =< pos_y(j) | pos_y(j) + heights(j) =< pos_y(i)).

    // the larger rectangle is no bigger than the items placed side by side or stacked
    total_x() =< sum{{ widths(i) | i in I }}.
    total_y() =< sum{{ heights(i) | i in I }}.

    // minimize the total area of the larger rectangle
    minimize() = total_x() * total_y().
}
