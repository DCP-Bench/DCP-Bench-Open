// Buy 100 fruits for 100 dollars, buying every type of fruit, and keeping the
// quantities of bananas and apples at a minimum.
vocabulary {
    // Declared outputs: the quantity of each fruit.
    bananas: () -> Int
    oranges: () -> Int
    mangoes: () -> Int
    apples: () -> Int
    // Objective: the quantity of bananas and apples.
    minimize: () -> Int
}
theory {
    // all types of fruits need to be purchased
    bananas() >= 1 & oranges() >= 1 & mangoes() >= 1 & apples() >= 1.

    // 100 fruits in total
    bananas() + oranges() + mangoes() + apples() = 100.

    // 100 dollars in total: five bananas cost 3, seven oranges cost 5, nine mangoes cost 7,
    // three apples cost 9. Each price is scaled by 315 (the least common multiple of 5, 7, 9, 3)
    // so the arithmetic stays in integers: 189 per banana, 225 per orange, 245 per mango, 945 per apple.
    189 * bananas() + 225 * oranges() + 245 * mangoes() + 945 * apples() = 31500.

    // the objective is the quantity of bananas and apples, which should be a minimum
    minimize() = bananas() + apples().
}
