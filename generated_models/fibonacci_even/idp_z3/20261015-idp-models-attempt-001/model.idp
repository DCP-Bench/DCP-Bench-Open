// Sum of the even-valued Fibonacci terms, starting with 1 and 2, that do not exceed four million.
vocabulary {
    // the position of a term in the sequence; the 33rd term (5702887) already exceeds four million
    type Pos := {1..33}
    // fib(i) is the i-th term of the sequence
    fib: Pos -> Int
    // the sum of the even-valued terms that do not exceed four million
    res: () -> Int
}
theory {
    // The sequence starts with 1 and 2.
    fib(1) = 1.
    fib(2) = 2.

    // Each new term is generated by adding the previous two terms.
    ! i in Pos: i > 2 => fib(i) = fib(i - 1) + fib(i - 2).

    // Print the sum of all the even-valued terms in the sequence which do not exceed four million (res).
    res() = sum{{ fib(i) | i in Pos: fib(i) =< 4000000 & fib(i) % 2 = 0 }}.
}
