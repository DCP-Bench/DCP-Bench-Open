vocabulary {
    type J <: Int                   // jobs, sized from durations_data
    type R <: Int                   // resources, sized from resource_capacities_data
    type K <: Int                   // the two columns of a successor link
    type L <: Int                   // successor links, sized from successors_link_data

    durations_data: J -> Int
    resource_capacities_data: R -> Int
    resource_needs_data: J * R -> Int
    successors_link_data: L * K -> Int

    start_time: J -> Int            // declared output
    precedes: J * J -> Bool         // precedence between two jobs, read from the links
    minimize: () -> Int
}

theory {
    // a job pair is a precedence when some link names it
    { ! a, b in J: precedes(a, b) <- ? l in L: successors_link_data(l, 0) = a & successors_link_data(l, 1) = b. }

    // jobs start at or after time 0 and within the total duration
    ! j in J: 0 =< start_time(j) & start_time(j) =< sum{{ durations_data(k) | k in J }}.

    // each successor starts after its predecessor finishes
    ! a, b in J: precedes(a, b) => (start_time(a) + durations_data(a)) =< start_time(b).

    // at every job start, the needs of the running jobs fit in each resource capacity
    ! j in J: ! r in R: resource_needs_data(j, r) + sum{{ (resource_needs_data(k, r)) | k in J: k ~= j & start_time(k) =< start_time(j) & start_time(j) < (start_time(k) + durations_data(k)) }} =< resource_capacities_data(r).

    // minimize the makespan, the latest finish time of any job
    minimize() = max{ (start_time(j) + durations_data(j)) | j in J }.
}
