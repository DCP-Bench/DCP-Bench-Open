vocabulary {
    type Range_n <: Int            // elements are 1..n
    n: () -> Int
    type Tri <: Int                // one index per triple
    Tri_size: () -> Int            // n(n-1)/6 triples
    sets: Tri * Range_n -> Bool    // declared output: sets(t, e) iff element e is in triple t
}

theory {
    // the number of triples is n(n-1)/6
    Tri_size() = n() * (n() - 1) / 6.

    // each triple consists of exactly three distinct elements
    ! t in Tri: #{ e in Range_n: sets(t, e) } = 3.

    // any two distinct triples have at most one common element
    ! t1 in Tri: ! t2 in Tri: t1 ~= t2 => #{ e in Range_n: sets(t1, e) & sets(t2, e) } =< 1.
}
