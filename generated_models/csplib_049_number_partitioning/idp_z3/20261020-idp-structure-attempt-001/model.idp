vocabulary {
    type Range_n <: Int
    n: () -> Int
    type Half <: Int
    Half_size: () -> Int
    A: Half -> Range_n
    B: Half -> Range_n
    inA: Range_n -> Bool
}
theory {
    // the sets A and B have the same cardinality, N / 2 each
    Half_size() = n() / 2.

    // A is the set of its entries: inA holds exactly for the numbers listed in A
    { ! k in Range_n: inA(k) <- ? i in Half: A(i) = k. }

    // the entries of A are distinct, listed in ascending order
    ! i, j in Half: i ~= j => A(i) ~= A(j).
    ! i, j in Half: i < j => A(i) < A(j).

    // the entries of B are distinct, listed in ascending order
    ! i, j in Half: i ~= j => B(i) ~= B(j).
    ! i, j in Half: i < j => B(i) < B(j).

    // A and B are disjoint
    ! i in Half: ~inA(B(i)).

    // every number 1..N is in A or in B
    ! k in Range_n: inA(k) | (? j in Half: B(j) = k).

    // the sums of A and B are equal
    sum{{ k | k in Range_n: inA(k) }} = sum{{ k | k in Range_n: ~inA(k) }}.

    // the sums of squares of A and B are equal
    sum{{ (k * k) | k in Range_n: inA(k) }} = sum{{ (k * k) | k in Range_n: ~inA(k) }}.
}
