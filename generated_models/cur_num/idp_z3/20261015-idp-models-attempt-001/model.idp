// Curious number: find a number between 1 and 10000, other than 48, such that adding 1 to it
// gives a square number and adding 1 to its half also gives a square number.
vocabulary {
    // square roots needed for a number up to 10000 plus one (the largest is 100)
    type Root := {0..100}
    peculiar: () -> Int
    // the half of the number, which must be a whole number
    half: () -> Int
}
theory {
    // the number is between 1 and 10000
    1 =< peculiar() & peculiar() =< 10000.
    // the number is another number, not 48 itself
    peculiar() ~= 48.
    // the number is even, so that its half is a whole number
    2 * half() = peculiar().
    // adding 1 to the number gives a square number
    ? r in Root: r * r = peculiar() + 1.
    // adding 1 to its half also gives a square number
    ? s in Root: s * s = half() + 1.
}
