// Find an n x n magic square: distinct integers 1..n^2 with equal row, column and diagonal sums.
vocabulary {
    // rows and columns of the grid, numbered 1..n
    type Idx := {1..${n}}
    // the integers placed in the grid, 1..n^2
    type Val := {1..${n*n}}
    // square[r, c] = integer in row r, column c
    square: Idx * Idx -> Val
}
theory {
    // each cell contains a different integer from 1 to n^2
    ! r1, c1, r2, c2 in Idx: (r1 ~= r2 | c1 ~= c2) => square(r1, c1) ~= square(r2, c2).

    // the sum of the integers in each row is n(n^2+1)/2
    ! r in Idx: sum{{ square(r, c) | c in Idx: true }} = ${n*(n*n+1)//2}.

    // the sum of the integers in each column is n(n^2+1)/2
    ! c in Idx: sum{{ square(r, c) | r in Idx: true }} = ${n*(n*n+1)//2}.

    // the sum of the integers in the main diagonal is n(n^2+1)/2
    sum{{ square(i, i) | i in Idx: true }} = ${n*(n*n+1)//2}.

    // the sum of the integers in the other diagonal is n(n^2+1)/2
    sum{{ square(i, ${n+1} - i) | i in Idx: true }} = ${n*(n*n+1)//2}.
}
