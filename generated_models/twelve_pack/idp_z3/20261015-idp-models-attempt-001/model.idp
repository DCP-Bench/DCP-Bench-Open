// Twelve-pack problem: pick how many packs of each size to buy so that the total meets or exceeds a target number of items, as close to the target as possible.
vocabulary {
    type I <: Int                          // pack sizes, sized from the packs field
    type Count := {0..${target}}           // number of packs of one size, at most the target
    packs: I -> Int                        // instance data: the size of each pack
    target: () -> Int                      // instance data: the target number of items
    counts: I -> Count                     // declared output: number of packs of each size
    minimize: () -> Int                    // objective: items over the target
}
theory {
    // the total number of items is at least the target
    sum{{ (packs(i) * counts(i)) | i in I }} >= target().

    // minimize the number of items above the target: the closest combination that meets or exceeds the target
    minimize() = sum{{ (packs(i) * counts(i)) | i in I }} - target().
}
