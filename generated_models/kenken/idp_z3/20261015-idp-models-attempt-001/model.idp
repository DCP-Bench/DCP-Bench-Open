// KenKen: fill the n x n grid with the digits 1..n so that every row and every column holds each digit once, and every cage reaches its target.
vocabulary {
    // grid rows, columns and digits, sized by the instance's n
    type Row := {1..${n}}
    // cage index, sized from the cage list
    type I <: Int
    // position of a cell within a cage, sized from the largest cage
    type J <: Int
    // coordinate of a cell: 0 is the row, 1 is the column
    type K <: Int
    // target value of cage i (instance field problem, column 1)
    problem_1: I -> Int
    // cells of cage i: the j-th cell is (problem_2(i,j,0), problem_2(i,j,1)), padded with 0
    problem_2: I * J * K -> Int
    // number of cells in cage i
    problem_2_len: I -> Int
    // declared output: the solved grid
    x: Row * Row -> Row
    // value of the j-th cell of cage i
    cv: I * J -> Row
    // sum of the cell values of cage i
    sumv: I -> Int
    // running product of the cell values of cage i up to position j
    pr: I * J -> Int
    // product of the cell values of cage i
    cprod: I -> Int
    // value of the first and second cell of cage i
    cell1: I -> Int
    cell2: I -> Int
}
theory {
    // the value of a cell of a cage is the digit in that grid cell
    ! i in I: ! j in J: j < problem_2_len(i) => (! r in Row: ! c in Row: (problem_2(i,j,0) = r & problem_2(i,j,1) = c) => cv(i,j) = x(r,c)).

    // each row contains exactly one of each digit
    ! r in Row: ! a in Row: ! b in Row: a ~= b => x(r,a) ~= x(r,b).

    // each column contains exactly one of each digit
    ! c in Row: ! r1 in Row: ! r2 in Row: r1 ~= r2 => x(r1,c) ~= x(r2,c).

    // the cells of a cage added together
    ! i in I: sumv(i) = sum{{ cv(i,j) | j in J: j < problem_2_len(i) }}.

    // the cells of a cage multiplied together, built up one cell at a time
    ! i in I: ! j in J: (j = 0 & 0 < problem_2_len(i)) => pr(i,j) = cv(i,j).
    ! i in I: ! j in J: ! j2 in J: (j2 + 1 = j & j < problem_2_len(i)) => pr(i,j) = pr(i,j2) * cv(i,j).
    ! i in I: ! j in J: (j + 1 = problem_2_len(i)) => cprod(i) = pr(i,j).

    // the first and second cell of a cage, used by the two-cell operations
    ! i in I: ! j in J: j = 0 => cell1(i) = cv(i,j).
    ! i in I: ! j in J: j = 1 => cell2(i) = cv(i,j).

    // each cage reaches its target by addition, multiplication, subtraction or division of its cells
    ! i in I: sumv(i) = problem_1(i) | cprod(i) = problem_1(i) | (problem_2_len(i) = 2 & (cell1(i) - cell2(i) = problem_1(i) | cell2(i) - cell1(i) = problem_1(i) | cell1(i) = problem_1(i) * cell2(i) | cell2(i) = problem_1(i) * cell1(i))).
}
