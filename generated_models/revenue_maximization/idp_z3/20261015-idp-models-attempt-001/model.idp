// Revenue maximization: choose how many seats to sell of each travel package so that the seats used on each flight leg stay within its available seats, maximizing total revenue.
vocabulary {
    // Travel packages, sized from the demand list.
    type Pkg <: Int
    // Flight legs, sized from the available seats list.
    type Leg <: Int

    // Revenue earned per sold package.
    revenue: Pkg -> Int
    // Maximum number of packages customers want.
    demand: Pkg -> Int
    // Seats available on each leg.
    available_seats: Leg -> Int
    // delta(p, l) = 1 when package p uses leg l.
    delta: Pkg * Leg -> Int

    // packages_to_sell(p): number of package p to sell.
    packages_to_sell: Pkg -> Int
    // earned(p): revenue collected from package p.
    earned: Pkg -> Int
    // max_revenue: total revenue of the packages sold.
    max_revenue: () -> Int

    maximize: () -> Int
}
theory {
    // A package is sold at most as often as customers demand it, and not a negative number of times.
    ! p in Pkg: packages_to_sell(p) >= 0 & packages_to_sell(p) =< demand(p).

    // Each leg has no more seats sold than available.
    ! l in Leg: sum{{ packages_to_sell(p) | p in Pkg: delta(p, l) = 1 }} =< available_seats(l).

    // The total revenue is the revenue of each package times the number sold.
    ! p in Pkg: earned(p) = revenue(p) * packages_to_sell(p).

    max_revenue() = sum{{ earned(p) | p in Pkg }}.

    // The objective is the total revenue.
    maximize() = max_revenue().
}
