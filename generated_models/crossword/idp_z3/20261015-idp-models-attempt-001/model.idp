// Complete the crossword: choose one word for each numbered slot (1..8) so that crossing cells agree.
vocabulary V {
    type Slot := {1..8}
    type Word := {0..14}
    type Pos := {1..5}
    type Letter := {0..26}
    // E(s): the word chosen for the slot numbered s (declared output)
    E: Slot -> Word
    // ch(w, p): letter code at position p of word w (A=1 .. Z=26, 0 = no letter)
    ch: Word * Pos -> Letter
    // wl(w): length of word w
    wl: Word -> Int
    // sl(s): length of the slot numbered s
    sl: Slot -> Int
}
theory T : V {
    // the word list: lengths of the 15 words, sorted by length descending then alphabetically
    wl(0) = 5. wl(1) = 5. wl(2) = 5. wl(3) = 5. wl(4) = 5.
    wl(5) = 4. wl(6) = 4. wl(7) = 4. wl(8) = 4. wl(9) = 4.
    wl(10) = 3. wl(11) = 3. wl(12) = 3. wl(13) = 3. wl(14) = 3.

    // the letters of each word (HOSES, LASER, SAILS, SHEET, STEER)
    ch(0,1) = 8. ch(0,2) = 15. ch(0,3) = 19. ch(0,4) = 5. ch(0,5) = 19.
    ch(1,1) = 12. ch(1,2) = 1. ch(1,3) = 19. ch(1,4) = 5. ch(1,5) = 18.
    ch(2,1) = 19. ch(2,2) = 1. ch(2,3) = 9. ch(2,4) = 12. ch(2,5) = 19.
    ch(3,1) = 19. ch(3,2) = 8. ch(3,3) = 5. ch(3,4) = 5. ch(3,5) = 20.
    ch(4,1) = 19. ch(4,2) = 20. ch(4,3) = 5. ch(4,4) = 5. ch(4,5) = 18.
    // the letters of each 4-letter word (HEEL, HIKE, KEEL, KNOT, LINE)
    ch(5,1) = 8. ch(5,2) = 5. ch(5,3) = 5. ch(5,4) = 12. ch(5,5) = 0.
    ch(6,1) = 8. ch(6,2) = 9. ch(6,3) = 11. ch(6,4) = 5. ch(6,5) = 0.
    ch(7,1) = 11. ch(7,2) = 5. ch(7,3) = 5. ch(7,4) = 12. ch(7,5) = 0.
    ch(8,1) = 11. ch(8,2) = 14. ch(8,3) = 15. ch(8,4) = 20. ch(8,5) = 0.
    ch(9,1) = 12. ch(9,2) = 9. ch(9,3) = 14. ch(9,4) = 5. ch(9,5) = 0.
    // the letters of each 3-letter word (AFT, ALE, EEL, LEE, TIE)
    ch(10,1) = 1. ch(10,2) = 6. ch(10,3) = 20. ch(10,4) = 0. ch(10,5) = 0.
    ch(11,1) = 1. ch(11,2) = 12. ch(11,3) = 5. ch(11,4) = 0. ch(11,5) = 0.
    ch(12,1) = 5. ch(12,2) = 5. ch(12,3) = 12. ch(12,4) = 0. ch(12,5) = 0.
    ch(13,1) = 12. ch(13,2) = 5. ch(13,3) = 5. ch(13,4) = 0. ch(13,5) = 0.
    ch(14,1) = 20. ch(14,2) = 9. ch(14,3) = 5. ch(14,4) = 0. ch(14,5) = 0.

    // the slot lengths: slots 1, 2, 3 are five letters; 4, 5 are four letters; 6, 7 are three letters; 8 is five letters
    sl(1) = 5. sl(2) = 5. sl(3) = 5. sl(4) = 4. sl(5) = 4. sl(6) = 3. sl(7) = 3. sl(8) = 5.

    // each slot takes a word of its own length
    ! s in Slot: wl(E(s)) = sl(s).

    // the 8 selected words are different words
    ! s, t in Slot: s ~= t => E(s) ~= E(t).

    // the letters at the crossing cells agree
    ch(E(1), 3) = ch(E(2), 1).
    ch(E(1), 5) = ch(E(3), 1).
    ch(E(2), 3) = ch(E(4), 2).
    ch(E(3), 3) = ch(E(4), 4).
    ch(E(4), 3) = ch(E(5), 1).
    ch(E(2), 4) = ch(E(7), 1).
    ch(E(5), 2) = ch(E(7), 2).
    ch(E(3), 4) = ch(E(7), 3).
    ch(E(6), 2) = ch(E(8), 1).
    ch(E(2), 5) = ch(E(8), 3).
    ch(E(5), 3) = ch(E(8), 4).
    ch(E(3), 5) = ch(E(8), 5).
}
