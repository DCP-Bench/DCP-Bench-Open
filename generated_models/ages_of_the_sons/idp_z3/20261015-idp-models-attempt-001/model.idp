// Ages of the three sons: a puzzle of successive statements about product, sum and eyes.
vocabulary {
    type Age := {1..36}
    // the ages of the three sons, oldest first
    A1: () -> Age
    A2: () -> Age
    A3: () -> Age
}
theory {
    // The product of their ages is 36.
    A1() * A2() * A3() = 36.
    // The ages are listed oldest first.
    A1() >= A2() & A2() >= A3().
    // The mathematician needs more information: another age triple has product 36.
    ? a, b, c in Age: a >= b & b >= c & a * b * c = 36 & ~(a = A1() & b = A2() & c = A3()).
    // The sum of their ages equals the number of windows, and the mathematician still needs more information:
    // another triple with product 36 has the same sum.
    ? a, b, c in Age: a >= b & b >= c & a * b * c = 36 & a + b + c = A1() + A2() + A3() & ~(a = A1() & b = A2() & c = A3()).
    // The oldest son has blue eyes, so he is strictly older than the second son, and the mathematician now knows the ages.
    A1() > A2().
    // Among the triples with product 36 and the same sum, the one whose oldest son is unique is the only one.
    ! a, b, c in Age: (a >= b & b >= c & a * b * c = 36 & a + b + c = A1() + A2() + A3() & a > b) => (a = A1() & b = A2() & c = A3()).
}
