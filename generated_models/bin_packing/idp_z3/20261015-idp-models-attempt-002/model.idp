// Bin packing: assign each item to one of num_bins bins so that the total weight in each bin does not exceed the capacity.
vocabulary {
    // one index per item, sized from the weights array
    type Item <: Int
    // bins are numbered 0..num_bins-1; the range reaches num_bins, and the theory excludes that value
    type Bin := {0..${num_bins}}

    weights: Item -> Int
    capacity: () -> Int
    num_bins: () -> Int

    // declared output: the bin each item is assigned to, 0-indexed
    bins: Item -> Bin
}
theory {
    // assign each item to one of the bins numbered 0 to num_bins - 1
    ! i in Item: bins(i) < num_bins().

    // the total weight of the items in each bin does not exceed the capacity
    ! b in Bin: b < num_bins() => sum{{ weights(i) | i in Item: bins(i) = b }} =< capacity().
}
