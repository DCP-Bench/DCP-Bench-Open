vocabulary {
    type Range_max_val <: Int
    max_val: () -> Int
    min_a: () -> Int
    a: () -> Int
    b: () -> Int
    n: () -> Int
    p: () -> Int
    t: () -> Int
    minimize: () -> Int
}
theory {
    // a and b are positive integers (b larger than 0); values stay within max_val
    1 =< t() & t() =< max_val().
    // a - b is a prime number and a * b is a perfect square n^2 forces b = t^2, a = (t+1)^2
    b() = t() * t().
    a() = b() + p().
    p() = 2 * t() + 1.
    n() = t() * (t() + 1).
    a() =< max_val().
    // a - b is a prime number
    p() >= 2.
    ! d in Range_max_val: d >= 2 & d < p() => p() % d ~= 0.
    // a is no less than the given minimum
    a() >= min_a().
    // find the smallest value of a
    minimize() = a().
}
