language ESSENCE' 1.0
$ Flow Free: colour every cell of an n by n board so that each colour forms one pipe joining its two clue cells, the pipes do not overlap, and the board is covered.
given board_dim1, board_dim2 : int(1..)
$ the board is square, so its side is the number of rows
letting n = board_dim1
$ the clue colours: 0 is an empty cell
given board : matrix indexed by [int(1..board_dim1), int(1..board_dim2)] of int(0..board_dim1*board_dim2)
$ every colour has a clue cell, so the largest clue is the number of colours
letting K = max(flatten(board))
$ the board colouring, one colour per cell
find B : matrix indexed by [int(1..n), int(1..n)] of int(1..K)
$ the board with a border of colour 0 added, so that every neighbour index is valid
find G : matrix indexed by [int(0..n+1), int(0..n+1)] of int(0..K)
$ distance from the clue cell at the start of the pipe, along the pipe
find D : matrix indexed by [int(0..n+1), int(0..n+1)] of int(0..n*n)
branching on [B]
such that
$ the border of G is colour 0, and the interior of G is the board B
forAll k : int(0..n+1) . (G[0,k] = 0 /\ G[n+1,k] = 0 /\ G[k,0] = 0 /\ G[k,n+1] = 0),
forAll r : int(1..n) . forAll c : int(1..n) . G[r,c] = B[r,c],
$ a clue cell keeps its clue colour
forAll r : int(1..n) . forAll c : int(1..n) . (board[r,c] != 0 -> B[r,c] = board[r,c]),
$ each clue cell is an end of its pipe, so it touches exactly one cell of its colour
forAll r : int(1..n) . forAll c : int(1..n) . (board[r,c] != 0 -> ((toInt(G[r-1,c] = G[r,c]) + toInt(G[r+1,c] = G[r,c]) + toInt(G[r,c-1] = G[r,c]) + toInt(G[r,c+1] = G[r,c])) = 1)),
$ every other cell is inside a pipe, so it touches exactly two cells of its colour
forAll r : int(1..n) . forAll c : int(1..n) . (board[r,c] = 0 -> ((toInt(G[r-1,c] = G[r,c]) + toInt(G[r+1,c] = G[r,c]) + toInt(G[r,c-1] = G[r,c]) + toInt(G[r,c+1] = G[r,c])) = 2)),
$ the clue cells are at distance 0 from their pipe start
forAll r : int(1..n) . forAll c : int(1..n) . (board[r,c] != 0 -> D[r,c] = 0),
$ every other cell of a pipe is one step further along than a neighbour of the same colour, so no pipe can be a loop away from its clue cells
forAll r : int(1..n) . forAll c : int(1..n) . (board[r,c] = 0 -> (((G[r-1,c] = G[r,c]) /\ (D[r-1,c] = D[r,c] - 1)) \/ ((G[r+1,c] = G[r,c]) /\ (D[r+1,c] = D[r,c] - 1)) \/ ((G[r,c-1] = G[r,c]) /\ (D[r,c-1] = D[r,c] - 1)) \/ ((G[r,c+1] = G[r,c]) /\ (D[r,c+1] = D[r,c] - 1))))
