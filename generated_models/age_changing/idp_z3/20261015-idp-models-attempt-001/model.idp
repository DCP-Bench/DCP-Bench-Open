// Age changing: my age, after the four operations +2, /8, -3, *7 in some order, gives my husband's age; his age, after the same four operations in a different order, gives mine. Find both ages.
vocabulary {
    type Op := {1..4}          // 1 is +2, 2 is /8, 3 is -3, 4 is *7
    type Step := {1..4}        // the four steps of a sequence of operations
    type Pos := {0..4}         // a position along a sequence: 0 is the start, 4 is the end
    type Age := {0..1000}      // ages and intermediate values, never negative
    first: Step -> Op          // the order of the operations applied to my age
    second: Step -> Op         // the order of the operations applied to his age
    from_me: Pos -> Age        // the value after each step, starting from my age
    from_him: Pos -> Age       // the value after each step, starting from his age
    m: () -> Int               // my age
    h: () -> Int               // my husband's age
}
theory {
    // each order uses every one of the four operations exactly once
    ! s, t in Step: s ~= t => first(s) ~= first(t).
    ! s, t in Step: s ~= t => second(s) ~= second(t).
    // the second order is a different order from the first
    ? s in Step: first(s) ~= second(s).

    // starting from my age and applying the operations in the first order gives my husband's age
    from_me(0) = m().
    from_me(4) = h().
    // each step applies its operation: +2, /8 (exact division), -3, *7
    ! s in Step: first(s) = 1 => from_me(s) = from_me(s-1) + 2.
    ! s in Step: first(s) = 2 => from_me(s-1) = 8 * from_me(s).
    ! s in Step: first(s) = 3 => from_me(s) = from_me(s-1) - 3.
    ! s in Step: first(s) = 4 => from_me(s) = 7 * from_me(s-1).

    // starting from my husband's age and applying the operations in the second order gives my age
    from_him(0) = h().
    from_him(4) = m().
    // each step applies its operation: +2, /8 (exact division), -3, *7
    ! s in Step: second(s) = 1 => from_him(s) = from_him(s-1) + 2.
    ! s in Step: second(s) = 2 => from_him(s-1) = 8 * from_him(s).
    ! s in Step: second(s) = 3 => from_him(s) = from_him(s-1) - 3.
    ! s in Step: second(s) = 4 => from_him(s) = 7 * from_him(s-1).
}
