// Four numbers: find three integers between 1 and 10 such that every given number is a sum of a subset of them.
vocabulary {
    // one index per given number; the size comes from the instance
    type I <: Int
    // the three integers to find, each between 1 and 10
    type V := {1..10}
    // positions of the three integers
    type J := {0..2}
    // subset masks 1..7 (non-empty subsets of three positions)
    type M := {1..7}

    numbers: I -> Int
    x: J -> V
    subsum: M -> Int
    inSub: M * J -> Bool
}

theory {
    // subset membership: mask m selects the positions whose bit is set (1 = {0}, 2 = {1}, 3 = {0,1}, ...)
    {
        inSub(1, 0).
        inSub(2, 1).
        inSub(3, 0). inSub(3, 1).
        inSub(4, 2).
        inSub(5, 0). inSub(5, 2).
        inSub(6, 1). inSub(6, 2).
        inSub(7, 0). inSub(7, 1). inSub(7, 2).
    }

    // the sum of each non-empty subset of the three integers
    ! m in M: subsum(m) = sum{{ x(j) | j in J: inSub(m, j) }}.

    // all the original numbers can be generated by summing subsets of the three integers
    ! i in I: ? m in M: subsum(m) = numbers(i).
}
